<script server>
/**
 * The builder, arranging a real report.
 *
 * Backed by a writable in-memory store, so this is the working surface rather
 * than a picture of one: the palette adds, the corner resizes, the grid packs
 * on the server. What it does not do is persist past a reload, which is the
 * only thing a screenshot does not need.
 */
import { Database } from 'bun:sqlite'
import { Compiler, createHandlers, elementHtml, Registry, Runner, type ReportStore, type StoredBlock } from '@reportshq/stacks'

const sqlite = new Database(':memory:')
sqlite.run(`CREATE TABLE orders (id INTEGER PRIMARY KEY, total INTEGER, status TEXT, created_at TEXT)`)
let day = 3
for (const total of [4200, 5100, 3900, 6800, 7400, 5900, 8200, 7100, 9400, 8800, 10200, 9100]) {
  const date = `2026-08-${String(day).padStart(2, '0')}T10:00:00Z`
  sqlite.run(`INSERT INTO orders (total, status, created_at) VALUES (?, ?, ?)`, [total, 'paid', date])
  sqlite.run(`INSERT INTO orders (total, status, created_at) VALUES (?, ?, ?)`, [Math.round(total * 0.55), 'paid', date])
  day++
}
sqlite.run(`INSERT INTO orders (total, status, created_at) VALUES (?, ?, ?)`, [3400, 'refunded', '2026-08-08T10:00:00Z'])

const registry = new Registry({
  order: {
    table: 'orders',
    measures: { revenue: { aggregate: 'sum', column: 'total' }, orders: { aggregate: 'count' } },
    time: { placed: 'created_at' },
    dimensions: { status: 'status' },
  },
})

const db = { unsafe: async (q: string, v: unknown[] = []) => sqlite.query(q).all(...(v as any[])) as any[] }
const runner = new Runner(new Compiler(registry, db, 'sqlite'))

const blocks: StoredBlock[] = [
  { id: 1, kind: 'big_number', title: 'Revenue', x: 0, y: 0, w: 3, h: 2, query: { model: 'order', measure: 'revenue' } },
  { id: 2, kind: 'big_number', title: 'Orders', x: 3, y: 0, w: 3, h: 2, query: { model: 'order', measure: 'orders' } },
  { id: 3, kind: 'line', title: 'Revenue per day', x: 6, y: 0, w: 6, h: 6, query: { model: 'order', measure: 'revenue', time: { key: 'placed' }, grain: 'day' } },
  { id: 4, kind: 'donut', title: 'By status', x: 0, y: 2, w: 3, h: 4, query: { model: 'order', measure: 'revenue', dimension: { key: 'status' } } },
  { id: 5, kind: 'table', title: 'Revenue by status', x: 3, y: 2, w: 3, h: 4, query: { model: 'order', measure: 'revenue', dimension: { key: 'status' } } },
]

let nextId = 6

const store: ReportStore = {
  list: async () => [{ id: 1, name: 'Commerce', slug: 'commerce' }],
  find: async () => ({ id: 1, name: 'Commerce', slug: 'commerce', description: 'Revenue and orders, from the Order model.' }),
  blocks: async () => blocks,
  saveLayout: async (_id, incoming) => {
    for (const patch of incoming) {
      const block = blocks.find(b => b.id === patch.id)
      if (block) Object.assign(block, patch)
    }
  },
  addBlock: async (_id, kind) => {
    const block: StoredBlock = { id: nextId++, kind: kind as any, title: kind.replace('_', ' '), x: 0, y: 99, w: 4, h: 4 }
    blocks.push(block)
    return block
  },
  saveBlock: async (_id, blockId, patch) => {
    const block = blocks.find(b => b.id === blockId)
    if (block) Object.assign(block, patch)
  },
  removeBlock: async (_id, blockId) => {
    const at = blocks.findIndex(b => b.id === blockId)
    if (at >= 0) blocks.splice(at, 1)
  },
  publish: async () => {},
}

const handlers = createHandlers(store, runner, registry)
const { report, blocks: rendered } = await handlers.show('commerce', false)
const tiles = rendered.map((block: any) => ({ ...block, html: elementHtml(block) }))
const choicesJson = JSON.stringify(handlers.schema())
</script>

<template>
  <div class="p-8 min-h-[100dvh] bg-canvas">
    <link rel="stylesheet" href="/reportshq/charts.css">
    <script type="module" src="/reportshq/charts.js"></script>
    <script src="/reportshq/builder.js" defer></script>

    <div class="mx-auto max-w-5xl">
      <div class="rhq-builder" data-endpoint="/api/reports/commerce" data-choices="{{ choicesJson }}">
        

        <header class="rhq-builder-head">
          <div>
            <h1 class="rhq-builder-title">{{ report.name }}</h1>
            <p class="rhq-builder-sub">Drag to move, drag a corner to resize, arrow keys to nudge.</p>
          </div>
          <div class="rhq-builder-actions">
            <span id="rhq-drafted" class="rhq-pill">draft</span>
            <button type="button" class="rhq-publish">Publish</button>
          </div>
        </header>

        <div class="rhq-palette" role="group" aria-label="Add a block">
          <button type="button" class="rhq-add" data-kind="big_number"><i class="i-hugeicons-chart-average"></i><span>Big number</span></button>
          <button type="button" class="rhq-add" data-kind="line"><i class="i-hugeicons-chart-line-data-02"></i><span>Line</span></button>
          <button type="button" class="rhq-add" data-kind="bar"><i class="i-hugeicons-chart-bar-line"></i><span>Bar</span></button>
          <button type="button" class="rhq-add" data-kind="donut"><i class="i-hugeicons-pie-chart"></i><span>Donut</span></button>
          <button type="button" class="rhq-add" data-kind="table"><i class="i-hugeicons-table"></i><span>Table</span></button>
          <button type="button" class="rhq-add" data-kind="note"><i class="i-hugeicons-note"></i><span>Note</span></button>
        </div>

        <div class="rhq-grid rhq-grid-edit" id="rhq-grid">
          @foreach (tiles as tile)
            {{-- The script reads its geometry from these, not from the CSS
                 variables: a custom property is for layout and cannot be read
                 back reliably mid-drag. Omitting them leaves every origin NaN
                 and the tile simply does not move, with nothing logged. --}}
            <div class="rhq-cell rhq-tile" data-id="{{ tile.id }}" data-kind="{{ tile.kind }}"
                 data-x="{{ tile.x }}" data-y="{{ tile.y }}" data-w="{{ tile.w }}" data-h="{{ tile.h }}"
                 tabindex="0" role="group" aria-label="{{ tile.title }}"
                 style="--x: {{ tile.x + 1 }}; --w: {{ tile.w }}; --h: {{ tile.h }}">
              {!! tile.html !!}
              <button type="button" class="rhq-resize" aria-label="Resize {{ tile.title }}"></button>
              <button type="button" class="rhq-remove" aria-label="Remove {{ tile.title }}"><i class="i-hugeicons-delete-02"></i></button>
            </div>
          @endforeach
        </div>
      </div>
    </div>
  </div>
</template>
