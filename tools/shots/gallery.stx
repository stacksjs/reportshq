<script server>
/**
 * Every block kind, rendered.
 *
 * A screenshot harness and a QA pass in one. Five of the nine kinds had ever
 * been seen on a page; the rest were covered by unit tests that assert numbers
 * and never look at what gets drawn.
 */
import { Database } from 'bun:sqlite'
import { Compiler, elementHtml, Registry, Runner } from '@reportshq/stacks'

const sqlite = new Database(':memory:')
sqlite.run(`CREATE TABLE orders (id INTEGER PRIMARY KEY, total INTEGER, status TEXT, channel TEXT, created_at TEXT)`)

const days = [4200, 5100, 3900, 6800, 7400, 5900, 8200, 7100, 9400, 8800, 10200, 9100]
let day = 3
for (const total of days) {
  const date = `2026-08-${String(day).padStart(2, '0')}T10:00:00Z`
  sqlite.run(`INSERT INTO orders (total, status, channel, created_at) VALUES (?, ?, ?, ?)`, [total, 'paid', 'web', date])
  sqlite.run(`INSERT INTO orders (total, status, channel, created_at) VALUES (?, ?, ?, ?)`, [Math.round(total * 0.55), 'paid', 'app', date])
  sqlite.run(`INSERT INTO orders (total, status, channel, created_at) VALUES (?, ?, ?, ?)`, [Math.round(total * 0.2), 'paid', 'phone', date])
  day++
}
sqlite.run(`INSERT INTO orders (total, status, channel, created_at) VALUES (?, ?, ?, ?)`, [4100, 'refunded', 'web', '2026-08-09T10:00:00Z'])

const registry = new Registry({
  order: {
    table: 'orders',
    measures: { revenue: { aggregate: 'sum', column: 'total' }, orders: { aggregate: 'count' } },
    time: { placed: 'created_at' },
    dimensions: { status: 'status', channel: 'channel' },
  },
})

const db = { unsafe: async (q: string, v: unknown[] = []) => sqlite.query(q).all(...(v as any[])) as any[] }
const runner = new Runner(new Compiler(registry, db, 'sqlite'))

const perDay = { model: 'order', measure: 'revenue', time: { key: 'placed' }, grain: 'day' as const }
const byChannel = { model: 'order', measure: 'revenue', dimension: { key: 'channel' } }

// One of each, including the two nobody has looked at, and a refusal.
const blocks = await runner.report([
  { id: 1, kind: 'big_number', title: 'Big number', w: 3, h: 3, query: { model: 'order', measure: 'revenue' } },
  { id: 2, kind: 'line', title: 'Line', w: 4, h: 4, query: perDay },
  { id: 3, kind: 'area', title: 'Area', w: 5, h: 4, query: perDay },
  { id: 4, kind: 'bar', title: 'Bar', w: 6, h: 4, query: perDay },
  { id: 5, kind: 'donut', title: 'Donut', w: 3, h: 5, query: byChannel },
  { id: 6, kind: 'table', title: 'Table', w: 3, h: 5, query: byChannel },
  { id: 7, kind: 'funnel', title: 'Funnel', w: 4, h: 5, query: byChannel },
  { id: 8, kind: 'heatmap', title: 'Heatmap', w: 6, h: 4, query: perDay },
  { id: 9, kind: 'note', title: 'Note', w: 3, h: 3, body: 'A note carries prose rather than a number.' },
  { id: 10, kind: 'table', title: 'A refusal', w: 3, h: 3, query: { model: 'order', measure: 'revenue', dimension: { key: 'password' } } },
], 'UTC')

const tiles = blocks.map((block: any) => ({ ...block, html: elementHtml(block) }))

// What the QA pass is actually for: which kinds drew nothing.
const drew = tiles.map((t: any) => `${t.kind}:${t.error ? 'refused' : (t.series?.length ? 'ok' : 'EMPTY')}`).join(' ')
</script>

<template>
  <div class="p-8 min-h-[100dvh] bg-canvas">
    <link rel="stylesheet" href="/reportshq/charts.css">
    <script type="module" src="/reportshq/charts.js"></script>

    <div class="mx-auto max-w-6xl">
      <h1 class="text-2xl font-semibold tracking-tight text-ink">Every block kind</h1>
      <p class="mt-1 text-sm text-muted" id="qa">{{ drew }}</p>

      <div class="grid grid-cols-2 gap-4 mt-6 md:grid-cols-3">
        @foreach (tiles as tile)
          <div class="p-4 rounded-xl border border-line bg-panel" style="min-height: 13rem">
            @if (tile.error)
              <p class="text-sm font-medium text-ink">{{ tile.title }}</p>
              <p class="mt-1 text-xs leading-relaxed text-muted">{{ tile.error }}</p>
            @else
              {!! tile.html !!}
            @endif
          </div>
        @endforeach
      </div>
    </div>
  </div>
</template>
