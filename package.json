    "bun-query-builder": "^0.3.5",
    "pickier": "^0.1.68",
    "stacks": "^0.75.81",
    "ts-pantry": "^0.11.71",
    "ts-rate-limiter": "^0.4.10",
    "ts-spreadsheets": "^0.2.5",
    "@reportshq/stacks": "workspace:*"
  },
  "workspaces": [
    "storage/framework",
    "storage/framework/libs/*",
    "storage/framework/views/*",
    "packages/*"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,stx,json,yaml,yml,md}": "bun x --bun pickier lint --fix"
      }
    },
    "commit-msg": "bun x gitlint --edit \"$1\""
