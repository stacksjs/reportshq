  },
  "scripts": {
    "build:reset": "rm -rf node_modules && pantry install && ./buddy generate:types && ./buddy lint:fix && cd storage/framework && bun run build && cd ../../",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "setup": "./bootstrap",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "dev": "./buddy dev",
    "development": "./buddy dev",
    "build": "./buddy build",
    "docs:validate": "bun scripts/validate-docs.ts",
    "ui:validate": "bun scripts/validate-ui.ts",
    "visual:validate": "bun scripts/validate-visual.ts",
    "release:validate": "bun scripts/validate-release.ts",
    "deployment:smoke": "bun scripts/smoke-deployment.ts",
    "prod": "./buddy build",
    "deploy": "./buddy deploy",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "format": "./buddy format",
    "format:check": "./buddy format:check",
    "serve": "./buddy serve",
    "make": "./buddy make",
    "make:component": "./buddy make:component",
    "make:function": "./buddy make:function",
    "make:database": "./buddy make:migration",
    "make:migration": "./buddy make:migration",
    "make:notification": "./buddy make:notification",
    "make:factory": "./buddy make:factory",
    "make:lang": "./buddy make:lang",
    "make:stack": "./buddy make:stack",
    "key:generate": "./buddy key:generate",
    "commit": "./buddy commit",
    "release": "./buddy release",
    "release:patch": "./buddy release --bump patch",
    "release:minor": "./buddy release --bump minor",
    "release:major": "./buddy release --bump major",
    "changelog": "./buddy changelog",
    "generate": "./buddy generate",
    "typecheck": "bun run typecheck:app && bun run typecheck:framework",
    "typecheck:framework": "bun x --bun tsc --noEmit -p storage/framework/tsconfig.framework.json --pretty false",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "typecheck:clean": "bunx --bun rimraf storage/framework/.cache/typescript",
    "types:check": "bun run typecheck",
    "types:fix": "./buddy types:fix",
    "test": "./buddy test",
    "test:ui": "./buddy test:ui",
    "test:coverage": "./buddy test:coverage",
    "test:types": "./buddy test:types",
    "docs:buddy": "./buddy docs:buddy",
    "docs:buddy:check": "./buddy docs:buddy:check",
    "docs:artifacts": "./buddy docs:artifacts",
    "docs:artifacts:check": "./buddy docs:artifacts:check",
    "docs:links": "./buddy docs:links",
    "docs:links:check": "./buddy docs:links:check",
    "bud": "./buddy",
    "stx": "./buddy",
    "build:charts": "buddy build --web-components && mkdir -p public/reportshq packages/laravel/resources/dist packages/laravel/resources/js packages/stacks/resources/dist && cat storage/framework/libs/packages/elements/dist/bundle.css resources/components/charts/charts.css > public/reportshq/charts.css.tmp && cat public/reportshq/charts.css.tmp resources/components/charts/grid.css > public/reportshq/charts.css && rm public/reportshq/charts.css.tmp && cp storage/framework/libs/packages/elements/dist/bundle.js public/reportshq/charts.js && cp storage/framework/libs/packages/elements/dist/bundle.js public/reportshq-charts.js && cp public/reportshq/charts.css public/reportshq-charts.css && cp storage/framework/libs/packages/elements/dist/bundle.js packages/laravel/resources/dist/reportshq.js && cp public/reportshq/charts.css packages/laravel/resources/dist/reportshq-components.css && cp resources/js/reportshq-builder.js packages/laravel/resources/js/builder.js && cp resources/js/reportshq-builder.js packages/stacks/resources/dist/builder.js && cp resources/js/reportshq-builder.js public/reportshq/builder.js",
    "shots": "bun tools/shots/capture.ts",
    "build:packages": "bun run --filter '@reportshq/stacks' build",
    "build:artifacts": "bun run build:packages && bun run build:charts",
    "serve:validate": "bun scripts/validate-serve.ts"
  },
  "dependencies": {
    "@loghq/stacks": "^0.2.6",
    "@stacksjs/buddy": "^0.75.81",
    "@stacksjs/dtsx": "^0.11.19",
    "@stacksjs/stx": "^0.2.382",
    "@ts-charts/array": "^0.2.7",
    "@ts-charts/format": "^0.2.7",
    "@ts-charts/scale": "^0.2.7",
