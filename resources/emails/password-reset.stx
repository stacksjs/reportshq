<script server>
const appName = props.appName || 'ReportsHQ'
const resetUrl = props.resetUrl || '#'
const expiresInMinutes = props.expiresInMinutes || 60
const year = props.year || new Date().getFullYear()
</script>

{{-- The reset email.

     Light rather than dark, unlike the framework's sample: a dark email is a
     coin flip against a client that inverts it, and the one message somebody
     must be able to read is the one letting them back into their account.

     Tables and inline styles throughout, because email clients are a decade
     behind and a stylesheet is the first thing stripped. --}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Reset your {{ appName }} password</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f7f7f8; line-height: 1.6; color: #1a1a1c;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; background-color: #f7f7f8;">
    <tr>
      <td style="padding: 40px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto;">

          <tr>
            <td style="padding-bottom: 24px;">
              <span style="color: #1a1a1c; font-size: 18px; font-weight: 600;">{{ appName }}</span>
            </td>
          </tr>

          <tr>
            <td style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 32px;">

              <h1 style="color: #1a1a1c; font-size: 20px; font-weight: 600; margin: 0 0 12px;">Reset your password</h1>

              <p style="color: #52525b; font-size: 15px; line-height: 1.6; margin: 0 0 24px;">
                Someone asked for a password reset on your account. If that was you, use the button below. The link
                works once, and expires in {{ expiresInMinutes }} minutes.
              </p>

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
                <tr>
                  <td style="background-color: #3b45d4; border-radius: 8px;">
                    <a href="{{ resetUrl }}" style="display: inline-block; padding: 12px 22px; color: #ffffff; font-size: 15px; font-weight: 500; text-decoration: none;">Choose a new password</a>
                  </td>
                </tr>
              </table>

              {{-- The raw link as well as the button. Plenty of clients refuse
                   to render a styled anchor, and a person staring at an email
                   with no visible way forward has no idea why. --}}
              <p style="color: #71717a; font-size: 13px; line-height: 1.6; margin: 0 0 24px; word-break: break-all;">
                Or paste this into your browser:<br>
                <a href="{{ resetUrl }}" style="color: #3b45d4;">{{ resetUrl }}</a>
              </p>

              <p style="color: #71717a; font-size: 13px; line-height: 1.6; margin: 0; padding-top: 20px; border-top: 1px solid #e4e4e7;">
                If you did not ask for this, you can ignore it. Your password stays as it is, and nobody can use this
                link without your inbox.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding-top: 20px; text-align: center;">
              <p style="color: #a1a1aa; font-size: 12px; margin: 0;">{{ year }} {{ appName }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
