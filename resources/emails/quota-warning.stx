<script server>
const appName = props.appName || 'ReportsHQ'
const projectName = props.projectName || 'your project'
const used = props.used || '0'
const allowance = props.allowance || '0'
const percent = props.percent || 0
const planName = props.planName || 'Free'
const upgradeName = props.upgradeName || ''
const upgradeEvents = props.upgradeEvents || ''
const projectUrl = props.projectUrl || '#'
const atLimit = Boolean(props.atLimit)
const year = props.year || new Date().getFullYear()
</script>

{{-- Two messages in one template: approaching the quota, and past it.

     One file rather than two because they differ by a sentence and a heading,
     and two files drift. The difference that matters is what the person should
     do, so that is what changes. --}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ projectName }} events this month</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f7f7f8; line-height: 1.6; color: #1a1a1c;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; background-color: #f7f7f8;">
    <tr>
      <td style="padding: 40px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto;">

          <tr>
            <td style="padding-bottom: 24px;">
              <span style="color: #1a1a1c; font-size: 18px; font-weight: 600;">{{ appName }}</span>
            </td>
          </tr>

          <tr>
            <td style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 32px;">

              @if (atLimit)
                <h1 style="color: #1a1a1c; font-size: 20px; font-weight: 600; margin: 0 0 12px;">{{ projectName }} has used its events for the month</h1>
                <p style="color: #52525b; font-size: 15px; line-height: 1.6; margin: 0 0 20px;">
                  Collection has not stopped. You are inside the grace allowance, which is 10% past the quota, and
                  events keep arriving until that runs out.
                </p>
              @else
                <h1 style="color: #1a1a1c; font-size: 20px; font-weight: 600; margin: 0 0 12px;">{{ projectName }} is approaching its event quota</h1>
                <p style="color: #52525b; font-size: 15px; line-height: 1.6; margin: 0 0 20px;">
                  Nothing has changed yet. This is early notice, while there is still time to do something about it.
                </p>
              @endif

              {{-- The numbers, once, in a box. The point of this email is a
                   fact the person cannot see from their inbox. --}}
              <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; background-color: #f7f7f8; border-radius: 8px; margin: 0 0 24px;">
                <tr>
                  <td style="padding: 16px 18px;">
                    <p style="color: #1a1a1c; font-size: 18px; font-weight: 600; margin: 0 0 4px;">{{ used }} of {{ allowance }} events</p>
                    <p style="color: #71717a; font-size: 13px; margin: 0;">{{ percent }}% of the {{ planName }} allowance, this calendar month</p>
                  </td>
                </tr>
              </table>

              @if (upgradeName)
                <p style="color: #52525b; font-size: 15px; line-height: 1.6; margin: 0 0 24px;">
                  {{ upgradeName }} carries {{ upgradeEvents }} events a month, and takes effect on the next event you send.
                </p>
              @endif

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 24px;">
                <tr>
                  <td style="background-color: #3b45d4; border-radius: 8px;">
                    <a href="{{ projectUrl }}" style="display: inline-block; padding: 12px 22px; color: #ffffff; font-size: 15px; font-weight: 500; text-decoration: none;">See your usage</a>
                  </td>
                </tr>
              </table>

              <p style="color: #71717a; font-size: 13px; line-height: 1.6; margin: 0; padding-top: 20px; border-top: 1px solid #e4e4e7;">
                Your quota resets at the start of next month, in this project's own timezone. Reports and dashboards
                keep working either way; only new events are affected.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding-top: 20px; text-align: center;">
              <p style="color: #a1a1aa; font-size: 12px; margin: 0;">{{ year }} {{ appName }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
