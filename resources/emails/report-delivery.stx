<script server>
const appName = props.appName || 'ReportsHQ'
const reportName = props.reportName || 'Your report'
const period = props.period || ''
const reportUrl = props.reportUrl || '#'
// Pre-rendered rows from the sender. The email template API carries primitives
// and pre-rendered HTML rather than structured values, so the loop lives in
// app/Mail/ReportDelivery.ts. The template does no arithmetic either way: a
// number formatted twice is a number that can disagree with the screen it came
// from.
const headlines = props.headlines || ''
const year = props.year || new Date().getFullYear()
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ reportName }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f7f7f8; line-height: 1.6; color: #1a1a1c;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; background-color: #f7f7f8;">
    <tr>
      <td style="padding: 40px 20px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto;">

          <tr>
            <td style="padding-bottom: 24px;">
              <span style="color: #1a1a1c; font-size: 18px; font-weight: 600;">{{ appName }}</span>
            </td>
          </tr>

          <tr>
            <td style="background-color: #ffffff; border: 1px solid #e4e4e7; border-radius: 12px; padding: 32px;">

              <h1 style="color: #1a1a1c; font-size: 20px; font-weight: 600; margin: 0 0 4px;">{{ reportName }}</h1>
              <p style="color: #71717a; font-size: 13px; margin: 0 0 24px;">{{ period }}</p>

              {{-- The numbers, not a picture of them. A chart image in an email
                   is blocked by default in most clients, and a report that
                   arrives as a grey box with a broken-image icon is worse than
                   one that arrives as four numbers somebody can read. --}}
              {{-- The numbers, not a picture of them. A chart image in an email
                   is blocked by default in most clients, and a report that
                   arrives as a grey box with a broken-image icon is worse than
                   one that arrives as four numbers somebody can read. --}}
              {{{ headlines }}}

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 0 8px;">
                <tr>
                  <td style="background-color: #3b45d4; border-radius: 8px;">
                    <a href="{{ reportUrl }}" style="display: inline-block; padding: 12px 22px; color: #ffffff; font-size: 15px; font-weight: 500; text-decoration: none;">Open the full report</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding-top: 20px; text-align: center;">
              <p style="color: #a1a1aa; font-size: 12px; margin: 0;">{{ year }} {{ appName }}</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
