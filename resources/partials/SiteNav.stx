{{-- The public site's top bar.

     A partial rather than a component, for the reason the whole app uses
     partials: stx drops props passed component to component, and shared chrome
     that silently loses its links is worse than no chrome. --}}
<header class="bg-canvas border-b border-line">
  <div class="flex gap-4 items-center justify-between mx-auto px-6 py-4 max-w-6xl">
    <a href="/" class="flex gap-2 items-center no-underline">
      <i class="h-5 w-5 text-accent i-hugeicons-chart-histogram"></i>
      <span class="font-semibold text-ink tracking-tight">ReportsHQ</span>
    </a>

    {{-- Below sm there is not room for four links beside the wordmark, and a
         nav that overflows the viewport gives the whole page a horizontal
         scrollbar. The two that go are the two the footer also carries, so
         nothing becomes unreachable on a phone. --}}
    <nav class="flex gap-1 items-center">
      <a href="/pricing" class="hidden sm:inline-block px-3 py-1.5 no-underline text-muted text-sm hover:text-ink rounded-lg">Pricing</a>
      <a href="/docs" class="hidden sm:inline-block px-3 py-1.5 no-underline text-muted text-sm hover:text-ink rounded-lg">Docs</a>
      <a href="/login" class="px-3 py-1.5 no-underline text-muted text-sm hover:text-ink rounded-lg">Sign in</a>
      <a href="/register" class="ml-1 px-3 py-1.5 font-medium no-underline text-accent-ink text-sm bg-accent rounded-lg">
        Start free
      </a>
    </nav>
  </div>
</header>
