<script>
import { defineProps } from 'stx'
import { compact, seriesColor } from '../../functions/charts'

/**
 * Steps, and how many sessions survived each.
 *
 * Horizontal bars sharing a left edge rather than a tapering trapezoid: a
 * trapezoid encodes the same number twice, in width and in area, and the area
 * exaggerates every drop.
 *
 * Two rates per step, because they answer different questions: share of the
 * first step is how the funnel is doing overall, share of the previous step is
 * where it is leaking.
 */
/**
 * The frame is inlined rather than shared through a ChartFrame component.
 *
 * stx drops every prop passed from one component to another in this version: a
 * wrapper passing an array, a boolean and a plain string attribute delivers an
 * empty array, false and an empty string, with nothing warning. Page to
 * component works fine, which is why it took a missing legend to notice. A
 * shared frame would therefore have rendered without its legend on every chart,
 * and the legend is what makes this palette legal.
 */
interface FunnelChartProps {
  result: any
  title?: string
}

const { result, title } = defineProps<FunnelChartProps>()

/*
 * Steps come from the series, in the order the query returned them.
 *
 * This used to read `result.steps`, a shape the hosted event pipeline produced
 * and nothing produces now. It therefore always fell through to its empty
 * branch, which referenced an `emptyMessage` that was never declared here, and
 * an undefined reference in a compiled render throws: the element drew nothing
 * at all. Both halves were invisible to the unit tests, which assert numbers
 * and never look at what a component draws.
 */
const raw = (result.series ?? []).map((series: any) => ({
  name: series.key,
  value: series.total ?? 0,
}))

// Largest first. A funnel that does not descend is not a funnel, and the
// compiler orders a dimensioned query by value already; this makes it true
// even when a caller hands the series over in another order.
raw.sort((a: any, b: any) => b.value - a.value)

const first = raw[0]?.value ?? 0

const steps = raw.map((step: any, index: number) => {
  const previous = index === 0 ? step.value : raw[index - 1].value

  return {
    name: step.name,
    count: compact(step.value),
    // Never zero width: a step that kept nothing still needs a row somebody
    // can see and read a label against.
    width: first === 0 ? 2 : Math.max(2, (step.value / first) * 100),
    ofFirst: first === 0 ? '-' : `${Math.round((step.value / first) * 100)}%`,
    ofPrevious: previous === 0 ? '-' : `${Math.round((step.value / previous) * 100)}%`,
    dropped: index === 0 ? null : compact(Math.max(0, previous - step.value)),
    color: seriesColor(index),
  }
})

const empty = steps.length === 0 || first === 0
const emptyMessage = 'No data in this range'
const legend: Array<{ key: string, color: string, value?: string }> = []
</script>

<template>
    <figure class="flex flex-col h-full m-0">
    @if (title)
      <figcaption class="mb-3 text-sm font-medium text-ink">{{ title }}</figcaption>
    @endif

    @if (empty)
      <div class="flex flex-1 flex-col gap-1 justify-center items-center py-8 text-center">
        <i class="w-5 h-5 text-subtle i-hugeicons-chart-line-data-01"></i>
        <p class="text-sm text-muted">{{ emptyMessage }}</p>
        <p class="text-xs text-subtle">Events that arrive later will appear here.</p>
      </div>
    @else
      <div class="flex-1 min-h-0">
    <ol class="flex flex-col gap-3 justify-center py-1 h-full list-none">
      @foreach (steps as step)
        <li>
          <div class="flex gap-3 justify-between items-baseline mb-1">
            <span class="text-sm text-ink">{{ step.name }}</span>
            <span class="flex gap-3 items-baseline text-xs">
              <span class="num text-ink">{{ step.count }}</span>
              <span class="num text-subtle">{{ step.ofFirst }}</span>
            </span>
          </div>
          <div class="overflow-hidden h-2.5 rounded-full bg-canvas">
            <div class="h-full rounded-full" style="width: {{ step.width }}%; background: {{ step.color }}"></div>
          </div>
          @if (step.dropped)
            <p class="mt-1 text-xs text-subtle">
              <span class="num">{{ step.ofPrevious }}</span> of the previous step,
              <span class="num">{{ step.dropped }}</span> dropped
            </p>
          @endif
        </li>
      @endforeach
    </ol>
      </div>

      @if (legend.length > 1)
        {{-- Always present for two or more series: identity must never rest on
             colour alone, and one adjacent pair in this palette sits in the
             band where a legend is the condition of the palette being usable.
             Text wears text tokens; the swatch carries the identity. --}}
        <ul class="flex flex-wrap gap-x-4 gap-y-1 items-center pt-3 mt-3 list-none border-t border-line">
          @foreach (legend as entry)
            <li class="flex gap-2 items-center text-xs text-muted">
              <span class="w-2.5 h-2.5 rounded-sm shrink-0" style="background: {{ entry.color }}"></span>
              <span>{{ entry.key }}</span>
              @if (entry.value)
                <span class="num text-subtle">{{ entry.value }}</span>
              @endif
            </li>
          @endforeach
        </ul>
      @endif
    @endif
  </figure>
</template>
