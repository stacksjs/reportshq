<script>
import { defineProps, withDefaults } from 'stx'
import { compact, seriesColor } from '../../functions/charts'

/**
 * The numbers as numbers.
 *
 * A block in its own right, and also the accessible view of every other chart:
 * a reader who cannot use colour, or is on a screen reader, gets the same data
 * in a form that does not depend on either.
 */
/**
 * Named `TableChart`, not `DataTable`, and that is not a style choice.
 *
 * `@stacksjs/ts-analytics` ships a `DataTable` of its own, and when two
 * components share a name the framework's wins, silently. Every table block in
 * the product was therefore rendering that component instead of this one: it
 * expects `rows` and `columns`, received `result`, and emitted
 * `<!-- [Foreach Error [1102]]: rows is not iterable -->` into a table body
 * nobody reads the source of. The header row still drew, so a table with no
 * rows looked exactly like a table with no data, on the report viewer, the
 * builder, the embed and every public share link.
 *
 * The sibling charts carry the `Chart` suffix for this reason. This one did
 * not, and was the only one broken.
 *
 * `rows` is built with `.slice()` rather than `[...result.series]`, and that is
 * load-bearing. stx's server-script parser does not lift a `const` whose
 * initializer *begins* with an array spread: the binding exists in the script
 * and never reaches template scope, so `@foreach` reported `rows is not
 * iterable` while `rows.length` in the same script read fine. It took the
 * `withDefaults` default for `label` down with it, which is why the first
 * column header was blank. Both cleared together the moment the spread moved.
 *
 * That is an stx defect and belongs upstream, not here; `.slice()` is the
 * idiomatic copy anyway, so this is not a workaround so much as the form that
 * happens to parse. Anything added to this script should avoid opening a
 * declaration with `[...`.
 *
 * The frame is inlined rather than shared through a ChartFrame component.
 *
 * stx drops every prop passed from one component to another in this version: a
 * wrapper passing an array, a boolean and a plain string attribute delivers an
 * empty array, false and an empty string, with nothing warning. Page to
 * component works fine, which is why it took a missing legend to notice. A
 * shared frame would therefore have rendered without its legend on every chart,
 * and the legend is what makes this palette legal.
 */
interface TableChartProps {
  result: any
  title?: string
  /** Column header for the series key. */
  label?: string
}

const { result, title, label } = withDefaults(defineProps<TableChartProps>(), { label: 'Series' })

const total = result.series.reduce((sum: number, series: any) => sum + series.total, 0)
const rows = result.series
  .slice()
  .sort((a: any, b: any) => b.total - a.total)
  .map((series: any, index: number) => ({
    // `||`, not `??`. An untitled block passes an empty string rather than
    // undefined, so the nullish form left the only row in an ungrouped table
    // labelled with nothing at all: a colour swatch, a number, and no word
    // saying what the number was of.
    key: series.key === 'total' ? (title || 'Total') : series.key,
    color: seriesColor(index, series.key),
    value: compact(series.total),
    share: total > 0 ? `${Math.round((series.total / total) * 100)}%` : '-',
  }))

const empty = rows.length === 0 || total === 0
const legend: Array<{ key: string, color: string, value?: string }> = []
const emptyMessage = 'No data in this range'
</script>

<template>
    <figure class="flex flex-col m-0 h-full">
    @if (title)
      <figcaption class="mb-3 font-medium text-ink text-sm">{{ title }}</figcaption>
    @endif

    @if (empty)
      <div class="flex flex-1 flex-col gap-1 items-center justify-center py-8 text-center">
        <i class="h-5 w-5 text-subtle i-hugeicons-chart-line-data-01"></i>
        <p class="text-muted text-sm">{{ emptyMessage }}</p>
        <p class="text-subtle text-xs">Events that arrive later will appear here.</p>
      </div>
    @else
      <div class="flex-1 min-h-0">
    <div class="overflow-auto h-full">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="text-left border-b border-line">
            <th class="pr-3 py-2 font-medium text-subtle text-xs">{{ label }}</th>
            <th class="px-3 py-2 font-medium text-right text-subtle text-xs">Value</th>
            <th class="pl-3 py-2 font-medium text-right text-subtle text-xs">Share</th>
          </tr>
        </thead>
        <tbody>
          @foreach (rows as row)
            <tr class="border-b border-line last:border-0">
              <td class="pr-3 py-2">
                <span class="flex gap-2 items-center text-ink">
                  <span class="shrink-0 h-2.5 w-2.5 rounded-sm" style="background: {{ row.color }}"></span>
                  {{ row.key }}
                </span>
              </td>
              <td class="px-3 py-2 text-ink text-right num">{{ row.value }}</td>
              <td class="pl-3 py-2 text-muted text-right num">{{ row.share }}</td>
            </tr>
          @endforeach
        </tbody>
      </table>
    </div>
      </div>

      @if (legend.length > 1)
        {{-- Always present for two or more series: identity must never rest on
             colour alone, and one adjacent pair in this palette sits in the
             band where a legend is the condition of the palette being usable.
             Text wears text tokens; the swatch carries the identity. --}}
        <ul class="flex flex-wrap gap-x-4 gap-y-1 items-center mt-3 pt-3 list-none border-line border-t">
          @foreach (legend as entry)
            <li class="flex gap-2 items-center text-muted text-xs">
              <span class="shrink-0 h-2.5 w-2.5 rounded-sm" style="background: {{ entry.color }}"></span>
              <span>{{ entry.key }}</span>
              @if (entry.value)
                <span class="text-subtle num">{{ entry.value }}</span>
              @endif
            </li>
          @endforeach
        </ul>
      @endif
    @endif
  </figure>
</template>
