<script server>
// One project: its reports, and the integration state a new project cares
// about most.
import { db as __db } from '@stacksjs/database'
import { archivedReports, reportsFor } from '../../app/Reports/reports'
import { accessFor, canAdminister } from '../../app/Support/access'
import { param, sessionCookieName, sessionFrom } from '../../app/Support/session'

const session = await sessionFrom(cookies)
const cookieName = sessionCookieName()
const user = session.user
const authPending = session.stale

const projectId = Number(param(query, 'id') ?? 0)

// Permission first, before a single row about this project is read. A caller
// who may not see it gets the same answer as one asking about a project that
// does not exist.
const access = user && projectId ? await accessFor(user, projectId) : null
const allowed = access !== null

const project = allowed
  ? (await __db.unsafe(`SELECT * FROM projects WHERE id = $1`, [projectId]))?.[0] as Record<string, unknown>
  : null

const reports = allowed ? await reportsFor(projectId) : []
const archived = allowed ? await archivedReports(projectId) : []
const mayAdminister = allowed && user ? await canAdminister(user, projectId) : false

// The write credential is shown only to someone who may administer the
// project. A member who reads reports has no reason to hold the ability to
// write events into them.
const ingestKey = mayAdminister ? String(project?.ingest_key ?? '') : ''
const receiving = !!project?.first_event_at

const rows = allowed
  ? await __db.unsafe(`SELECT COUNT(*) AS n FROM events WHERE project_id = $1`, [projectId]) as Array<{ n: number }>
  : []
const eventCount = Number(rows[0]?.n ?? 0)

const cards = reports.map(report => ({
  name: String(report.name),
  slug: String(report.slug),
  status: String(report.status),
  origin: String(report.origin),
  description: report.description ? String(report.description) : '',
  draft: String(report.status) === 'draft',
  // A published report whose draft has moved on. Worth a word on the card,
  // because "I published that" and "everyone can see that" stopped being the
  // same sentence the moment the builder gained a draft.
  ahead: String(report.status) === 'published' && Boolean(report.unpublished_changes),
  href: `/report?project=${projectId}&slug=${String(report.slug)}`,
  editHref: `/report-edit?project=${projectId}&slug=${String(report.slug)}`,
}))

const shelved = archived.map(report => ({
  id: Number(report.id),
  name: String(report.name),
}))

const curlSnippet = ingestKey
  ? `curl -X POST https://reportshq.org/ingest \\\n  -H "X-ReportsHQ-Key: ${ingestKey}" \\\n  -H "Content-Type: application/json" \\\n  -d '{"events":[{"name":"commerce.order.created","value":4250,"currency":"USD"}]}'`
  : ''
</script>

<template>
  {{-- The guard is a plain script and cannot import; the name it must
       check is stamped here, from the same resolver the middleware uses.

       No quotes around the interpolation. stx JSON-encodes `{{ }}` inside a
       script block, so the value arrives already quoted; wrapping it again
       produced a cookie name containing literal quote characters, the guard
       looked for a cookie nobody had, and every signed-in visitor was bounced
       to /login. curl never caught it because curl does not run scripts. --}}
  <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>
  @include('AuthGuard')

  <div class="min-h-[100dvh] bg-canvas text-ink">
    {{-- What the guard reads. The server is the only side that can see the
         HttpOnly session cookie, so it is the side that decides. --}}
    @if (!user)
      <div id="auth-required" hidden></div>
    @endif
    @if (authPending)
      <div id="auth-pending" hidden></div>
    @endif

    @include('AppNav')

    <main class="px-6 py-10 mx-auto max-w-7xl">
      @if (!allowed)
        {{-- 404 rather than 403: telling a stranger "forbidden" confirms the
             id exists, which is the one thing they did not know. --}}
        <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
          <h1 class="text-base font-medium">Project not found</h1>
          <p class="mt-1 text-sm text-muted">It may have been deleted, or it may not be yours.</p>
          <a href="/projects" class="inline-block mt-5 text-sm text-accent">Back to projects</a>
        </div>
      @else
        <nav class="mb-6 text-sm text-subtle">
          <a href="/projects" class="text-muted">Projects</a>
          <span class="mx-2">/</span>
          <span>{{ project.name }}</span>
        </nav>

        <div class="flex flex-wrap gap-4 justify-between items-end mb-8">
          <div>
            <h1 class="text-2xl font-semibold tracking-tight">{{ project.name }}</h1>
            <p class="mt-1 text-sm text-muted">
              <span class="num">{{ eventCount }}</span> events &middot; {{ project.timezone }}
            </p>
          </div>

          @if (mayAdminister)
            <a
              href="/project-settings?id={{ projectId }}"
              class="px-3 py-2 text-sm no-underline rounded-lg border border-line text-ink hover:border-accent"
            >Settings</a>
          @endif
        </div>

        @if (!receiving)
          {{-- Onboarding is the page while a project has never received
               anything. Everything else is empty by definition. --}}
          <section class="p-6 mb-8 rounded-xl border border-line bg-panel">
            <h2 class="text-base font-medium">Send your first event</h2>
            <p class="mt-1 max-w-[65ch] text-sm text-muted">
              Reports build themselves once events arrive. Paste this into a terminal to check the
              connection, then use one of the integration packages to send events from your app.
            </p>

            @if (ingestKey)
              <pre class="overflow-x-auto p-4 mt-4 font-mono text-xs rounded-lg border border-line bg-canvas text-ink">{{ curlSnippet }}</pre>
              <p class="mt-3 text-xs text-subtle">
                This key is public by design: it ships inside your application and can only append
                events to this project. It can never read anything.
              </p>
            @else
              <p class="mt-4 text-sm text-subtle">
                Ask an owner or admin for the ingest key.
              </p>
            @endif

            {{-- The page watches for the first event rather than making
                 somebody refresh to find out whether their paste worked. That
                 refresh is the moment an integration either feels instant or
                 feels broken. --}}
            <p id="listening" class="flex gap-2 items-center mt-5 text-sm text-muted">
              <span class="pulse-dot" aria-hidden="true"></span>
              Waiting for the first event
            </p>
          </section>
        @endif

        <section>
          <div class="flex flex-wrap gap-3 justify-between items-end mb-4">
            <h2 class="text-lg font-semibold">Reports</h2>
            <button id="new-report" type="button" class="px-3 py-2 text-sm font-medium rounded-lg bg-accent text-accent-ink">
              New report
            </button>
          </div>

          @if (cards.length === 0)
            <div class="px-6 py-14 text-center rounded-xl border border-line bg-panel">
              <i class="mx-auto w-6 h-6 text-subtle i-hugeicons-chart-line-data-01"></i>
              <h3 class="mt-3 text-base font-medium">No reports yet</h3>
              <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
                Reports appear on their own once recognised events arrive, and you can build your
                own at any time.
              </p>
              <button id="new-report-empty" type="button" class="px-4 py-2 mt-5 text-sm font-medium rounded-lg bg-accent text-accent-ink">
                Build one now
              </button>
            </div>
          @else
            <ul class="grid gap-4 list-none sm:grid-cols-2 lg:grid-cols-3">
              @foreach (cards as card)
                {{-- The card is a link and the actions are buttons beside it,
                     rather than buttons inside the link: a button nested in an
                     anchor is invalid, and every click on it also follows the
                     link. --}}
                <li class="flex flex-col rounded-xl border transition-colors border-line bg-panel hover:border-accent">
                  <a href="{{ card.href }}" class="block flex-1 p-5 no-underline">
                    <div class="flex gap-3 justify-between items-start">
                      <h3 class="text-base font-medium text-ink">{{ card.name }}</h3>
                      @if (card.origin === 'template')
                        <span class="px-2 py-0.5 text-xs rounded-full bg-accent-soft text-accent">auto</span>
                      @endif
                    </div>
                    @if (card.description)
                      <p class="mt-2 text-sm text-muted">{{ card.description }}</p>
                    @endif
                    @if (card.draft)
                      <p class="mt-3 text-xs text-warn">Draft, nobody else can see it</p>
                    @elseif (card.ahead)
                      <p class="mt-3 text-xs text-warn">Unpublished changes</p>
                    @endif
                  </a>

                  <div class="flex gap-3 items-center px-5 py-3 border-t border-line">
                    <a href="{{ card.editHref }}" class="text-xs no-underline text-muted hover:text-ink">Edit</a>
                    <button type="button" class="text-xs duplicate-report text-muted hover:text-ink" data-slug="{{ card.slug }}">Duplicate</button>
                    <button type="button" class="ml-auto text-xs archive-report text-subtle hover:text-neg" data-slug="{{ card.slug }}">Archive</button>
                  </div>
                </li>
              @endforeach
            </ul>
          @endif

          @if (shelved.length > 0)
            {{-- Archived reports are listed rather than hidden. Archiving is
                 reversible, and a reversible action nobody can find is not. --}}
            <details class="mt-6">
              <summary class="text-sm cursor-pointer text-muted">Archived ({{ shelved.length }})</summary>
              <ul class="mt-3 rounded-xl border divide-y list-none border-line divide-line bg-panel">
                @foreach (shelved as item)
                  <li class="flex gap-3 justify-between items-center px-5 py-3">
                    <span class="text-sm text-muted">{{ item.name }}</span>
                    <button type="button" class="text-xs restore-report text-accent" data-id="{{ item.id }}">Restore</button>
                  </li>
                @endforeach
              </ul>
            </details>
          @endif

          <p id="reports-error" class="mt-4 text-sm text-warn" hidden></p>
        </section>
      @endif
    </main>
  </div>

{{-- Report management.

     A plain script for the same reason as everywhere else in this app: it runs
     before the runtime and touches the DOM directly, which is the exemption
     these pages already take. --}}
<script>
(function () {
  // Named to avoid every top-level server binding on this page. stx publishes
  // a server binding into the HTML as bridge data as soon as its name appears in
  // a client script, so a local called `project` collides with the project row
  // and takes `{{ project.name }}` and the report list down with it.
  var currentProject = new URLSearchParams(window.location.search).get('id')
  if (!currentProject) return

  var error = document.getElementById('reports-error')

  // ---- Waiting for the first event ------------------------------------
  //
  // Polled rather than pushed. A websocket for a state that changes exactly
  // once per project, and is only watched during onboarding, would be a
  // connection to maintain forever to save a handful of requests during the
  // one minute anybody is looking.
  var listening = document.getElementById('listening')
  if (listening) {
    var INTERVAL = 3000
    // Ten minutes. A tab left open on this page overnight should not keep
    // asking; whoever comes back will reload anyway.
    var GIVE_UP_AT = Date.now() + 10 * 60 * 1000
    var timer = null

    function stopListening() {
      if (timer) clearInterval(timer)
      timer = null
    }

    function poll() {
      if (Date.now() > GIVE_UP_AT) {
        stopListening()
        listening.textContent = 'Still nothing. Reload when you have sent one.'
        return
      }

      // Skipped while the tab is hidden: nobody is watching, and a backgrounded
      // tab polling every three seconds is somebody's battery.
      if (document.hidden) return

      fetch('/api/projects/' + currentProject, { credentials: 'same-origin' })
        .then(function (res) { return res.ok ? res.json() : null })
        .then(function (data) {
          if (!data || !data.project || !data.project.first_event_at) return

          stopListening()
          listening.textContent = 'First event received'
          // A moment to read that before the page changes under them.
          setTimeout(function () { window.location.reload() }, 800)
        })
        .catch(function () {
          // A failed poll is not worth reporting: the next one is three
          // seconds away and the page is still correct.
        })
    }

    timer = setInterval(poll, INTERVAL)
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) poll()
    })
  }

  function fail(message) {
    if (!error) return
    error.textContent = message || ''
    error.hidden = !message
  }

  // The builder's write surface is CSRF-exempt by design (see routes/reports.ts),
  // so these posts carry no token. Everything they can do is scoped to a project
  // the caller already has access to.
  function post(path, payload) {
    return fetch('/api/reports/' + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(payload),
    })
  }

  function reloadOr(res, message) {
    if (res.ok) {
      window.location.reload()
      return
    }
    return res.json().then(function (data) {
      fail((data && data.message) || message)
    }).catch(function () { fail(message) })
  }

  function create() {
    fail('')
    // Named on creation rather than asked for up front. A dialog demanding a
    // name before showing the grid is a decision made at the least informed
    // moment; it is renamed in the builder's settings panel.
    post('create', { project: Number(currentProject), name: 'Untitled report' })
      .then(function (res) {
        if (!res.ok) return reloadOr(res, 'Could not create that report.')

        return res.json().then(function (data) {
          var slug = data && data.report && data.report.slug
          // Straight into the builder: creating a report and then being left
          // on a list to find it is a step nobody wanted.
          window.location.href = slug
            ? '/report-edit?project=' + currentProject + '&slug=' + encodeURIComponent(slug)
            : window.location.href
        })
      })
      .catch(function () { fail('Could not reach the server.') })
  }

  var newButton = document.getElementById('new-report')
  if (newButton) newButton.addEventListener('click', create)

  var newEmpty = document.getElementById('new-report-empty')
  if (newEmpty) newEmpty.addEventListener('click', create)

  Array.prototype.forEach.call(document.querySelectorAll('.duplicate-report'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      post('duplicate', { project: Number(currentProject), slug: button.dataset.slug })
        .then(function (res) { return reloadOr(res, 'Could not duplicate that report.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  Array.prototype.forEach.call(document.querySelectorAll('.archive-report'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      // No confirmation dialog. Archiving is reversible and the archived list
      // is right there; a confirm on a reversible action trains people to
      // dismiss confirms on the irreversible ones.
      post('archive', { project: Number(currentProject), slug: button.dataset.slug })
        .then(function (res) { return reloadOr(res, 'Could not archive that report.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  Array.prototype.forEach.call(document.querySelectorAll('.restore-report'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      post('restore', { project: Number(currentProject), id: Number(button.dataset.id) })
        .then(function (res) { return reloadOr(res, 'Could not restore that report.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })
}())
</script>
</template>

<style>
/* The listening indicator. A slow pulse rather than a spinner: nothing is
 * loading, something is being waited for, and those should not look the same. */
.pulse-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 9999px;
  background: var(--accent);
  animation: pulse-dot 1.8s ease-in-out infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .pulse-dot {
    animation: none;
    opacity: 0.7;
  }
}
</style>

