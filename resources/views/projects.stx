<script server>
// Every project the signed-in user can see, owned or joined.
//
// Authenticates before it renders. A page that paints the shell and then
// discovers the visitor is a stranger has already shown them the shape of
// somebody's account.
import { db as __db } from '@stacksjs/database'
import { projectsFor } from '../../app/Support/access'
import { sessionCookieName, sessionFrom } from '../../app/Support/session'

// The token never becomes a binding in this file. stx publishes top-level
// server bindings into the HTML as bridge data as soon as the name appears in a
// client script, comments included, so reading the cookie here and naming it
// `token` would ship the session credential in the page source.
const session = await sessionFrom(cookies)
const cookieName = sessionCookieName()
const user = session.user
const authPending = session.stale

const projects = user ? await projectsFor(user) : []

// Event counts per project, in one query rather than one per row: a projects
// list is the first page after sign-in and should not scale its cost with how
// many projects somebody has.
const counts = new Map<number, number>()
if (projects.length > 0) {
  const rows = await __db.unsafe(
    `SELECT project_id, COUNT(*) AS n FROM events WHERE project_id IN (${projects.map((_, i) => `$${i + 1}`).join(', ')}) GROUP BY project_id`,
    projects.map(project => Number(project.id)),
  ) as Array<{ project_id: number, n: number }>

  for (const row of rows)
    counts.set(Number(row.project_id), Number(row.n))
}

const cards = projects.map(project => ({
  id: Number(project.id),
  name: String(project.name),
  role: String(project.role ?? 'member'),
  events: counts.get(Number(project.id)) ?? 0,
  receiving: !!project.first_event_at,
  href: `/project?id=${Number(project.id)}`,
}))
</script>

<template>
  {{-- The guard is a plain script and cannot import; the name it must
       check is stamped here, from the same resolver the middleware uses.

       No quotes around the interpolation. stx JSON-encodes `{{ }}` inside a
       script block, so the value arrives already quoted; wrapping it again
       produced a cookie name containing literal quote characters, the guard
       looked for a cookie nobody had, and every signed-in visitor was bounced
       to /login. curl never caught it because curl does not run scripts. --}}
  <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>
  @include('AuthGuard')

  <div class="min-h-[100dvh] bg-canvas text-ink">
    @if (authPending)
      <div id="auth-pending" hidden></div>
    @endif

    @include('AppNav')

    <main class="px-6 py-10 mx-auto max-w-7xl">
      <div class="flex flex-wrap gap-4 justify-between items-end mb-8">
        <div>
          <h1 class="text-2xl font-semibold tracking-tight">Projects</h1>
          <p class="mt-1 text-sm text-muted">Each project has its own events, reports and ingest key.</p>
        </div>

        <a href="/project-new" class="px-4 py-2 text-sm font-medium no-underline rounded-lg bg-accent text-accent-ink">
          New project
        </a>
      </div>

      @if (cards.length === 0)
        {{-- One obvious next action, and nothing else competing with it. --}}
        <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
          <i class="mx-auto w-6 h-6 text-subtle i-hugeicons-folder-add"></i>
          <h2 class="mt-3 text-base font-medium">No projects yet</h2>
          <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
            A project is where your events arrive and your reports live. Create one and you will get
            an ingest key and a snippet to paste.
          </p>
          <a href="/project-new" class="inline-block px-4 py-2 mt-5 text-sm font-medium no-underline rounded-lg bg-accent text-accent-ink">
            Create your first project
          </a>
        </div>
      @else
        <ul class="grid gap-4 list-none sm:grid-cols-2 lg:grid-cols-3">
          @foreach (cards as card)
            <li>
              <a href="{{ card.href }}" class="block p-5 h-full no-underline rounded-xl border transition-colors border-line bg-panel hover:border-accent">
                <div class="flex gap-3 justify-between items-start">
                  <h2 class="text-base font-medium text-ink">{{ card.name }}</h2>
                  <span class="px-2 py-0.5 text-xs rounded-full bg-accent-soft text-accent">{{ card.role }}</span>
                </div>

                @if (card.receiving)
                  <p class="mt-3 text-sm text-muted">
                    <span class="num text-ink">{{ card.events }}</span> events
                  </p>
                @else
                  {{-- The state that matters most on this page: a project that
                       has never received anything is an integration that has
                       not landed, and it should say so here rather than after
                       a click. --}}
                  <p class="flex gap-1.5 items-center mt-3 text-sm text-warn">
                    <i class="w-4 h-4 i-hugeicons-alert-02"></i>
                    Waiting for its first event
                  </p>
                @endif
              </a>
            </li>
          @endforeach
        </ul>
      @endif
    </main>
  </div>
</template>
