<script server>
// Choosing a new password, from an emailed link.
//
// The token and address come from the query string, which is where the email
// put them. They are read here only to hand back to the API: the page never
// decides whether a token is valid, because a page cannot be trusted to.
import { param, sessionCookieName, sessionFrom } from '../../app/Support/session'

const session = await sessionFrom(cookies)
const cookieName = sessionCookieName()
// Deliberately not bounced when signed in. Somebody resetting a password may
// well have a stale session open in another tab, and that is the case they are
// most likely trying to fix.
const signedIn = false

const token = param(query, 'token') ?? ''
const email = param(query, 'email') ?? ''
const usable = token !== '' && email !== ''
</script>

<template>
  <div class="min-h-[100dvh] bg-canvas text-ink">
    {{-- Already signed in: bounce before anything paints, the same way the
         guard does in the other direction. --}}


    <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>

    <main class="grid place-items-center px-6 py-16 min-h-[100dvh]">
      <div class="w-full max-w-sm">
        <a href="/" class="flex gap-2 items-center mb-8 no-underline">
          <i class="w-5 h-5 i-hugeicons-chart-histogram text-accent"></i>
          <span class="font-semibold tracking-tight text-ink">ReportsHQ</span>
        </a>

        <h1 class="text-2xl font-semibold tracking-tight">Choose a new password</h1>
        @if (usable)
          <p class="mt-1 mb-6 text-sm text-muted">For {{ email }}. Signing in elsewhere ends when you save this.</p>
        @else
          <p class="mt-1 mb-6 text-sm text-warn">This link is missing part of itself. Ask for a new one.</p>
        @endif

        {{-- A real form, so a password manager recognises it and the enter key
             submits. The script intercepts it; without the script it still
             posts somewhere sensible rather than nowhere. --}}
        <form id="signin" method="post" action="/api/auth/reset" class="grid gap-4" @if (!usable) hidden @endif>
          <input id="token" type="hidden" value="{{ token }}" />
          <input id="email" type="hidden" value="{{ email }}" />

          <label class="block">
            <span class="block mb-1 text-sm text-muted">New password</span>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              required
              class="px-3 py-2 w-full text-sm rounded-lg border border-line bg-panel text-ink"
            />
          </label>

          <p class="-mt-2 text-xs text-subtle">At least 10 characters. Length beats punctuation.</p>

          <p id="error" class="text-sm text-warn" hidden></p>

          <button
            id="submit"
            type="submit"
            class="px-4 py-2.5 text-sm font-medium rounded-lg bg-accent text-accent-ink disabled:opacity-60"
          >Save it</button>
        </form>

        <p class="mt-6 text-sm text-muted">
          <a href="/forgot" class="text-accent">Ask for a new link</a>
        </p>
      </div>
    </main>
  </div>

{{-- Submitting the form.

     A plain script for the same reason as the guard: this page has to work
     before the runtime is loaded, and the whole page is one form. --}}
<script>
(function () {
  var form = document.getElementById('signin')
  if (!form) return

  var error = document.getElementById('error')
  var submit = document.getElementById('submit')

  function fail(message) {
    error.textContent = message
    error.hidden = !message
    submit.disabled = false
    submit.textContent = 'Save it'
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault()
    fail('')
    submit.disabled = true
    submit.textContent = 'Saving'

    fetch('/api/auth/reset', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        email: document.getElementById('email').value,
        token: document.getElementById('token').value,
        password: document.getElementById('password').value,
      }),
    }).then(function (res) {
      if (res.ok) {
        // To sign-in rather than straight into the app: the reset revoked every
        // session, including any this browser was holding, so there is nothing
        // to walk into.
        window.location.replace('/login')
        return
      }

      return res.json().then(function (data) {
        fail((data && data.message) || 'Could not save that password.')
      }).catch(function () { fail('Could not save that password.') })
    }).catch(function () {
      fail('Could not reach the server.')
    })
  })
}())
</script>
</template>
