<script server>
// Choosing a new password, from an emailed link.
//
// The token and address come from the query string, which is where the email
// put them. They are read here only to hand back to the API: the page never
// decides whether a token is valid, because a page cannot be trusted to.
import { param, sessionFrom } from '~/app/Support/session'

// Resolved for parity with the other auth views; this page does not bounce a
// signed-in visitor (see below), so nothing is read off it.
await sessionFrom(typeof cookies !== 'undefined' ? cookies : undefined)
// Deliberately not bounced when signed in. Somebody resetting a password may
// well have a stale session open in another tab, and that is the case they are
// most likely trying to fix.

const pageQuery = typeof query !== 'undefined' ? query : undefined
const __resetToken = param(pageQuery, 'token') ?? ''
const email = param(pageQuery, 'email') ?? ''
const usable = __resetToken !== '' && email !== ''
</script>

<script client>
// Submitting the form, as stx client code rather than the DOM-walking script
// this used to be (stx-standards rule 8). login.stx carries the longer note on
// why each replacement is the one it is.
//
// It replaced a bare script holding `signin`, `error` and `submit` by id, which
// read the token, the address and the new password by id on submit and wrote
// the banner, the aria-invalid attribute, the button label and `disabled` by
// hand. `error` and `loading` own all of that now.
//
// The token and the address are still carried by hidden inputs rather than
// closed over from the server block. They are server values, and a client block
// that named them would have them serialised into the page as script data on
// top of the markup that already holds them -- two copies of a single-use
// credential where one will do.
const error = state('')
const loading = state(false)

/** What /api/auth/reset answers with. */
interface ResetResponse {
  message?: string
}

// `e.target` is an EventTarget and `form.elements` hands back Elements, so
// reading a field is two narrowings. A field the markup does not contain reads
// as empty rather than throwing -- the endpoint decides whether a token is
// good, which is the whole reason this page does not try to.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

async function handleSubmit(event: SubmitEvent): Promise<void> {
  event.preventDefault()
  if (loading())
    return
  const form = event.target
  if (!(form instanceof HTMLFormElement))
    return

  loading.set(true)
  error.set('')

  try {
    const res = await fetch('/api/auth/reset', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: fieldValue(form, 'email'),
        token: fieldValue(form, 'token'),
        password: fieldValue(form, 'password'),
      }),
    })

    if (res.ok) {
      // To sign-in rather than straight into the app: the reset revoked every
      // session, including any this browser was holding, so there is nothing to
      // walk into. replace, not assign -- the link is spent, and the back
      // button should not return to a form that will now be refused.
      navigate('/login', { replace: true })
      return
    }

    const data: ResetResponse = await res.json().catch(() => ({}))
    error.set(data.message || 'Could not save that password.')
  }
  catch {
    error.set('Could not reach the server.')
  }
  finally {
    loading.set(false)
  }
}
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    <main class="grid place-items-center px-6 py-16 min-h-[100dvh]">
      <div class="max-w-sm w-full">
        <StxLink to="/" class="flex gap-2 items-center mb-8 no-underline">
          <i class="h-5 w-5 text-accent i-hugeicons-chart-histogram"></i>
          <span class="font-semibold text-ink tracking-tight">ReportsHQ</span>
        </StxLink>

        <h1 class="font-semibold text-2xl tracking-tight">Choose a new password</h1>
        @if (usable)
          <p class="mb-6 mt-1 text-muted text-sm">For {{ email }}. Signing in elsewhere ends when you save this.</p>
        @else
          <p class="mb-6 mt-1 text-sm text-warn">This link is missing part of itself. Ask for a new one.</p>
        @endif

        {{-- A real form, so a password manager recognises it and the enter key
             submits. The script intercepts it; without the script it still
             posts somewhere sensible rather than nowhere. --}}
        <form method="post" action="/api/auth/reset" @submit="handleSubmit" @if (!usable) hidden @endif>
          {{-- The grid lives here, not on the form: `hidden` is only
               [hidden]{display:none} in the UA sheet, so a display utility
               on the form itself outranks it -- which is why a link with no
               token used to say so and then show the password field anyway.
               login.stx is built this way for the same reason. --}}
          <div class="grid gap-4">
            <input id="token" name="token" type="hidden" value="{{ __resetToken }}" />
            <input id="email" name="email" type="hidden" value="{{ email }}" />

            <label class="block">
              <span class="block mb-1 text-muted text-sm">New password</span>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
                  :aria-invalid="error() ? 'true' : 'false'"
                  :aria-describedby="error() ? 'error' : ''"
              />
            </label>

            <p class="-mt-2 text-subtle text-xs">At least 10 characters. Length beats punctuation.</p>

            @if (error())
              <p id="error" class="text-sm text-warn" role="alert">{{ error() }}</p>
            @endif

            <button
              type="submit"
              :disabled="loading()"
              :aria-busy="loading()"
              class="px-4 py-2.5 font-medium text-accent-ink text-sm bg-accent rounded-lg disabled:opacity-60"
            >{{ loading() ? 'Saving' : 'Save it' }}</button>
          </div>
        </form>

        <p class="mt-6 text-muted text-sm">
          <StxLink to="/forgot" class="text-accent">Ask for a new link</StxLink>
        </p>
      </div>
    </main>
  </div>

</template>
