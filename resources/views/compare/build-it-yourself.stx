const sections = [
  {
    "heading": "Building it is genuinely reasonable",
    "body": "A handful of queries, a chart library, a Blade view. Two days of work and you own it entirely, with no licence and nobody else's opinions in your codebase. For three fixed charts that never change, this is very likely the right answer."
  },
  {
    "heading": "What it costs later",
    "body": "The fourth chart wants a comparison range. The fifth wants a different grain. Somebody asks for CSV, then for a link they can send to a client who has no login, then for it in their inbox every Monday. None of those is hard, and all of them are work you did not plan for, arriving one at a time."
  },
  {
    "heading": "The part that bites",
    "body": "Getting a number wrong quietly. A revenue-per-product chart that joins line items counts an order once per line, and the total is a plausible number nobody questions until it is in a board pack. Knowing which questions cannot be answered honestly is most of what this package is."
  },
  {
    "heading": "What you get instead",
    "body": "The grid, the drag behaviour, the exports, the share links, the schedules, and a compiler that refuses a query rather than answering it wrongly. Written once, tested, and not your problem on a Friday."
  },
  {
    "heading": "When to build it yourself anyway",
    "body": "If the reports are few, fixed, and unlikely to be asked about. That is a real situation and this page is not going to pretend otherwise."
  }
