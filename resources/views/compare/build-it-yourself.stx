const compareWith = "Building it yourself"

/*
 * The comparison, row by row.
 *
 * Written so a reader can find the row they came for and stop. Where the other
 * tool is better, the row says so: a comparison page that never concedes a
 * point is an advert, and readers can tell.
 */
const compare = [
