const page = pageFor('compare', 'google-analytics')!
const canonical = 'https://reportshq.org/compare/google-analytics'

useSeoMeta({
  title: metaTitleFor(page.title),
  description: page.description,
  canonical,
  ogUrl: canonical,
  ogTitle: page.title,
  ogDescription: page.description,
  ogType: 'article',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-3xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Comparisons', href: '/compare' },
  { label: page.title },
]

const sections = [
  {
    "heading": "They measure different things",
    "body": "Google Analytics measures traffic: sessions, sources, pages, campaigns. ReportsHQ measures things that happened inside your application: an order was created, a plan was upgraded, a refund was issued. If your question starts with where did people come from, GA is the right tool and this is not."
  },
  {
    "heading": "Server-side events see what a page tracker cannot",
    "body": "Events are sent from your application rather than from a script in the browser, so an order placed by a customer whose ad blocker ate the tracker still counts, as does one placed over the phone by your support team. It also means there is nothing to consent to on behalf of a visitor, because there is no visitor being tracked."
  },
  {
    "heading": "Where Google Analytics wins",
    "body": "Acquisition, attribution, channel mix, and the entire question of which campaign paid for itself. GA has years of work in it that this does not attempt, and it is free. Anyone telling you a small events product replaces it is selling something."
  },
  {
    "heading": "Where this wins",
    "body": "Revenue that matches your database, because it comes from the same events your application already fires. Reports that build themselves for the standard taxonomy. A share link somebody outside the company can open without an account."
  }
]
</script>

