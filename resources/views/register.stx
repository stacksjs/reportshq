<script server>
// Creating an account.
//
// Renders for a stranger, like /login, and bounces anyone who already has a
// session. The only account this creates is the person's own; teammates arrive
// through project invites instead, which is why there is no organisation step
// here.
import { sessionFrom } from '~/app/Support/session'

const session = await sessionFrom(typeof cookies !== 'undefined' ? cookies : undefined)
const signedIn = session.user !== null
</script>

<script client>
// Submitting the form, as stx client code rather than the DOM-walking script
// this used to be (stx-standards rule 8). The same conversion as login.stx,
// which carries the longer note on why each replacement is the one it is; this
// page is the simpler half of it -- one form, no second step.
//
// It replaced a bare script holding `signin`, `error` and `submit` by id,
// reading three more fields by id on every submit, and writing the banner, the
// three `aria-invalid` attributes, the button label and `disabled` by hand.
// `error` and `loading` own all of that now.
//
// The form keeps `method` and `action`, and is not wrapped in `@if`, for the
// reason spelled out in login.stx: a client `@if` compiles to an attribute plus
// x-cloak, and `[x-cloak]{display:none !important}` would leave a stranger
// looking at an empty page if the runtime never arrived. A page that must
// render for somebody with no account has to survive that.
const error = state('')
const loading = state(false)

/** What /api/auth/register answers with. */
interface RegisterResponse {
  message?: string
}

// `e.target` is an EventTarget and `form.elements` hands back Elements, so
// reading a field is two narrowings. A field the markup does not contain reads
// as empty rather than throwing -- the endpoint validates what it is sent.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

async function handleSubmit(event: SubmitEvent): Promise<void> {
  event.preventDefault()
  if (loading())
    return
  const form = event.target
  if (!(form instanceof HTMLFormElement))
    return

  loading.set(true)
  error.set('')

  try {
    const res = await fetch('/api/auth/register', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name: fieldValue(form, 'name'),
        email: fieldValue(form, 'email'),
        password: fieldValue(form, 'password'),
      }),
    })

    if (res.ok) {
      // replace, not assign: the back button should not return to a form the
      // person has already used. navigate(url, options) reads opts.replace and
      // calls location.replace, so this is the old behaviour, not an
      // approximation of it.
      navigate('/reports', { replace: true })
      return
    }

    const data: RegisterResponse = await res.json().catch(() => ({}))
    error.set(data.message || 'Could not create that account.')
  }
  catch {
    error.set('Could not reach the server.')
  }
  finally {
    loading.set(false)
  }
}
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    {{-- Already signed in: bounce before anything paints, the same way the
         guard does in the other direction. --}}
    @if (signedIn)
      <script>
        // A pre-paint bounce. navigate() is not in scope here: a plain <script> gets no
        // auto-imports, and the redirect has to beat first paint, which is the point.
        // stx-strict-ignore-next-line window.location location.replace()
        window.location.replace('/reports')
      </script>
    @endif

    <main class="grid place-items-center px-6 py-16 min-h-[100dvh]">
      <div class="max-w-sm w-full">
        <StxLink to="/" class="flex gap-2 items-center mb-8 no-underline">
          <i class="h-5 w-5 text-accent i-hugeicons-chart-histogram"></i>
          <span class="font-semibold text-ink tracking-tight">ReportsHQ</span>
        </StxLink>

        <h1 class="font-semibold text-2xl tracking-tight">Create an account</h1>
        <p class="mb-6 mt-1 text-muted text-sm">A licence key, and reports that run inside your own application.</p>

        {{-- A real form, so a password manager recognises it and the enter key
             submits. The script intercepts it; without the script it still
             posts somewhere sensible rather than nowhere. --}}
        <form method="post" action="/api/auth/register" class="grid gap-4" @submit="handleSubmit">
          <label class="block">
            <span class="block mb-1 text-muted text-sm">Name</span>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
              :aria-invalid="error() ? 'true' : 'false'"
              :aria-describedby="error() ? 'error' : ''"
            />
          </label>

          <label class="block">
            <span class="block mb-1 text-muted text-sm">Email</span>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="username"
              required
              class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
              :aria-invalid="error() ? 'true' : 'false'"
              :aria-describedby="error() ? 'error' : ''"
            />
          </label>

          <label class="block">
            <span class="block mb-1 text-muted text-sm">Password</span>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="new-password"
              required
              class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
              :aria-invalid="error() ? 'true' : 'false'"
              :aria-describedby="error() ? 'error' : ''"
            />
          </label>

          {{-- Stated up front rather than as a rejection after the fact. --}}
          <p class="-mt-2 text-subtle text-xs">At least 10 characters. Length beats punctuation.</p>

          @if (error())
            <p id="error" class="text-sm text-warn" role="alert">{{ error() }}</p>
          @endif

          <button
            type="submit"
            :disabled="loading()"
            class="px-4 py-2.5 font-medium text-accent-ink text-sm bg-accent rounded-lg disabled:opacity-60"
          >{{ loading() ? 'Creating' : 'Create account' }}</button>
        </form>

        <p class="mt-6 text-muted text-sm">
          Already have an account?
          <StxLink to="/login" class="text-accent">Sign in</StxLink>
        </p>
      </div>
    </main>
  </div>

</template>
