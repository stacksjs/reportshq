<script server>
// The builder.
//
// The grid is rendered on the server from the stored blocks, so the report is
// correct before any JavaScript arrives; the client adds dragging, resizing and
// selection on top of markup that already reads properly. That ordering is the
// point: a builder whose blocks only appear after hydration shows an empty grid
// to anyone on a slow connection, which is exactly when they are least patient.
import { eventNamesFor, propertyKeysFor } from '../../app/Events/query'
import { eventLabel, fieldLabel, GRAIN_LABELS, MEASURE_LABELS, OPERATOR_LABELS } from '../../app/Events/taxonomy'
import { runQuery } from '../../app/Reports/engine'
import { blocksOf, reportBySlug } from '../../app/Reports/reports'
import { GRID_COLUMNS } from '../../app/Reports/schema'
import { accessFor } from '../../app/Support/access'
import { param, sessionCookieName, sessionFrom } from '../../app/Support/session'

const session = await sessionFrom(cookies)
const cookieName = sessionCookieName()
const user = session.user
const authPending = session.stale

const projectId = Number(param(query, 'project') ?? 0)
const slug = param(query, 'slug') ?? ''

const access = user && projectId ? await accessFor(user, projectId) : null
const report = access && slug ? await reportBySlug(projectId, slug) : null
const found = report !== null

const timezone = String(report?.timezone ?? 'UTC')
const blocks = found ? await blocksOf(Number(report!.id)) : []

// Previews use the report's own default range. The builder is for arranging and
// configuring; reading a specific window is what the viewer is for, and adding
// a range picker here would be a second place to change the same thing.
const rendered: Array<Record<string, unknown>> = []
for (const block of blocks) {
  const kind = String(block.kind)
  const entry = {
    id: Number(block.id),
    kind,
    // The panel populates from this rather than fetching the block again: it is
    // already on the page, and a round trip on every selection makes clicking
    // through a report feel like using a website from 2004.
    config: JSON.stringify(block.query ?? {}),
    title: block.title ? String(block.title) : '',
    body: block.body ? String(block.body) : '',
    x: Number(block.x) || 0,
    y: Number(block.y) || 0,
    w: Math.max(1, Math.min(GRID_COLUMNS, Number(block.w) || 6)),
    h: Math.max(1, Number(block.h) || 4),
    result: null as unknown,
    error: '',
  }

  if (kind !== 'text') {
    try {
      entry.result = await runQuery({
        projectId,
        timezone,
        range: String(report!.default_range ?? 'last_30_days'),
        query: block.query as never,
      })
    }
    catch (error) {
      entry.error = (error as Error).message
    }
  }

  rendered.push(entry)
}

// What the config panel offers to choose from. Read from the project rather
// than hardcoded: the events and property keys a customer actually sends are
// the only ones worth offering, and typing `properties.plan` from memory is how
// somebody groups by a key that does not exist and gets one silent bucket.
const eventOptions = found
  ? (await eventNamesFor(projectId, 60)).map(entry => ({ name: entry.name, label: eventLabel(entry.name), count: entry.count }))
  : []

const propertyOptions = found
  ? (await propertyKeysFor(projectId)).map(entry => ({ field: `properties.${entry.key}`, label: entry.key }))
  : []

const measureOptions = Object.entries(MEASURE_LABELS).map(([value, label]) => ({ value, label }))
const grainOptions = Object.entries(GRAIN_LABELS).map(([value, label]) => ({ value, label }))
const operatorOptions = Object.entries(OPERATOR_LABELS).map(([value, label]) => ({ value, label }))

// Filterable and groupable fields: the allowlisted columns, plus whatever
// property keys have arrived.
const fieldOptions = [
  ...['name', 'user_key', 'session_key', 'value', 'currency'].map(field => ({ field, label: fieldLabel(field) })),
  ...propertyOptions,
]

// Numeric fields only, for the measures that need something to add up. Offering
// `name` to a sum is offering a guaranteed zero.
const numericFieldOptions = [
  { field: 'value', label: 'Value' },
  ...propertyOptions,
]

/** The palette, in the order someone reaches for them. */
const kinds = [
  { kind: 'big_number', label: 'Big number', w: 3, h: 3, icon: 'i-hugeicons-chart-average' },
  { kind: 'line', label: 'Line', w: 6, h: 4, icon: 'i-hugeicons-chart-line-data-01' },
  { kind: 'area', label: 'Area', w: 6, h: 4, icon: 'i-hugeicons-chart-histogram' },
  { kind: 'bar', label: 'Bar', w: 6, h: 4, icon: 'i-hugeicons-chart-bar-line' },
  { kind: 'donut', label: 'Donut', w: 4, h: 4, icon: 'i-hugeicons-pie-chart' },
  { kind: 'table', label: 'Table', w: 4, h: 4, icon: 'i-hugeicons-table' },
  { kind: 'funnel', label: 'Funnel', w: 6, h: 4, icon: 'i-hugeicons-filter' },
  { kind: 'heatmap', label: 'Heatmap', w: 12, h: 3, icon: 'i-hugeicons-grid' },
  { kind: 'text', label: 'Note', w: 12, h: 1, icon: 'i-hugeicons-text' },
]

// Handed to the script as JSON strings and parsed there. stx encodes an
// interpolation in a script block as a JS literal, so a string round-trips
// predictably where an object's encoding would be an assumption.
const fieldChoicesJson = JSON.stringify(fieldOptions)
const operatorChoicesJson = JSON.stringify(operatorOptions)

const isPublished = String(report?.status ?? 'draft') === 'published'

// Whether viewers are currently behind the draft. Rendered on the server so the
// state is right on first paint rather than after the first save.
const hasUnpublished = Boolean(report?.unpublished_changes)
const viewHref = `/report?project=${projectId}&slug=${slug}`
</script>

<template>
  {{-- The guard is a plain script and cannot import; the name it must
       check is stamped here, from the same resolver the middleware uses.

       No quotes around the interpolation. stx JSON-encodes `{{ }}` inside a
       script block, so the value arrives already quoted; wrapping it again
       produced a cookie name containing literal quote characters, the guard
       looked for a cookie nobody had, and every signed-in visitor was bounced
       to /login. curl never caught it because curl does not run scripts. --}}
  <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>
  @include('AuthGuard')

  <div class="min-h-[100dvh] bg-canvas text-ink">
    @if (authPending)
      <div id="auth-pending" hidden></div>
    @endif

    @include('AppNav')

    <main class="px-6 py-8 mx-auto max-w-7xl">
      @if (!found)
        <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
          <h1 class="text-base font-medium">Report not found</h1>
          <a href="/projects" class="inline-block mt-5 text-sm text-accent">Back to projects</a>
        </div>
      @else
        <div class="flex flex-wrap gap-4 justify-between items-end mb-6">
          <div>
            <nav class="mb-2 text-sm text-subtle">
              <a href="/project?id={{ projectId }}" class="text-muted">Project</a>
              <span class="mx-2">/</span>
              <a href="{{ viewHref }}" class="text-muted">{{ report.name }}</a>
              <span class="mx-2">/</span>
              <span>Edit</span>
            </nav>
            <h1 class="text-2xl font-semibold tracking-tight">{{ report.name }}</h1>
          </div>

          <div class="flex gap-2 items-center">
            {{-- The save state is a word, not a spinner. "Saved" is the thing a
                 person needs to know before closing a tab. --}}
            <span id="save-state" class="text-sm text-subtle" aria-live="polite">Saved</span>

            {{-- Saved and published are different promises, so they get
                 different words. Work is safe as soon as it is saved; nobody
                 else sees it until it is published, and conflating the two is
                 how somebody spends a week sure their team was looking at a
                 dashboard nobody could see. --}}
            <span
              id="publish-state"
              class="text-sm text-warn"
              aria-live="polite"
              @if (!hasUnpublished) hidden @endif
            >Not published</span>
            <div class="flex overflow-hidden rounded-lg border border-line">
              <button
                id="undo"
                type="button"
                class="px-2.5 py-2 text-sm text-ink disabled:opacity-40 disabled:cursor-not-allowed"
                title="Undo (Cmd+Z)"
                aria-label="Undo"
                disabled
              ><i class="block w-4 h-4 i-hugeicons-arrow-turn-backward"></i></button>
              <button
                id="redo"
                type="button"
                class="px-2.5 py-2 text-sm border-l border-line text-ink disabled:opacity-40 disabled:cursor-not-allowed"
                title="Redo (Shift+Cmd+Z)"
                aria-label="Redo"
                disabled
              ><i class="block w-4 h-4 i-hugeicons-arrow-turn-forward"></i></button>
            </div>

            <a href="{{ viewHref }}" class="px-3 py-2 text-sm no-underline rounded-lg border border-line text-ink">View</a>
            <button id="publish" type="button" class="px-4 py-2 text-sm font-medium rounded-lg bg-accent text-accent-ink">
              @if (isPublished) Republish @else Publish @endif
            </button>
          </div>
        </div>

        {{-- Three columns once a block is selected. The panel is a column
             rather than an overlay: it is edited while watching the block it
             changes, and a drawer covering the grid would hide the one thing
             the person is looking at. --}}
        <div id="workspace" class="grid gap-6 lg:grid-cols-[200px_1fr]">
          <aside>
            <h2 class="mb-2 text-xs font-medium tracking-wide uppercase text-subtle">Add a block</h2>
            <ul class="grid grid-cols-2 gap-2 list-none lg:grid-cols-1">
              @foreach (kinds as entry)
                <li>
                  <button
                    type="button"
                    class="flex gap-2 items-center px-3 py-2 w-full text-sm text-left rounded-lg border transition-colors add-block border-line bg-panel text-ink hover:border-accent"
                    data-kind="{{ entry.kind }}"
                    data-w="{{ entry.w }}"
                    data-h="{{ entry.h }}"
                  >
                    <i class="w-4 h-4 {{ entry.icon }} text-subtle"></i>
                    {{ entry.label }}
                  </button>
                </li>
              @endforeach
            </ul>

            <p class="mt-4 text-xs leading-relaxed text-subtle">
              Drag a block to move it, drag its bottom right corner to resize. Arrow keys move the
              selected block, Delete removes it, and Cmd+Z takes back the last change.
            </p>
          </aside>

          <section>
            @if (rendered.length === 0)
              <div class="px-6 py-20 text-center rounded-xl border border-dashed border-line">
                <h2 class="text-base font-medium">An empty grid</h2>
                <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
                  Add a block from the left. Every block reads the events already in this project, so
                  it will show real numbers as soon as it lands.
                </p>
              </div>
            @else
              {{-- 12 columns, matching the stored layout exactly, so what is
                   dragged here is what the viewer renders. --}}
              <div id="grid" class="grid grid-cols-12 gap-3 auto-rows-[56px]">
                @foreach (rendered as block)
                  <article
                    class="block-tile relative rounded-xl border border-line bg-panel p-4 col-start-[{{ block.x + 1 }}] col-span-{{ block.w }} row-span-{{ block.h }}"
                    data-id="{{ block.id }}"
                    data-kind="{{ block.kind }}"
                    data-title="{{ block.title }}"
                    data-body="{{ block.body }}"
                    data-query="{{ block.config }}"
                    data-x="{{ block.x }}"
                    data-y="{{ block.y }}"
                    data-w="{{ block.w }}"
                    data-h="{{ block.h }}"
                    tabindex="0"
                    role="group"
                    aria-label="{{ block.title }} block, column {{ block.x }}, row {{ block.y }}"
                  >
                    <div class="overflow-hidden h-full pointer-events-none">
                      @if (block.error)
                        <p class="text-sm font-medium text-ink">{{ block.title }}</p>
                        <p class="mt-2 text-sm text-warn">{{ block.error }}</p>
                      @elseif (block.kind === 'text')
                        <TextBlock title="{{ block.title }}" body="{{ block.body }}" />
                      @elseif (block.kind === 'big_number')
                        <BigNumber :result="block.result" title="{{ block.title }}" />
                      @elseif (block.kind === 'bar')
                        <BarChart :result="block.result" title="{{ block.title }}" />
                      @elseif (block.kind === 'donut')
                        <DonutChart :result="block.result" title="{{ block.title }}" />
                      @elseif (block.kind === 'table')
                        <DataTable :result="block.result" title="{{ block.title }}" />
                      @elseif (block.kind === 'funnel')
                        <FunnelChart :result="block.result" title="{{ block.title }}" />
                      @elseif (block.kind === 'heatmap')
                        <HeatmapChart :result="block.result" title="{{ block.title }}" />
                      @elseif (block.kind === 'area')
                        <LineChart :result="block.result" title="{{ block.title }}" variant="area" />
                      @else
                        <LineChart :result="block.result" title="{{ block.title }}" />
                      @endif
                    </div>

                    {{-- A real handle rather than a hover-anywhere resize: the
                         corner is where people already expect it, and it keeps
                         the whole tile free for dragging. --}}
                    <span class="resize-handle" aria-hidden="true"></span>
                  </article>
                @endforeach
              </div>
            @endif
          </section>

          {{-- The config panel. Server-rendered empty and filled in on
               selection, so the option lists are already here and choosing a
               block does not wait on a request. --}}
          <aside id="config" class="hidden" aria-label="Block settings">
            <div class="sticky top-6 p-4 rounded-xl border border-line bg-panel">
              <div class="flex justify-between items-start mb-4">
                <h2 class="text-sm font-medium">Block</h2>
                <button id="cfg-close" type="button" class="text-subtle hover:text-ink" aria-label="Close settings">
                  <i class="block w-4 h-4 i-hugeicons-cancel-01"></i>
                </button>
              </div>

              <label class="block mb-3">
                <span class="block mb-1 text-xs text-subtle">Title</span>
                <input id="cfg-title" type="text" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink" />
              </label>

              <div id="cfg-query">
                <label class="block mb-3">
                  <span class="block mb-1 text-xs text-subtle">Events</span>
                  {{-- A multi-select rather than a tag editor: it is one
                       control, it is keyboard-navigable for free, and nothing
                       selected honestly means every event. --}}
                  <select id="cfg-events" multiple size="5" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                    @foreach (eventOptions as option)
                      <option value="{{ option.name }}">{{ option.label }}</option>
                    @endforeach
                  </select>
                  <span class="block mt-1 text-xs text-subtle">Nothing selected counts every event.</span>
                </label>

                <label class="block mb-3">
                  <span class="block mb-1 text-xs text-subtle">Measure</span>
                  <select id="cfg-measure" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                    @foreach (measureOptions as option)
                      <option value="{{ option.value }}">{{ option.label }}</option>
                    @endforeach
                  </select>
                </label>

                <label id="cfg-field-row" class="block mb-3">
                  <span class="block mb-1 text-xs text-subtle">Field</span>
                  <select id="cfg-field" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                    @foreach (numericFieldOptions as option)
                      <option value="{{ option.field }}">{{ option.label }}</option>
                    @endforeach
                  </select>
                </label>

                <label class="block mb-3">
                  <span class="block mb-1 text-xs text-subtle">Group by</span>
                  <select id="cfg-dimension" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                    <option value="">Nothing</option>
                    @foreach (fieldOptions as option)
                      <option value="{{ option.field }}">{{ option.label }}</option>
                    @endforeach
                  </select>
                </label>

                <label id="cfg-grain-row" class="block mb-3">
                  <span class="block mb-1 text-xs text-subtle">Over time</span>
                  <select id="cfg-grain" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                    @foreach (grainOptions as option)
                      <option value="{{ option.value }}">{{ option.label }}</option>
                    @endforeach
                  </select>
                </label>

                <label class="flex gap-2 items-center mb-4 text-sm">
                  <input id="cfg-compare" type="checkbox" class="rounded border-line" />
                  <span>Compare with the previous period</span>
                </label>

                <div class="mb-3">
                  <span class="block mb-1 text-xs text-subtle">Filters</span>
                  <div id="cfg-filters" class="grid gap-2"></div>
                  <button id="cfg-add-filter" type="button" class="mt-2 text-xs text-accent">Add a filter</button>
                </div>
              </div>

              <label id="cfg-body-row" class="block mb-3">
                <span class="block mb-1 text-xs text-subtle">Text</span>
                <textarea id="cfg-body" rows="4" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink"></textarea>
              </label>

              {{-- Errors land here and in the block itself. A message only in a
                   toast is gone by the time somebody looks up from the field
                   that caused it. --}}
              <p id="cfg-error" class="mt-3 text-sm text-warn" hidden></p>

              <button id="cfg-remove" type="button" class="mt-4 text-xs text-neg">Remove this block</button>
            </div>
          </aside>
        </div>
      @endif
    </main>
  </div>

{{-- Dragging, resizing, selection and saving.

     A plain script rather than a client block, and deliberately so. The design
     rules ban driving continuous values through signal state re-read every
     frame, which is exactly what a pointer-driven drag is; and this needs
     pointer capture and live grid measurement, neither of which a composable
     wraps. So it uses pointer events directly, writes CSS custom properties
     rather than reactive state during a drag, and touches the DOM only inside
     this one file. The same exemption AuthGuard takes, for the same kind of
     reason.

     Pointer events rather than mouse events: the same code then works with a
     finger and a stylus, and pointer capture means a fast drag that leaves the
     tile does not drop the gesture. --}}
<script>
(function () {
  var grid = document.getElementById('grid')
  if (!grid) return

  var params = new URLSearchParams(window.location.search)
  var project = params.get('project')
  var slug = params.get('slug')
  var state = document.getElementById('save-state')
  var publishState = document.getElementById('publish-state')
  var COLUMNS = 12
  var ROW = 56
  var GAP = 12
  var FIELD_CHOICES = JSON.parse({{ fieldChoicesJson }})
  var OPERATOR_CHOICES = JSON.parse({{ operatorChoicesJson }})

  var selected = null
  var pending = null
  var lastMoved = null

  // Undo history. In memory and bounded: the point is to take back the last few
  // things you did in this session, and a stack that grows all afternoon is a
  // memory leak pretending to be a feature. Deeper history already exists as
  // revisions on the server.
  var HISTORY = 50
  var past = []
  var future = []

  function snapshot() {
    return tiles().map(function (tile) {
      return {
        id: Number(tile.dataset.id),
        x: Number(tile.dataset.x),
        y: Number(tile.dataset.y),
        w: Number(tile.dataset.w),
        h: Number(tile.dataset.h),
      }
    })
  }

  function sameLayout(a, b) {
    if (!a || !b || a.length !== b.length) return false
    for (var i = 0; i < a.length; i++) {
      if (a[i].id !== b[i].id || a[i].x !== b[i].x || a[i].y !== b[i].y || a[i].w !== b[i].w || a[i].h !== b[i].h) return false
    }
    return true
  }

  // Recorded before a change, not after, so undo restores what was on screen
  // when you started rather than what you ended up with.
  function remember(state) {
    var now = state || snapshot()
    if (sameLayout(past[past.length - 1], now)) return
    past.push(now)
    if (past.length > HISTORY) past.shift()
    // A new edit invalidates anything that was undone: there is no coherent
    // "redo" for a branch that was abandoned.
    future = []
    refreshHistoryButtons()
  }

  function say(text) {
    if (state) state.textContent = text
  }

  // One removal path for the keyboard and the panel button. A reload rather
  // than an optimistic splice: removing a block re-packs the grid on the
  // server, and the server already knows how to draw the result.
  function removeBlock(id) {
    say('Removing')
    fetch('/api/reports/blocks/remove', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ project: project, slug: slug, id: id }),
    }).then(function (res) {
      if (res.ok) window.location.reload()
      else say('Could not remove that')
    }).catch(function () { say('Could not remove that') })
  }

  // Every successful write moves the draft ahead of what viewers see, and the
  // page has to say so without waiting for a reload.
  function drafted(ahead) {
    if (publishState) publishState.hidden = !ahead
  }

  function tiles() {
    return Array.prototype.slice.call(grid.querySelectorAll('.block-tile'))
  }

  function place(tile, x, y, w, h) {
    tile.dataset.x = String(x)
    tile.dataset.y = String(y)
    tile.dataset.w = String(w)
    tile.dataset.h = String(h)
    tile.style.gridColumnStart = String(x + 1)
    tile.style.gridColumnEnd = 'span ' + w
    tile.style.gridRowStart = String(y + 1)
    tile.style.gridRowEnd = 'span ' + h
    tile.setAttribute('aria-label', (tile.getAttribute('aria-label') || '').replace(/column \d+, row \d+/, 'column ' + x + ', row ' + y))
  }

  // Read the stored layout back onto the grid, so the server's ordering and the
  // client's agree from the first frame rather than after the first drag.
  tiles().forEach(function (tile) {
    place(tile, Number(tile.dataset.x), Number(tile.dataset.y), Number(tile.dataset.w), Number(tile.dataset.h))
  })

  function cellWidth() {
    return (grid.clientWidth - GAP * (COLUMNS - 1)) / COLUMNS
  }

  function hits(a, b) {
    return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h
  }

  // The same push-down the server runs, so the grid moves under your hand
  // instead of jumping when the response lands. The server's answer still wins:
  // this is the preview, /blocks/save returns the layout that was stored, and
  // adopt() below applies it. See app/Reports/layout.ts for why it only ever
  // pushes down and never pulls up.
  function pack(held) {
    var boxes = tiles().map(function (tile) {
      return {
        tile: tile,
        id: Number(tile.dataset.id),
        x: Number(tile.dataset.x),
        y: Number(tile.dataset.y),
        w: Number(tile.dataset.w),
        h: Number(tile.dataset.h),
      }
    })

    boxes.sort(function (a, b) {
      if (a.id === held) return -1
      if (b.id === held) return 1
      if (a.y !== b.y) return a.y - b.y
      if (a.x !== b.x) return a.x - b.x
      return a.id - b.id
    })

    var settled = []
    boxes.forEach(function (box) {
      while (settled.some(function (other) { return hits(box, other) })) box.y += 1
      settled.push(box)
      place(box.tile, box.x, box.y, box.w, box.h)
    })
  }

  // The server's layout, applied verbatim. Two implementations of the same
  // rule will eventually disagree, and when they do, the stored one is the one
  // that matters.
  function adopt(layout) {
    if (!layout || !layout.length) return

    var byId = {}
    tiles().forEach(function (tile) { byId[tile.dataset.id] = tile })

    layout.forEach(function (block) {
      var tile = byId[String(block.id)]
      if (tile) place(tile, block.x, block.y, block.w, block.h)
    })
  }

  function apply(layout) {
    adopt(layout)
    save()
  }

  function undo() {
    if (!past.length) return
    future.push(snapshot())
    apply(past.pop())
    refreshHistoryButtons()
    say('Undone')
  }

  function redo() {
    if (!future.length) return
    past.push(snapshot())
    apply(future.pop())
    refreshHistoryButtons()
    say('Redone')
  }

  function refreshHistoryButtons() {
    var undoButton = document.getElementById('undo')
    var redoButton = document.getElementById('redo')
    // Disabled rather than hidden: a control that vanishes moves everything
    // beside it, and the two of them sit next to Publish.
    if (undoButton) undoButton.disabled = past.length === 0
    if (redoButton) redoButton.disabled = future.length === 0
  }

  function save() {
    // Debounced: a drag ends in one commit, and dropping three blocks in quick
    // succession should be one request rather than three racing ones.
    if (pending) clearTimeout(pending)
    say('Saving')
    pending = setTimeout(function () {
      var blocks = tiles().map(function (tile) {
        return {
          id: Number(tile.dataset.id),
          layout: {
            x: Number(tile.dataset.x),
            y: Number(tile.dataset.y),
            w: Number(tile.dataset.w),
            h: Number(tile.dataset.h),
          },
        }
      })

      fetch('/api/reports/blocks/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project: project, slug: slug, blocks: blocks, moved: lastMoved }),
      }).then(function (res) {
        say(res.ok ? 'Saved' : 'Not saved')
        if (!res.ok) return
        drafted(true)
        // The server settles the layout on write, so what it returns can differ
        // from what was sent. Adopting it is what keeps the screen and the
        // database from quietly disagreeing.
        return res.json().then(function (data) { adopt(data && data.layout) }).catch(function () {})
      }).catch(function () {
        // Says so rather than pretending. A builder that reports "Saved" when
        // the request failed is how a session's work disappears silently.
        say('Not saved')
      })
    }, 400)
  }

  function select(tile) {
    tiles().forEach(function (other) { other.classList.remove('is-selected') })
    if (tile) tile.classList.add('is-selected')
    selected = tile

    // Selecting a block opens its settings. Making that a second, separate
    // gesture means most people never find them.
    if (tile) fillPanel(tile)
    else showPanel(false)
  }

  grid.addEventListener('pointerdown', function (event) {
    var tile = event.target.closest ? event.target.closest('.block-tile') : null
    if (!tile) return

    select(tile)
    lastMoved = Number(tile.dataset.id)

    // Captured, not yet recorded. A click is a drag of zero distance, and
    // recording one would arm undo and mark the report as having unpublished
    // changes for the crime of selecting a block to look at it.
    var before = snapshot()

    // The layout as it was when the drag began. Every frame re-packs from this
    // rather than from the previous frame's result: packing the already-pushed
    // positions again pushes them again, so blocks drift further down the
    // longer you hold the pointer, and a drag out and back leaves everything
    // lower than it started.
    var baseline = {}
    tiles().forEach(function (other) {
      baseline[other.dataset.id] = {
        x: Number(other.dataset.x),
        y: Number(other.dataset.y),
        w: Number(other.dataset.w),
        h: Number(other.dataset.h),
      }
    })

    function rewind() {
      tiles().forEach(function (other) {
        if (Number(other.dataset.id) === lastMoved) return
        var was = baseline[other.dataset.id]
        if (was) place(other, was.x, was.y, was.w, was.h)
      })
    }

    var resizing = event.target.classList && event.target.classList.contains('resize-handle')
    var startX = event.clientX
    var startY = event.clientY
    var originX = Number(tile.dataset.x)
    var originY = Number(tile.dataset.y)
    var originW = Number(tile.dataset.w)
    var originH = Number(tile.dataset.h)
    var unit = cellWidth()

    tile.setPointerCapture(event.pointerId)
    tile.classList.add('is-dragging')
    grid.classList.add('is-arranging')

    function move(moveEvent) {
      var dx = Math.round((moveEvent.clientX - startX) / (unit + GAP))
      var dy = Math.round((moveEvent.clientY - startY) / (ROW + GAP))

      rewind()

      if (resizing) {
        var w = Math.max(1, Math.min(COLUMNS - originX, originW + dx))
        var h = Math.max(1, originH + dy)
        place(tile, originX, originY, w, h)
        pack(lastMoved)
      }
      else {
        // Clamped to the grid: a block that starts inside and ends outside is
        // the shape a drag produces at the right edge, and the server would
        // reject it, so it never gets that far.
        var x = Math.max(0, Math.min(COLUMNS - originW, originX + dx))
        var y = Math.max(0, originY + dy)
        place(tile, x, y, originW, originH)
        // Push the others out of the way as it moves, rather than at the drop.
        // Seeing where a block will land while still holding it is the whole
        // difference between arranging a grid and guessing at one.
        pack(lastMoved)
      }
    }

    function end() {
      tile.releasePointerCapture(event.pointerId)
      tile.classList.remove('is-dragging')
      grid.classList.remove('is-arranging')
      tile.removeEventListener('pointermove', move)
      tile.removeEventListener('pointerup', end)
      tile.removeEventListener('pointercancel', end)

      // Nothing moved, so nothing is written. Otherwise every click on a block
      // costs a request, a revision and a "Not published" badge.
      if (sameLayout(before, snapshot())) return

      remember(before)
      save()
    }

    tile.addEventListener('pointermove', move)
    tile.addEventListener('pointerup', end)
    tile.addEventListener('pointercancel', end)
  })

  // Keyboard equivalents, because a grid that can only be arranged by dragging
  // cannot be arranged at all by someone who does not use a mouse.
  document.addEventListener('keydown', function (event) {
    if (event.target && (event.target.tagName === 'INPUT' || event.target.tagName === 'TEXTAREA' || event.target.tagName === 'SELECT')) return

    // Undo and redo work whether or not a block is selected, because the thing
    // being undone may well be the deletion of the block that was.
    var accel = event.metaKey || event.ctrlKey
    if (accel && (event.key === 'z' || event.key === 'Z')) {
      event.preventDefault()
      if (event.shiftKey) redo()
      else undo()
      return
    }
    if (accel && (event.key === 'y' || event.key === 'Y')) {
      event.preventDefault()
      redo()
      return
    }

    if (!selected) return

    var x = Number(selected.dataset.x)
    var y = Number(selected.dataset.y)
    var w = Number(selected.dataset.w)
    var h = Number(selected.dataset.h)
    var handled = true

    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight' || event.key === 'ArrowUp' || event.key === 'ArrowDown') {
      remember(snapshot())
      lastMoved = Number(selected.dataset.id)
    }

    if (event.key === 'ArrowLeft') place(selected, Math.max(0, x - 1), y, w, h)
    else if (event.key === 'ArrowRight') place(selected, Math.min(COLUMNS - w, x + 1), y, w, h)
    else if (event.key === 'ArrowUp') place(selected, x, Math.max(0, y - 1), w, h)
    else if (event.key === 'ArrowDown') place(selected, x, y + 1, w, h)
    else if (event.key === 'Delete' || event.key === 'Backspace') {
      removeBlock(Number(selected.dataset.id))
      return
    }
    else handled = false

    if (handled) {
      event.preventDefault()
      pack(lastMoved)
      save()
    }
  })

  Array.prototype.forEach.call(document.querySelectorAll('.add-block'), function (button) {
    button.addEventListener('click', function () {
      say('Adding')
      fetch('/api/reports/blocks', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          project: project,
          slug: slug,
          kind: button.dataset.kind,
          w: Number(button.dataset.w),
          h: Number(button.dataset.h),
        }),
      }).then(function (res) {
        // A reload rather than an optimistic insert: the new block has to be
        // rendered by the engine anyway, and the server already knows how.
        if (res.ok) window.location.reload()
        else say('Could not add that')
      })
    })
  })


  // ---- Block settings -------------------------------------------------
  //
  // The panel edits one block's config and query. Saving goes through the same
  // /blocks/save endpoint as a drag, because a title and a position are both
  // just fields on a block, and a second write path is a second set of rules to
  // keep in step.
  //
  // The block redraws by asking the server for this page again and swapping in
  // the one tile. That is deliberate: charts are server-rendered SVG, and a
  // client-side redraw would mean a second implementation of every chart in
  // JavaScript, which is precisely how a builder ends up previewing something
  // the viewer will not render.

  var workspace = document.getElementById('workspace')
  var panel = document.getElementById('config')
  var cfgError = document.getElementById('cfg-error')
  var configPending = null
  var loading = false

  function el(id) { return document.getElementById(id) }

  function readQuery(tile) {
    try { return JSON.parse(tile.dataset.query || '{}') || {} }
    catch { return {} }
  }

  function showPanel(open) {
    if (!panel || !workspace) return
    panel.classList.toggle('hidden', !open)
    // The grid gains a third column only while the panel is open, so an
    // unselected report uses the full width for the report.
    workspace.style.gridTemplateColumns = open ? '' : ''
    workspace.classList.toggle('lg:grid-cols-[200px_1fr]', !open)
    workspace.classList.toggle('lg:grid-cols-[200px_1fr_300px]', open)
  }

  function fail(message) {
    if (cfgError) {
      cfgError.textContent = message || ''
      cfgError.hidden = !message
    }

    // Also on the block itself: the panel is on the right and the block being
    // broken is what the person is actually looking at.
    if (selected) selected.classList.toggle('is-broken', Boolean(message))
  }

  var FIELD_MEASURES = ['sum', 'avg', 'min', 'max']
  var TIME_KINDS = ['line', 'area', 'bar', 'heatmap']

  function syncPanelShape(kind) {
    var measure = el('cfg-measure') ? el('cfg-measure').value : 'count'
    var isText = kind === 'text'

    // Only the controls that mean something for this block. A grain picker on a
    // big number is a control that silently does nothing, which teaches people
    // the panel is lying.
    if (el('cfg-query')) el('cfg-query').hidden = isText
    if (el('cfg-body-row')) el('cfg-body-row').hidden = !isText
    if (el('cfg-field-row')) el('cfg-field-row').hidden = FIELD_MEASURES.indexOf(measure) === -1
    if (el('cfg-grain-row')) el('cfg-grain-row').hidden = TIME_KINDS.indexOf(kind) === -1
  }

  function filterRow(filter) {
    var row = document.createElement('div')
    row.className = 'cfg-filter grid grid-cols-[1fr_auto] gap-1'

    var field = document.createElement('select')
    field.className = 'cfg-filter-field px-2 py-1 text-xs rounded-lg border border-line bg-canvas text-ink'
    FIELD_CHOICES.forEach(function (choice) {
      var option = document.createElement('option')
      option.value = choice.field
      option.textContent = choice.label
      field.appendChild(option)
    })
    field.value = filter.field || 'name'

    var remove = document.createElement('button')
    remove.type = 'button'
    remove.className = 'px-1 text-xs text-subtle hover:text-neg'
    remove.setAttribute('aria-label', 'Remove filter')
    remove.textContent = '\u00d7'
    remove.addEventListener('click', function () {
      row.remove()
      commit()
    })

    var operator = document.createElement('select')
    operator.className = 'cfg-filter-operator px-2 py-1 text-xs rounded-lg border border-line bg-canvas text-ink'
    OPERATOR_CHOICES.forEach(function (choice) {
      var option = document.createElement('option')
      option.value = choice.value
      option.textContent = choice.label
      operator.appendChild(option)
    })
    operator.value = filter.operator || 'is'

    var value = document.createElement('input')
    value.type = 'text'
    value.className = 'cfg-filter-value px-2 py-1 text-xs rounded-lg border border-line bg-canvas text-ink'
    value.value = filter.value === undefined || filter.value === null ? '' : String(filter.value)

    function syncValue() {
      // `is present` and `is missing` take no value, so the input goes away
      // rather than sitting there being ignored.
      value.hidden = operator.value === 'exists' || operator.value === 'not_exists'
    }
    syncValue()
    operator.addEventListener('change', function () { syncValue(); commit() })
    field.addEventListener('change', commit)
    value.addEventListener('input', commit)

    row.appendChild(field)
    row.appendChild(remove)
    row.appendChild(operator)
    row.appendChild(value)

    return row
  }

  function readFilters() {
    return Array.prototype.slice.call(document.querySelectorAll('.cfg-filter')).map(function (row) {
      var operator = row.querySelector('.cfg-filter-operator').value
      var filter = {
        field: row.querySelector('.cfg-filter-field').value,
        operator: operator,
      }
      if (operator !== 'exists' && operator !== 'not_exists')
        filter.value = row.querySelector('.cfg-filter-value').value
      return filter
    })
  }

  function fillPanel(tile) {
    if (!panel) return

    var kind = tile.dataset.kind
    var query = readQuery(tile)

    el('cfg-title').value = tile.dataset.title || ''
    el('cfg-body').value = tile.dataset.body || ''

    var events = query.events || []
    Array.prototype.forEach.call(el('cfg-events').options, function (option) {
      option.selected = events.indexOf(option.value) !== -1
    })

    el('cfg-measure').value = query.measure || 'count'
    el('cfg-field').value = query.field || 'value'
    el('cfg-dimension').value = query.dimension || ''
    el('cfg-grain').value = query.grain || 'day'
    el('cfg-compare').checked = Boolean(query.compare)

    var filters = el('cfg-filters')
    filters.innerHTML = ''
    ;(query.filters || []).forEach(function (filter) { filters.appendChild(filterRow(filter)) })

    fail('')
    syncPanelShape(kind)
    showPanel(true)
  }

  function panelQuery(tile) {
    var events = Array.prototype.slice.call(el('cfg-events').selectedOptions).map(function (option) { return option.value })
    var measure = el('cfg-measure').value

    // Built on top of the stored query, not from nothing. The panel does not
    // render every field a block can carry - a funnel's steps and a donut's
    // series limit have no control here - and replacing the query wholesale
    // would delete them the first time somebody renamed the block.
    var query = readQuery(tile)

    query.events = events
    query.measure = measure
    query.filters = readFilters()

    if (FIELD_MEASURES.indexOf(measure) !== -1) query.field = el('cfg-field').value
    else delete query.field

    if (el('cfg-dimension').value) query.dimension = el('cfg-dimension').value
    else delete query.dimension

    if (!el('cfg-grain-row').hidden) query.grain = el('cfg-grain').value

    if (el('cfg-compare').checked) query.compare = true
    else delete query.compare

    return query
  }

  // Redraw one tile from the server's own rendering of this page.
  function refreshTile(id) {
    if (loading) return
    loading = true

    var tile = grid.querySelector('.block-tile[data-id="' + id + '"]')
    if (tile) tile.classList.add('is-loading')

    fetch(window.location.href, { credentials: 'same-origin' })
      .then(function (res) { return res.text() })
      .then(function (html) {
        var parsed = new DOMParser().parseFromString(html, 'text/html')
        var fresh = parsed.querySelector('.block-tile[data-id="' + id + '"]')
        var current = grid.querySelector('.block-tile[data-id="' + id + '"]')
        if (!fresh || !current) return

        current.innerHTML = fresh.innerHTML
        current.dataset.query = fresh.dataset.query
        current.dataset.title = fresh.dataset.title
      })
      .catch(function () { /* the tile keeps its previous drawing */ })
      .then(function () {
        loading = false
        var settled = grid.querySelector('.block-tile[data-id="' + id + '"]')
        if (settled) settled.classList.remove('is-loading')
      })
  }

  function commit() {
    if (!selected) return
    if (configPending) clearTimeout(configPending)

    // Debounced, because this fires on every keystroke in the title field and
    // each commit is a write plus a re-render.
    say('Saving')
    configPending = setTimeout(function () {
      var tile = selected
      var id = Number(tile.dataset.id)
      var kind = tile.dataset.kind
      var update = { id: id, title: el('cfg-title').value }

      if (kind === 'text') update.body = el('cfg-body').value
      else update.query = panelQuery(tile)

      fetch('/api/reports/blocks/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project: project, slug: slug, blocks: [update] }),
      }).then(function (res) {
        if (res.ok) {
          say('Saved')
          drafted(true)
          fail('')
          tile.dataset.title = update.title
          if (update.body !== undefined) tile.dataset.body = update.body
          refreshTile(id)
          return
        }

        say('Not saved')
        // The server's message names the part of the query it rejected, which
        // is the only thing that makes an invalid config fixable.
        return res.json().then(function (data) {
          fail((data && data.message) || 'That configuration was rejected.')
        }).catch(function () { fail('That configuration was rejected.') })
      }).catch(function () {
        say('Not saved')
        fail('Could not reach the server.')
      })
    }, 350)
  }

  if (panel) {
    ;['cfg-title', 'cfg-body', 'cfg-events', 'cfg-measure', 'cfg-field', 'cfg-dimension', 'cfg-grain', 'cfg-compare'].forEach(function (id) {
      var control = el(id)
      if (!control) return
      control.addEventListener('change', function () {
        if (id === 'cfg-measure') syncPanelShape(selected ? selected.dataset.kind : '')
        commit()
      })
      if (control.tagName === 'INPUT' || control.tagName === 'TEXTAREA')
        control.addEventListener('input', commit)
    })

    el('cfg-add-filter').addEventListener('click', function () {
      el('cfg-filters').appendChild(filterRow({ field: 'name', operator: 'is', value: '' }))
    })

    el('cfg-close').addEventListener('click', function () {
      select(null)
      showPanel(false)
    })

    el('cfg-remove').addEventListener('click', function () {
      if (!selected) return
      removeBlock(Number(selected.dataset.id))
    })
  }

  var undoButton = document.getElementById('undo')
  if (undoButton) undoButton.addEventListener('click', undo)

  var redoButton = document.getElementById('redo')
  if (redoButton) redoButton.addEventListener('click', redo)

  refreshHistoryButtons()

  var publish = document.getElementById('publish')
  if (publish) {
    publish.addEventListener('click', function () {
      say('Publishing')
      fetch('/api/reports/publish', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ project: project, slug: slug }),
      }).then(function (res) {
        say(res.ok ? 'Published' : 'Could not publish')
        if (res.ok) drafted(false)
      })
    })
  }
}())
</script>
</template>

<style>
.block-tile {
  cursor: grab;
  transition: box-shadow 0.12s ease, border-color 0.12s ease;
}

.block-tile:focus-visible,
.block-tile.is-selected {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft);
}

.block-tile.is-dragging {
  cursor: grabbing;
  opacity: 0.85;
  z-index: 20;
}

.resize-handle {
  position: absolute;
  right: 2px;
  bottom: 2px;
  width: 16px;
  height: 16px;
  cursor: nwse-resize;
  border-right: 2px solid var(--text-3);
  border-bottom: 2px solid var(--text-3);
  border-bottom-right-radius: 6px;
  opacity: 0;
  transition: opacity 0.12s ease;
}

.block-tile:hover .resize-handle,
.block-tile.is-selected .resize-handle {
  opacity: 0.6;
}

/* The drop target, drawn under the tile being moved so the destination is
 * visible while dragging rather than guessed. */
#grid.is-arranging .block-tile:not(.is-dragging) {
  transition: transform 0.12s ease;
}

/* A block whose config the server rejected. Marked on the block as well as in
 * the panel, because the block is what the person is looking at. */
.block-tile.is-broken {
  border-color: var(--warn);
}

/* Waiting for the server's redraw. A dimmed tile rather than a skeleton: the
 * previous drawing is still meaningful and still the right shape, and
 * replacing it with grey boxes loses information for no gain. */
.block-tile.is-loading {
  opacity: 0.55;
  transition: opacity 0.12s ease;
}

@media (prefers-reduced-motion: reduce) {
  .block-tile,
  .resize-handle,
  .block-tile.is-loading,
  #grid.is-arranging .block-tile:not(.is-dragging) {
    transition: none;
  }
}
</style>
