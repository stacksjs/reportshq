<script server>
// Signing in.
//
// The one page in the app that must render for a stranger, so it carries no
// AuthGuard and no app chrome. It does the opposite check instead: somebody who
// already has a session is sent to their reports rather than shown a form
// asking them to do something they have already done.
import { sessionFrom } from '../../../app/Support/session'

const session = await sessionFrom(typeof cookies !== 'undefined' ? cookies : undefined)
const signedIn = session.user !== null
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    {{-- Already signed in: bounce before anything paints, the same way the
         guard does in the other direction. --}}
    @if (signedIn)
      <script>window.location.replace('/reports')</script>
    @endif

    <main class="grid place-items-center px-6 py-16 min-h-[100dvh]">
      <div class="max-w-sm w-full">
        <a href="/" class="flex gap-2 items-center mb-8 no-underline">
          <i class="h-5 w-5 text-accent i-hugeicons-chart-histogram"></i>
          <span class="font-semibold text-ink tracking-tight">ReportsHQ</span>
        </a>

        <h1 class="font-semibold text-2xl tracking-tight">Sign in</h1>
        <p class="mb-6 mt-1 text-muted text-sm">Your reports are where you left them.</p>

        {{-- A real form, so a password manager recognises it and the enter key
             submits. The script intercepts it; without the script it still
             posts somewhere sensible rather than nowhere. --}}
        <form id="signin" method="post" action="/api/auth/login" class="grid gap-4">
          <label class="block">
            <span class="block mb-1 text-muted text-sm">Email</span>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="username"
              required
              class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
            />
          </label>

          <label class="block">
            <span class="block mb-1 text-muted text-sm">Password</span>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
            />
          </label>

          {{-- Off by default: a shared machine should not opt into a month-long
               session by accident. Checked lengthens the session to 30 days;
               unchecked is the one-week baseline. --}}
          <label class="flex gap-2 items-center text-muted text-sm cursor-pointer select-none">
            <input id="remember" name="remember" type="checkbox" class="h-4 w-4 accent-accent" />
            <span>Keep me signed in for 30 days</span>
          </label>

          <p id="error" class="text-sm text-warn" hidden></p>

          <button
            id="submit"
            type="submit"
            class="px-4 py-2.5 font-medium text-accent-ink text-sm bg-accent rounded-lg disabled:opacity-60"
          >Sign in</button>
        </form>

        {{-- Second step, revealed only when the account has 2FA enabled. Dormant
             until an enrollment surface ships, but present so a 2FA account can
             never sign in halfway and stall. --}}
        <form id="twofa" method="post" action="/api/auth/verify-two-factor-login" class="grid gap-4" hidden>
          <h2 class="font-semibold text-lg tracking-tight">Two-factor code</h2>
          <p class="-mt-2 text-muted text-sm">Enter the 6-digit code from your authenticator app.</p>
          <label class="block">
            <span class="block mb-1 text-muted text-sm">Authentication code</span>
            <input
              id="code"
              name="code"
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              maxlength="6"
              class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
            />
          </label>

          <p id="twofa-error" class="text-sm text-warn" hidden></p>

          <button
            id="twofa-submit"
            type="submit"
            class="px-4 py-2.5 font-medium text-accent-ink text-sm bg-accent rounded-lg disabled:opacity-60"
          >Verify and sign in</button>
        </form>

        <p class="mt-6 text-muted text-sm">
          No account yet?
          <a href="/register" class="text-accent">Create one</a>
        </p>

        {{-- Below the sign-in action, not beside the password field: somebody
             who knows their password should never be routed past a way to
             reset it. --}}
        <p class="mt-2 text-muted text-sm">
          <a href="/forgot" class="text-subtle hover:text-ink">Forgot your password?</a>
        </p>
      </div>
    </main>
  </div>

{{-- Submitting the form.

     A plain script for the same reason as the guard: this page has to work
     before the runtime is loaded, and the whole page is one form. --}}
<script>
(function () {
  var form = document.getElementById('signin')
  if (!form) return

  var error = document.getElementById('error')
  var submit = document.getElementById('submit')
  var twofa = document.getElementById('twofa')
  var twofaError = document.getElementById('twofa-error')
  var twofaSubmit = document.getElementById('twofa-submit')

  // The 2FA step is a separate request, so the "remember me" choice made at
  // step one is captured here and re-sent with the code — otherwise a 2FA
  // account would be silently downgraded to the baseline week.
  var rememberChoice = false
  var challengeToken = null

  function fail(message) {
    error.textContent = message
    error.hidden = !message
    submit.disabled = false
    submit.textContent = 'Sign in'
  }

  function twofaFail(message) {
    twofaError.textContent = message
    twofaError.hidden = !message
    twofaSubmit.disabled = false
    twofaSubmit.textContent = 'Verify and sign in'
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault()
    fail('')
    submit.disabled = true
    submit.textContent = 'Signing in'

    var remember = document.getElementById('remember')
    rememberChoice = !!(remember && remember.checked)

    fetch('/api/auth/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        email: document.getElementById('email').value,
        password: document.getElementById('password').value,
        remember: rememberChoice,
      }),
    }).then(function (res) {
      if (res.ok) {
        // replace, not assign: the back button should not return to a sign-in
        // form the person has already used.
        window.location.replace('/reports')
        return
      }

      return res.json().then(function (data) {
        // 2FA-enabled account: reveal the code step and carry the challenge.
        if (data && data.requires_two_factor && data.challenge_token) {
          challengeToken = data.challenge_token
          form.hidden = true
          twofa.hidden = false
          document.getElementById('code').focus()
          return
        }
        fail((data && data.message) || 'Could not sign you in.')
      }).catch(function () { fail('Could not sign you in.') })
    }).catch(function () {
      fail('Could not reach the server.')
    })
  })

  twofa.addEventListener('submit', function (event) {
    event.preventDefault()
    twofaFail('')
    twofaSubmit.disabled = true
    twofaSubmit.textContent = 'Verifying'

    fetch('/api/auth/verify-two-factor-login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        challenge_token: challengeToken,
        code: document.getElementById('code').value,
        remember: rememberChoice,
      }),
    }).then(function (res) {
      if (res.ok) {
        window.location.replace('/reports')
        return
      }

      return res.json().then(function (data) {
        // Challenge tokens are single-use; a failure sends the person back to
        // the start rather than letting them retry a spent challenge.
        twofa.hidden = true
        form.hidden = false
        fail((data && data.message) || 'Could not sign you in.')
      }).catch(function () {
        twofa.hidden = true
        form.hidden = false
        fail('Could not sign you in.')
      })
    }).catch(function () {
      twofaFail('Could not reach the server.')
    })
  })
}())
</script>
</template>
