<script server>
// Signing in.
//
// The one page in the app that must render for a stranger, so it carries no
// AuthGuard and no app chrome. It does the opposite check instead: somebody who
// already has a session is sent to their reports rather than shown a form
// asking them to do something they have already done.
import { sessionFrom } from '~/app/Support/session'

const session = await sessionFrom(typeof cookies !== 'undefined' ? cookies : undefined)
const signedIn = session.user !== null
</script>

<script client>
// Submitting the form, as stx client code rather than the DOM-walking script
// this used to be (stx-standards rule 8).
//
// ## What it replaced
//
// A bare `<script>` IIFE that held six `document.getElementById` handles
// (`signin`, `error`, `submit`, `twofa`, `twofa-error`, `twofa-submit`), read
// three more by id on every submit, toggled `.hidden` on two forms to move
// between steps, wrote button labels and `disabled` by hand, and left the page
// with `window.location.replace`. Thirteen prohibited calls in all.
//
// Everything it did with ids is now state: `step` owns which form is on screen,
// `error` and `twofaError` own the banners, `loading` owns both buttons. The
// markup reads those signals, so there is no element to find and nothing to
// keep in sync by hand.
//
// ## Two things worth knowing before changing this
//
// `navigate('/reports', { replace: true })` is deliberate, not decoration. The
// old code used `window.location.replace` and said why: the back button should
// not return to a sign-in form the person has already used. Plain `navigate()`
// pushes, so dropping the option would quietly reintroduce that. Measured in
// the served runtime rather than assumed -- `navigate(url, options)` reads
// `opts.replace` and calls `location.replace` (or passes `{replace}` to the
// router), so the old behaviour is preserved exactly.
//
// The two forms are toggled with `:hidden`, not wrapped in `@if`, and that is
// the one place this conversion deliberately departs from bughq's login. A
// client `@if` compiles to an attribute plus `x-cloak`, and the emitted
// `[x-cloak]{display:none !important}` means the form is invisible until the
// runtime resolves it -- so a runtime that never arrives leaves a stranger
// looking at an empty page. `:hidden` inverts that: the credentials form is
// visible by default and the 2FA form carries a static `hidden` attribute, so
// with no runtime at all the page looks exactly as it did before this change.
//
// That is also why both forms keep their `method` and `action`. This block only
// binds once the runtime has loaded, and a submit before that still has to go
// somewhere sensible rather than nowhere -- the same reason the signed-in
// bounce below is still a plain script.
const error = state('')
const twofaError = state('')
const loading = state(false)
// 'credentials' -> (only for a 2FA-enabled account) 'twofa'.
const step = state('credentials')
// Minted by the login endpoint when the account has 2FA on; exchanged with the
// TOTP code. Single-use.
const challengeToken = state('')
// The "remember me" choice captured at step one and re-sent with the code, so a
// 2FA account is issued the same session length (30 days vs the one-week
// baseline) instead of being silently downgraded.
const rememberChoice = state(false)

// The code field does not exist until `step` re-renders, so a focus issued in
// the same tick reads a null ref. 20ms and debounced, matching the same
// problem's solution in bughq's settings.stx: the composable owns the timer and
// drops it on destroy.
const codeField = useRef('code')
const focusCode = useDebounce(() => codeField.current?.focus(), 20)

/** What /api/auth/login and /api/auth/verify-two-factor-login answer with. */
interface LoginResponse {
  message?: string
  requires_two_factor?: boolean
  challenge_token?: string
}

// Reading an uncontrolled field is two narrowings: `e.target` is an EventTarget
// and `form.elements` hands back Elements, and neither carries a `.value`. A
// field the markup does not contain reads as empty rather than throwing -- the
// endpoint validates what it is sent regardless.
function fieldValue(form: HTMLFormElement, name: string): string {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.value : ''
}

/** A checkbox reads by `.checked`, not `.value` (which is the constant 'on'). */
function fieldChecked(form: HTMLFormElement, name: string): boolean {
  const el = form.elements.namedItem(name)
  return el instanceof HTMLInputElement ? el.checked : false
}

async function handleSubmit(event: SubmitEvent): Promise<void> {
  event.preventDefault()
  if (loading())
    return
  const form = event.target
  if (!(form instanceof HTMLFormElement))
    return

  loading.set(true)
  error.set('')
  const remember = fieldChecked(form, 'remember')
  rememberChoice.set(remember)

  try {
    const res = await fetch('/api/auth/login', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: fieldValue(form, 'email'), password: fieldValue(form, 'password'), remember }),
    })

    if (res.ok) {
      navigate('/reports', { replace: true })
      return
    }

    const data: LoginResponse = await res.json().catch(() => ({}))
    // A 2FA-enabled account: no session yet, just a challenge. Move to the code
    // step and put the cursor in the field.
    if (data.requires_two_factor && data.challenge_token) {
      challengeToken.set(data.challenge_token)
      twofaError.set('')
      step.set('twofa')
      focusCode()
      return
    }
    error.set(data.message || 'Could not sign you in.')
  }
  catch {
    error.set('Could not reach the server.')
  }
  finally {
    loading.set(false)
  }
}

async function handleTwoFactor(event: SubmitEvent): Promise<void> {
  event.preventDefault()
  if (loading())
    return
  const form = event.target
  if (!(form instanceof HTMLFormElement))
    return

  loading.set(true)
  twofaError.set('')

  try {
    const res = await fetch('/api/auth/verify-two-factor-login', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ challenge_token: challengeToken(), code: fieldValue(form, 'code'), remember: rememberChoice() }),
    })

    if (res.ok) {
      navigate('/reports', { replace: true })
      return
    }

    const data: LoginResponse = await res.json().catch(() => ({}))
    // Challenge tokens are single-use, so a bad code sends the person back to
    // the start rather than letting them retry a spent challenge. The message
    // lands on the first step's banner, which is where they now are.
    step.set('credentials')
    challengeToken.set('')
    error.set(data.message || 'Could not sign you in.')
  }
  catch {
    // A network failure spent nothing, so the code step stays put.
    twofaError.set('Could not reach the server.')
  }
  finally {
    loading.set(false)
  }
}
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    {{-- Already signed in: bounce before anything paints, the same way the
         guard does in the other direction. --}}
    @if (signedIn)
      <script>
        // A pre-paint bounce. navigate() is not in scope here: a plain <script> gets no
        // auto-imports, and the redirect has to beat first paint, which is the point.
        // stx-strict-ignore-next-line window.location location.replace()
        window.location.replace('/reports')
      </script>
    @endif

    <main class="grid place-items-center px-6 py-16 min-h-[100dvh]">
      <div class="max-w-sm w-full">
        <StxLink to="/" class="flex gap-2 items-center mb-8 no-underline">
          <i class="h-5 w-5 text-accent i-hugeicons-chart-histogram"></i>
          <span class="font-semibold text-ink tracking-tight">ReportsHQ</span>
        </StxLink>

        <h1 class="font-semibold text-2xl tracking-tight">Sign in</h1>
        <p class="mb-6 mt-1 text-muted text-sm">Your reports are where you left them.</p>

        {{-- A real form, so a password manager recognises it and the enter key
             submits. The client block intercepts it; without the runtime it
             still posts somewhere sensible rather than nowhere. --}}
        <form method="post" action="/api/auth/login" @submit="handleSubmit" :hidden="step() !== 'credentials'">
          <div class="grid gap-4">
            <label class="block">
              <span class="block mb-1 text-muted text-sm">Email</span>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                required
                class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
                :aria-invalid="error() ? 'true' : 'false'"
                :aria-describedby="error() ? 'error' : ''"
              />
            </label>

            <label class="block">
              <span class="block mb-1 text-muted text-sm">Password</span>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
                :aria-invalid="error() ? 'true' : 'false'"
                :aria-describedby="error() ? 'error' : ''"
              />
            </label>

            {{-- Off by default: a shared machine should not opt into a month-long
                 session by accident. Checked lengthens the session to 30 days;
                 unchecked is the one-week baseline. --}}
            <label class="flex gap-2 items-center text-muted text-sm cursor-pointer select-none">
              <input id="remember" name="remember" type="checkbox" class="h-4 w-4 accent-accent" />
              <span>Keep me signed in for 30 days</span>
            </label>

            @if (error())
              <p id="error" class="text-sm text-warn" role="alert">{{ error() }}</p>
            @endif

            <button
              type="submit"
              :disabled="loading()"
              class="px-4 py-2.5 font-medium text-accent-ink text-sm bg-accent rounded-lg disabled:opacity-60"
            >{{ loading() ? 'Signing in' : 'Sign in' }}</button>
          </div>
        </form>

        {{-- Second step, reached only when the account has 2FA enabled. Dormant
             until an enrollment surface ships, but present so a 2FA account can
             never sign in halfway and stall. --}}
        <form method="post" action="/api/auth/verify-two-factor-login" @submit="handleTwoFactor" hidden :hidden="step() !== 'twofa'">
          <div class="grid gap-4">
            <h2 class="font-semibold text-lg tracking-tight">Two-factor code</h2>
            <p class="-mt-2 text-muted text-sm">Enter the 6-digit code from your authenticator app.</p>
            <label class="block">
              <span class="block mb-1 text-muted text-sm">Authentication code</span>
              <input
                ref="code"
                id="code"
                name="code"
                type="text"
                inputmode="numeric"
                autocomplete="one-time-code"
                maxlength="6"
                class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
                :aria-invalid="twofaError() ? 'true' : 'false'"
                :aria-describedby="twofaError() ? 'twofa-error' : ''"
              />
            </label>

            @if (twofaError())
              <p id="twofa-error" class="text-sm text-warn" role="alert">{{ twofaError() }}</p>
            @endif

            <button
              type="submit"
              :disabled="loading()"
              class="px-4 py-2.5 font-medium text-accent-ink text-sm bg-accent rounded-lg disabled:opacity-60"
            >{{ loading() ? 'Verifying' : 'Verify and sign in' }}</button>
          </div>
        </form>

        <p class="mt-6 text-muted text-sm">
          No account yet?
          <StxLink to="/register" class="text-accent">Create one</StxLink>
        </p>

        {{-- Below the sign-in action, not beside the password field: somebody
             who knows their password should never be routed past a way to
             reset it. --}}
        <p class="mt-2 text-muted text-sm">
          <StxLink to="/forgot" class="text-subtle hover:text-ink">Forgot your password?</StxLink>
        </p>
      </div>
    </main>
  </div>
</template>
