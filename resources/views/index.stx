<script server>
// The landing page.
//
// The hero shows a **real report**: the same chart components the product
// renders, drawn server-side from a fixed sample series. Not a screenshot, and
// never a mockup dressed as one. If the charts ever break, this page breaks
// with them, which is the point: a landing page that cannot go stale is one
// nobody has to remember to update.
//
// The sample is stated as a sample. Numbers on a marketing page that imply a
// real customer's business are a lie with a chart on it.
import { useSeoMeta } from 'stx'
import { PLANS } from '../../app/Billing/limits'

const siteUrl = 'https://reportshq.org'
const siteDescription = 'Reports that run inside your own Stacks or Laravel application, against your own database. Install a package, point it at the models you already have, and the numbers never leave your servers.'

useSeoMeta({
  title: 'ReportsHQ: reports that build themselves',
  description: siteDescription,
  canonical: siteUrl,
  ogUrl: siteUrl,
  ogTitle: 'Reports that build themselves',
  ogDescription: siteDescription,
  ogType: 'website',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

/**
 * A fixed thirty days of sample data.
 *
 * Deterministic rather than random: a landing page that renders a different
 * shape on every request is a landing page whose screenshot never matches what
 * the next person sees. The shape is a plausible week-on-week rhythm with a
 * weekend dip, because a straight line reads as fake and noise reads as broken.
 */
function sampleSeries(): Array<{ t: string, value: number }> {
  const points: Array<{ t: string, value: number }> = []
  const start = Date.UTC(2026, 6, 17)

  for (let day = 0; day < 30; day++) {
    const at = new Date(start + day * 86_400_000)
    const weekday = at.getUTCDay()
    const weekend = weekday === 0 || weekday === 6

    // A gentle upward drift, a weekend dip, and a fixed wobble.
    const base = 2600 + day * 38
    const wobble = [0, 210, -140, 90, -60, 260, -190][day % 7] ?? 0

    points.push({
      t: at.toISOString(),
      value: Math.round((base + wobble) * (weekend ? 0.62 : 1)),
    })
  }

  return points
}

const revenueSeries = sampleSeries()
const revenueTotal = revenueSeries.reduce((sum, point) => sum + point.value, 0)

const heroLine = {
  series: [{ key: 'total', points: revenueSeries, total: revenueTotal }],
  total: revenueTotal,
  grain: 'day',
}

const heroRevenue = {
  series: [{ key: 'total', points: [], total: revenueTotal }],
  total: revenueTotal,
}

const heroOrders = {
  series: [{ key: 'total', points: [], total: 1284 }],
  total: 1284,
}

const heroPlans = {
  series: [
    { key: 'pro', points: [], total: 512 },
    { key: 'scale', points: [], total: 431 },
    { key: 'starter', points: [], total: 341 },
  ],
  total: 1284,
}

/**
 * The install, in both ecosystems it actually ships for.
 *
 * There are two packages in this repository - `packages/stacks` and
 * `packages/laravel` - and for a long time this section showed neither
 * honestly: the snippet headed "From a Stacks app" was PHP, and the one headed
 * "anything that speaks HTTP" was `composer require`. Both are spelled out
 * now, side by side, because a reader arriving from either language should see
 * their own install rather than a translation exercise.
 *
 * Each snippet is the real thing. The Stacks one is what `config/reportshq.ts`
 * in this very application looks like, trimmed to one model.
 */
const stacksSnippet = `bun add @reportshq/stacks

// config/reportshq.ts
import type { ModelDescription } from '@reportshq/stacks'

export const models: Record<string, ModelDescription> = {
  order: {
    table: 'orders',
    measures: {
      revenue: { aggregate: 'sum', column: 'total_amount', unit: 'currency' },
    },
    time: {
      placed: 'created_at',
    },
    dimensions: {
      status: 'status',
    },
  },
}`

const laravelSnippet = `composer require reportshq/laravel
php artisan vendor:publish --tag=reportshq-config

// config/reportshq.php
'models' => [
    'order' => [
        'class' => App\\Models\\Order::class,
        'measures' => [
            'revenue' => ['aggregate' => 'sum', 'column' => 'total_amount'],
        ],
        'time' => ['placed' => 'created_at'],
        'dimensions' => ['status' => 'status'],
    ],
],`

const steps = [
  {
    title: 'Install it into the application',
    body: 'One package and a migration, in Stacks or in Laravel. No service to deploy beside it, no connection into production to hand out, and nothing to keep upgrading separately from the app it reports on.',
    icon: 'i-hugeicons-package',
  },
  {
    title: 'Name the models you already have',
    body: 'An order, a customer, a subscription. Say which fields are measures and which are dates, and the reports have real numbers in them immediately, at the grain you described. A question the description cannot answer correctly is refused rather than guessed at.',
    icon: 'i-hugeicons-magic-wand-01',
  },
  {
    title: 'Then make them yours',
    body: 'Drag blocks onto a grid, pick a measure and a dimension, and watch each one redraw. Publish when it is right, so a half finished edit is never what a teammate opens.',
    icon: 'i-hugeicons-dashboard-square-01',
  },
]

const features = [
  {
    title: 'A builder that behaves',
    body: 'Twelve columns, drag to move, corner to resize, keyboard for everything. Blocks push each other out of the way while you hold them, and the server settles the layout so two blocks can never share a cell.',
    icon: 'i-hugeicons-grid',
  },
  {
    title: 'Every block explains itself',
    body: 'One sentence, derived from the query the block actually runs. Two charts called Revenue can count different things, and a reader deserves to know which one they are looking at.',
    icon: 'i-hugeicons-message-question',
  },
  {
    title: 'Share without an account',
    body: 'A link shows one published report and nothing around it. Revoke it and it stops working on the next request. Embed it in your own page if you would rather.',
    icon: 'i-hugeicons-link-04',
  },
  {
    title: 'Delivered on a schedule',
    body: 'The headline numbers by email, daily, weekly or monthly, in your own timezone, with a spreadsheet attached if you want one. The hour stays the hour after the clocks change.',
    icon: 'i-hugeicons-mail-01',
  },
  {
    title: 'Yours to host',
    body: 'A Stacks application with public source. Run it yourself and every tier limit falls away, because there is nothing left to enforce them against.',
    icon: 'i-hugeicons-server-stack-01',
  },
  {
    title: 'Honest about its numbers',
    body: 'Comparisons say when there was no previous period rather than inventing a percentage. Bounded dimensions say what went into Other. Sampling keeps whole people, so funnels still mean something.',
    icon: 'i-hugeicons-scales-01',
  },
]

const freeApplications = PLANS.free.applications

const docLinks = [
  {
    title: 'The Stacks package',
    body: 'Installing it, describing your models, and what the builder can compose once they are described.',
    href: '/docs/stacks',
  },
  {
    title: 'The Laravel package',
    body: 'The same engine and the same charts, described in PHP and mounted through your own routes.',
    href: '/docs/laravel',
  },
  {
    title: 'The query API',
    body: 'The JSON surface the charts read, and the refusals it returns rather than answering a question wrongly.',
    href: '/docs/api',
  },
  {
    title: 'Self-hosting',
    body: 'There is no other kind. What a licence covers, and what happens when you leave the key unset.',
    href: '/docs/self-hosting',
  },
]
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    {{-- The chart components, compiled from the same stx sources the package
         ships, so the marketing charts and a customer's charts cannot diverge.
         In the body because stx generates the head itself; a module script runs
         after parse wherever it sits. --}}
    <link rel="stylesheet" href="/reportshq-charts.css">
    <style>
      /* A custom element is inline with no intrinsic size, so a chart that
         sizes itself to its container collapses to nothing and renders its
         axis labels into a zero-height box. The package's own stylesheet does
         this for the report grid; the marketing page lays them out itself and
         has to say so too. */
      stacks-big-number, stacks-bar-chart, stacks-line-chart,
      stacks-donut-chart, stacks-table-chart, stacks-funnel-chart { display: block; }
      stacks-bar-chart, stacks-line-chart, stacks-donut-chart { min-height: 13rem; }
      stacks-big-number { min-height: 4.5rem; }
      /* The chart draws into a viewBox and leaves sizing to its container. An
         SVG with no width resolves to zero, so the paths are correct and
         invisible, which looks like a data problem and is not one. */
      stacks-bar-chart svg, stacks-line-chart svg, stacks-donut-chart svg,
      stacks-funnel-chart svg { width: 100%; height: 100%; display: block; }
    </style>
    <script type="module" src="/reportshq-charts.js"></script>

    @include('SiteNav')

    <main>
      {{-- Hero. Split rather than centred: the claim and the proof belong side
           by side, and a centred headline over a gradient is the shape every
           other analytics landing page already has. --}}
      <section class="mx-auto pb-12 pt-16 px-6 md:pt-24 max-w-6xl">
        <div class="grid gap-12 items-center lg:grid-cols-[minmax(0,42%)_minmax(0,58%)]">
          <div>
            <h1 class="font-semibold leading-none text-4xl tracking-tighter md:text-6xl">
              Reports that build themselves
            </h1>

            <p class="mt-6 max-w-[46ch] leading-relaxed text-base text-muted">
              Name the models you already have. The Commerce, Users and Content reports
              appear with real numbers in them, covering everything in your database rather
              than starting at zero today.
            </p>

            <div class="flex flex-wrap gap-3 items-center mt-8">
              <a href="/register" class="px-5 py-2.5 font-medium no-underline text-accent-ink text-sm bg-accent rounded-lg">
                Start free
              </a>
              <a href="/pricing" class="px-5 py-2.5 no-underline text-ink text-sm border border-line rounded-lg hover:border-accent">
                See pricing
              </a>
            </div>

            <p class="mt-4 text-sm text-subtle">
              {{ freeApplications }} application free, with unlimited reports. No card.
            </p>
          </div>

          {{-- The product, rendered. These are the components the app uses, so
               this cannot drift from what a customer gets. --}}
          <div class="p-5 bg-panel border border-line rounded-2xl shadow-sm">
            <div class="grid gap-4 grid-cols-1 sm:grid-cols-2">
              <div class="p-4 bg-canvas border border-line rounded-xl">
                <stacks-big-number result="{{ JSON.stringify(heroRevenue) }}" title="Revenue" unit="currency"></stacks-big-number>
              </div>
              <div class="p-4 bg-canvas border border-line rounded-xl">
                <stacks-big-number result="{{ JSON.stringify(heroOrders) }}" title="Orders"></stacks-big-number>
              </div>
            </div>

            <div class="mt-4 p-4 bg-canvas border border-line rounded-xl">
              <stacks-line-chart result="{{ JSON.stringify(heroLine) }}" title="Revenue per day" variant="area"></stacks-line-chart>
            </div>

            <div class="mt-4 p-4 bg-canvas border border-line rounded-xl">
              <stacks-donut-chart result="{{ JSON.stringify(heroPlans) }}" title="Orders by plan"></stacks-donut-chart>
            </div>

            <p class="mt-3 text-subtle text-xs">
              A sample report, drawn by the same components the product uses. The numbers are made
              up; the charts are not.
            </p>
          </div>
        </div>
      </section>

      {{-- The narrative, as three steps rather than three equal boxes of
           adjectives. --}}
      <section class="mx-auto px-6 py-20 max-w-6xl">
        <h2 class="font-semibold text-3xl tracking-tight">Three steps, and you write none of the reporting</h2>

        <div class="grid gap-8 lg:grid-cols-3 mt-12">
          @foreach (steps as step)
            <div>
              <i class="w-6 h-6 {{ step.icon }} text-accent"></i>
              <h3 class="mt-4 font-medium text-base text-ink">{{ step.title }}</h3>
              <p class="mt-2 max-w-[42ch] leading-relaxed text-muted text-sm">{{ step.body }}</p>
            </div>
          @endforeach
        </div>

        {{-- `min-w-0` on the grid children is load-bearing. A grid item defaults
             to `min-width: auto`, so a long unwrapped line inside the `<pre>`
             widens the track rather than scrolling within it, and the whole page
             picks up a horizontal scrollbar on a phone. --}}
        <div class="grid gap-4 lg:grid-cols-2 mt-12">
          <div class="min-w-0">
            <h3 class="mb-2 font-medium text-ink text-sm">In a Stacks app</h3>
            <pre class="overflow-x-auto p-4 font-mono leading-relaxed text-ink text-xs bg-panel border border-line rounded-xl">{{ stacksSnippet }}</pre>
          </div>
          <div class="min-w-0">
            <h3 class="mb-2 font-medium text-ink text-sm">In a Laravel app</h3>
            <pre class="overflow-x-auto p-4 font-mono leading-relaxed text-ink text-xs bg-panel border border-line rounded-xl">{{ laravelSnippet }}</pre>
          </div>
        </div>
      </section>

      <section class="mx-auto px-6 py-20 max-w-6xl border-line border-t">
        <h2 class="font-semibold text-3xl tracking-tight">What you get</h2>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-12">
          @foreach (features as feature)
            <div class="p-6 bg-panel border border-line rounded-xl">
              <i class="w-5 h-5 {{ feature.icon }} text-accent"></i>
              <h3 class="mt-4 font-medium text-base text-ink">{{ feature.title }}</h3>
              <p class="mt-2 leading-relaxed text-muted text-sm">{{ feature.body }}</p>
            </div>
          @endforeach
        </div>
      </section>

      {{-- Docs teaser. Three real entry points rather than one "Read the docs"
           button, because the question somebody has at this point is specific
           and a landing page that knows which three it is saves them a search. --}}
      <section class="mx-auto pb-20 px-6 max-w-6xl border-line border-t">
        <div class="flex flex-wrap gap-4 items-end justify-between pt-20">
          <div>
            <h2 class="font-semibold text-3xl tracking-tight">Written down, not implied</h2>
            <p class="mt-3 max-w-[52ch] leading-relaxed text-muted text-sm">
              How a model is described, what the compiler will and will not answer, and why it
              refuses rather than guessing. Every bound the query API enforces is stated.
            </p>
          </div>
          <a href="/docs" class="no-underline text-accent text-sm hover:underline">All documentation</a>
        </div>

        <div class="grid gap-4 lg:grid-cols-3 mt-10">
          @foreach (docLinks as doc)
            <a href="{{ doc.href }}" class="block p-5 no-underline bg-panel border border-line rounded-xl hover:border-accent">
              <h3 class="font-medium text-ink text-sm">{{ doc.title }}</h3>
              <p class="mt-2 leading-relaxed text-muted text-sm">{{ doc.body }}</p>
            </a>
          @endforeach
        </div>
      </section>

      <section class="mx-auto pb-24 px-6 max-w-6xl">
        <div class="p-10 bg-panel border border-line rounded-2xl">
          <h2 class="font-semibold text-2xl tracking-tight">Describe one model and see</h2>
          <p class="mt-3 max-w-[56ch] leading-relaxed text-muted text-sm">
            Install the package, name a model you already have, and drop a block on the grid. It
            reads rows that are already in your database, so the first chart covers all of them.
          </p>
          <a href="/register" class="inline-block mt-6 px-5 py-2.5 font-medium no-underline text-accent-ink text-sm bg-accent rounded-lg">
            Create an account
          </a>
        </div>
      </section>
    </main>

    @include('SiteFooter')
  </div>
</template>
