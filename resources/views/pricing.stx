<script server>
// Pricing.
//
// **Every number on this page is read from `app/Billing/limits.ts`**, the same
// file the gates enforce. That is the whole design of this page. A pricing
// table maintained separately from enforcement is a promise somebody eventually
// breaks by editing one of them, and the person who finds out is a customer who
// paid for a number that turned out not to be true.
//
// If a limit changes, this page changes with it. Nothing here is typed twice.
import { useSeoMeta } from 'stx'
import { PLANS, TIERS } from '../../app/Billing/limits'

const siteUrl = 'https://reportshq.org'
const pricingDescription = 'Three plans, priced per installed application. Free covers one application with unlimited reports and no card. Your data never leaves your servers, and nothing here can stop a report rendering.'

useSeoMeta({
  title: 'Pricing | ReportsHQ',
  description: pricingDescription,
  canonical: `${siteUrl}/pricing`,
  ogUrl: `${siteUrl}/pricing`,
  ogTitle: 'Pricing that reads like the product',
  ogDescription: pricingDescription,
  ogType: 'website',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

function money(cents: number): string {
  if (cents === 0)
    return 'Free'

  return `$${(cents / 100).toFixed(0)}`
}

function count(value: number): string {
  return value.toLocaleString('en-GB')
}

/** The capability rows, in the order somebody evaluates them. */
const CAPABILITY_ROWS = [
  { key: 'shares', label: 'Public share links' },
  { key: 'embeds', label: 'Embed in your own pages' },
  { key: 'schedules', label: 'Scheduled email delivery' },
  { key: 'xlsx', label: 'XLSX export' },
  { key: 'unbranded', label: 'Remove our footer from shares' },
] as const

/**
 * What a year up front saves, as whole months.
 *
 * Computed from the two prices rather than written beside them, so the claim
 * cannot outlive the number it describes. If the yearly price is ever changed
 * without the copy, the copy changes with it.
 */
function monthsSaved(plan: { price: number, yearlyPrice: number }): number {
  if (plan.price === 0)
    return 0

  return Math.round((plan.price * 12 - plan.yearlyPrice) / plan.price)
}

const savedMonths = monthsSaved(PLANS.hobby)

const tiers = TIERS.map((tier) => {
  const plan = PLANS[tier]

  return {
    tier,
    name: plan.name,
    price: money(plan.price),
    yearlyPrice: money(plan.yearlyPrice),
    // A year is shown as its own total, not as a monthly-equivalent with the
    // real charge in small print. The number on the card is the number billed.
    yearlyCadence: plan.price === 0 ? 'no card needed' : 'per year',
    // "per month" only where there is a price to qualify. "Free per month" is
    // the sort of thing nobody proofreads.
    cadence: plan.price === 0 ? 'no card needed' : 'per month',
    // The line somebody reads first, so it is the number that decides the plan.
    headline: `${count(plan.applications)} application${plan.applications === 1 ? '' : 's'}`,
    highlight: tier === 'hobby',
    rows: [
      `${count(plan.applications)} installed application${plan.applications === 1 ? '' : 's'}`,
      // Zero means no ceiling, and says so in words. A row reading "0 reports"
      // is the opposite of what the number means.
      plan.reports === 0 ? 'Unlimited reports' : `${count(plan.reports)} reports per application`,
      `${count(plan.seats)} ${plan.seats === 1 ? 'person' : 'people'} on the licence`,
      'Your data never leaves your servers',
    ],
    capabilities: CAPABILITY_ROWS.map(row => ({
      label: row.label,
      included: plan.capabilities.includes(row.key as never),
    })),
    href: '/register',
    action: plan.price === 0 ? 'Start free' : `Start with ${plan.name}`,
  }
})

const freeApplications = count(PLANS.free.applications)

const faqs = [
  {
    question: 'What counts as an application?',
    answer: 'One installation of the package: one codebase, one database, one licence key. A staging copy of the same application does not count, and neither does a second environment. If you run three products, that is three applications.',
  },
  {
    question: 'What happens if I go over?',
    answer: 'Nothing stops working. The licence is checked offline and nothing here can blank a dashboard, so an application over its allowance keeps reporting on its own data exactly as before. We will ask you to move up a plan, which is a conversation rather than an outage.',
  },
  {
    question: 'Why not price per event, or per seat?',
    answer: 'Per event died with the hosted collector. Your data never reaches us, so there is nothing on our side to count, and metering your database from outside it would mean this tool reporting on how much you sell. Per seat would need the package to know who signs in to your application, which means reaching into your auth and keeping a count of your staff. Neither is something a reporting tool should do.',
  },
  {
    question: 'Do you see any of my data?',
    answer: 'No. The package runs inside your application, queries your database in place, and renders in your own browser. There is no ingest endpoint and no phoning home, including for the licence check. You can read the licence class; it opens no sockets, and a test asserts that.',
  },
  {
    question: 'What about self-hosting?',
    answer: 'That is the only shape there is. The package is the product, it runs on your servers, and a licence is what you are buying rather than access to somewhere. Leave the key unset and every limit on this page falls away.',
  },
  {
    question: 'Do I have to write tracking calls?',
    answer: 'No. The package reads the models you already have. Point it at an order, a customer, a subscription, and it reports on them where they sit, so there is nothing to instrument and nothing to keep in step with your schema.',
  },
]
</script>

<template>
  <div class="min-h-[100dvh] bg-canvas text-ink">
    @include('SiteNav')

    <main class="px-6 py-16 mx-auto max-w-6xl">
      <div class="max-w-[52ch]">
        <h1 class="text-4xl font-semibold tracking-tighter md:text-5xl">Pricing that reads like the product</h1>
        <p class="mt-4 text-base leading-relaxed text-muted">
          There is one plan table in the codebase and this page is rendered from it, so what
          you read here is what a licence covers. None of it gates a report: the software keeps
          working past every number below, because a reporting tool that goes dark over a
          billing state is one nobody can rely on.
        </p>
      </div>

      {{-- The billing toggle carries no JavaScript.

           A checkbox and two CSS rules swap which price is shown, so it works
           before hydration, works with scripting off, and cannot get stuck in a
           state the server disagrees with. A marketing page is the last place
           that needs a framework to change a number. --}}
      <div class="mt-12">
        <input type="checkbox" id="billing-yearly" class="sr-only billing-input">

        <label for="billing-yearly" class="inline-flex gap-3 items-center cursor-pointer select-none">
          {{-- shrink-0 so the track keeps its width. As a flex item it will
               otherwise collapse below 2.5rem when the label's text wraps,
               which is what happens on a narrow screen. --}}
          <span class="relative w-10 h-6 rounded-full border shrink-0 transition-colors border-line bg-panel billing-track">
            <span class="absolute top-1 left-1 w-4 h-4 rounded-full transition-transform bg-subtle billing-knob"></span>
          </span>
          <span class="text-sm text-ink">
            Pay yearly
            <span class="ml-1 text-subtle">and get {{ savedMonths }} months free</span>
          </span>
        </label>

        <div class="grid gap-5 mt-8 lg:grid-cols-3 tiers">
        @foreach (tiers as tier)
          {{-- The middle plan is marked, not inflated. No "most popular"
               badge on a product with no customers yet: a claim nobody can
               check is the fastest way to lose the reader. --}}
          <div class="flex flex-col p-6 rounded-2xl border {{ tier.highlight ? 'border-accent' : 'border-line' }} bg-panel">
            <h2 class="text-sm font-medium text-muted">{{ tier.name }}</h2>

            <p class="mt-3 price-monthly">
              <span class="text-4xl font-semibold tracking-tight num text-ink">{{ tier.price }}</span>
              <span class="ml-2 text-sm text-subtle">{{ tier.cadence }}</span>
            </p>

            <p class="mt-3 price-yearly">
              <span class="text-4xl font-semibold tracking-tight num text-ink">{{ tier.yearlyPrice }}</span>
              <span class="ml-2 text-sm text-subtle">{{ tier.yearlyCadence }}</span>
            </p>

            <p class="mt-3 text-sm font-medium text-ink">{{ tier.headline }}</p>

            <ul class="grid gap-2 mt-5 list-none">
              @foreach (tier.rows as row)
                <li class="text-sm text-muted">{{ row }}</li>
              @endforeach
            </ul>

            <ul class="grid gap-2 pt-5 mt-5 list-none border-t border-line">
              @foreach (tier.capabilities as capability)
                <li class="flex gap-2 items-start text-sm {{ capability.included ? 'text-ink' : 'text-subtle' }}">
                  {{-- An icon and a colour, never colour alone: roughly one in
                       twelve men cannot separate the two reliably, and a
                       pricing table is the worst place to be ambiguous. --}}
                  <i class="mt-0.5 w-4 h-4 shrink-0 {{ capability.included ? 'i-hugeicons-tick-02 text-accent' : 'i-hugeicons-minus-sign text-subtle' }}"></i>
                  <span>{{ capability.label }}</span>
                </li>
              @endforeach
            </ul>

            <a
              href="{{ tier.href }}"
              class="px-4 py-2.5 mt-6 text-sm font-medium text-center no-underline rounded-lg {{ tier.highlight ? 'bg-accent text-accent-ink' : 'border border-line text-ink hover:border-accent' }}"
            >{{ tier.action }}</a>
          </div>
        @endforeach
        </div>
      </div>

      <p class="mt-6 text-sm text-subtle">
        Every plan includes the builder, the auto-created reports, the integrations and the API.
        Plans differ in volume and distribution, not in whether the product works.
      </p>

      <section class="mt-24">
        <h2 class="text-2xl font-semibold tracking-tight">Questions worth answering honestly</h2>

        <div class="grid gap-4 mt-8 lg:grid-cols-2">
          @foreach (faqs as faq)
            <div class="p-5 rounded-xl border border-line bg-panel">
              <h3 class="text-sm font-medium text-ink">{{ faq.question }}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{{ faq.answer }}</p>
            </div>
          @endforeach
        </div>
      </section>

      <section class="p-8 mt-16 rounded-2xl border border-line bg-panel">
        <h2 class="text-xl font-semibold tracking-tight">Start on Free</h2>
        <p class="mt-2 max-w-[60ch] text-sm leading-relaxed text-muted">
          {{ freeApplications }} application, unlimited reports, no card, and the same builder everyone else gets. Install
          one event and the first report builds itself.
        </p>
        <a href="/register" class="inline-block px-4 py-2.5 mt-5 text-sm font-medium no-underline rounded-lg bg-accent text-accent-ink">
          Create an account
        </a>
      </section>
    </main>

    @include('SiteFooter')
  </div>
</template>

<style>
/*
 * The billing toggle, in CSS alone.
 *
 * The checkbox is the state. Yearly prices are hidden until it is checked, and
 * monthly prices hide in its place. Nothing here needs to run, so the toggle
 * works on the first paint rather than after a bundle arrives.
 *
 * The input keeps its native focus behaviour and is only visually hidden, so it
 * is still reachable and operable from the keyboard and still announced as a
 * checkbox with its label.
 */
.price-yearly {
  display: none;
}

.billing-input:checked ~ .tiers .price-monthly {
  display: none;
}

.billing-input:checked ~ .tiers .price-yearly {
  display: block;
}

.billing-input:checked ~ label .billing-track {
  background: var(--accent);
  border-color: var(--accent);
}

.billing-input:checked ~ label .billing-knob {
  background: var(--accent-ink);
  transform: translateX(1rem);
}

/* The focus ring belongs on the visible control, since the input itself is
   off-screen and a keyboard user would otherwise see nothing move. */
.billing-input:focus-visible ~ label .billing-track {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
</style>
