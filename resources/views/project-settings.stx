<script server>
// Project settings: who can see it, and the key that writes to it.
//
// Everything here is administration, so the whole page is gated on it rather
// than each control. A member who can read reports has no business seeing the
// member list's remove buttons greyed out; they should not be looking at this
// page at all.
import { db as __db } from '@stacksjs/database'
import { accessFor, canAdminister } from '../../app/Support/access'
import { membersOf, pendingInvitesFor } from '../../app/Support/projects'
import { param, sessionCookieName, sessionFrom } from '../../app/Support/session'

const session = await sessionFrom(cookies)
const cookieName = sessionCookieName()
const user = session.user
const authPending = session.stale

const projectId = Number(param(query, 'id') ?? 0)

const access = user && projectId ? await accessFor(user, projectId) : null
const mayAdminister = access && user ? await canAdminister(user, projectId) : false

const project = mayAdminister
  ? (await __db.unsafe(`SELECT * FROM projects WHERE id = $1 AND deleted_at IS NULL`, [projectId]))?.[0] as Record<string, unknown>
  : null

const found = project !== null && project !== undefined

const members = found ? await membersOf(projectId) : []
const invites = found ? await pendingInvitesFor(projectId) : []

const people = members.map(member => ({
  id: Number(member.user_id ?? member.id),
  name: String(member.name ?? 'Someone'),
  email: String(member.email ?? ''),
  role: String(member.role ?? 'member'),
  isOwner: String(member.role ?? '') === 'owner',
  isYou: Number(member.user_id ?? member.id) === Number(user?.id ?? 0),
}))

const waiting = invites.map(invite => ({
  id: Number(invite.id),
  email: String(invite.email),
  role: String(invite.role ?? 'member'),
}))

const ingestKey = found ? String(project!.ingest_key ?? '') : ''
const autoReports = found ? Boolean(project!.auto_reports_enabled) : false
const projectName = found ? String(project!.name) : ''
</script>

<template>
  <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>
  @include('AuthGuard')

  <div class="min-h-[100dvh] bg-canvas text-ink">
    @if (!user)
      <div id="auth-required" hidden></div>
    @endif
    @if (authPending)
      <div id="auth-pending" hidden></div>
    @endif

    @include('AppNav')

    <main class="px-6 py-10 mx-auto max-w-3xl">
      @if (!found)
        <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
          <h1 class="text-base font-medium">Not found</h1>
          <p class="mt-1 text-sm text-muted">It may have been deleted, or you may not administer it.</p>
          <a href="/projects" class="inline-block mt-5 text-sm text-accent">Back to projects</a>
        </div>
      @else
        <nav class="mb-2 text-sm text-subtle">
          <a href="/projects" class="text-muted">Projects</a>
          <span class="mx-2">/</span>
          <a href="/project?id={{ projectId }}" class="text-muted">{{ projectName }}</a>
          <span class="mx-2">/</span>
          <span>Settings</span>
        </nav>
        <h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
        <p class="mt-1 mb-8 text-sm text-muted">Who can see this project, and the key that writes to it.</p>

        <section class="mb-8">
          <h2 class="mb-3 text-sm font-medium">People</h2>
          <div class="rounded-xl border divide-y border-line divide-line bg-panel">
            @foreach (people as person)
              <div class="flex flex-wrap gap-3 justify-between items-center px-5 py-3">
                <div>
                  <p class="text-sm text-ink">
                    {{ person.name }}
                    @if (person.isYou)
                      <span class="ml-1 text-xs text-subtle">you</span>
                    @endif
                  </p>
                  <p class="text-xs text-subtle">{{ person.email }}</p>
                </div>
                <div class="flex gap-3 items-center">
                  <span class="text-xs capitalize text-muted">{{ person.role }}</span>
                  @if (!person.isOwner)
                    <button
                      type="button"
                      class="text-xs remove-member text-subtle hover:text-neg"
                      data-user="{{ person.id }}"
                    >Remove</button>
                  @else
                    {{-- The owner is not removable here. Handing a project to
                         somebody else is a different operation with different
                         consequences, and a Remove button beside the owner is
                         an invitation to lock everybody out. --}}
                    <span class="text-xs text-subtle">&nbsp;</span>
                  @endif
                </div>
              </div>
            @endforeach

            @foreach (waiting as invite)
              <div class="flex flex-wrap gap-3 justify-between items-center px-5 py-3">
                <div>
                  <p class="text-sm text-muted">{{ invite.email }}</p>
                  <p class="text-xs text-subtle">Invited, not accepted yet</p>
                </div>
                <div class="flex gap-3 items-center">
                  <span class="text-xs capitalize text-muted">{{ invite.role }}</span>
                  <button
                    type="button"
                    class="text-xs revoke-invite text-subtle hover:text-neg"
                    data-invite="{{ invite.id }}"
                  >Revoke</button>
                </div>
              </div>
            @endforeach
          </div>

          <form id="invite" class="flex flex-wrap gap-2 items-end mt-4">
            <label class="flex-1 min-w-[200px]">
              <span class="block mb-1 text-xs text-subtle">Invite by email</span>
              <input
                id="invite-email"
                type="email"
                required
                placeholder="teammate@example.com"
                class="px-3 py-2 w-full text-sm rounded-lg border border-line bg-panel text-ink"
              />
            </label>
            <label>
              <span class="block mb-1 text-xs text-subtle">Role</span>
              <select id="invite-role" class="px-3 py-2 text-sm rounded-lg border border-line bg-panel text-ink">
                <option value="member">Member</option>
                <option value="admin">Admin</option>
              </select>
            </label>
            <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg bg-accent text-accent-ink">Invite</button>
          </form>
          {{-- Invites are keyed on the email, not on an account, so somebody can
               be invited before they have signed up. --}}
          <p id="invite-note" class="mt-2 text-xs text-subtle">They do not need an account yet. The invite waits for them.</p>
        </section>

        <section class="mb-8">
          <h2 class="mb-3 text-sm font-medium">Ingest key</h2>
          <div class="p-5 rounded-xl border border-line bg-panel">
            <p class="mb-3 max-w-[65ch] text-sm text-muted">
              This authenticates writes to <code class="text-ink">/ingest</code>. It ships inside your
              application, so treat it as public: it says which project a write belongs to, not that
              the writer is trusted. It can only append events.
            </p>
            <div class="flex flex-wrap gap-2 items-center">
              <code id="key" class="flex-1 px-3 py-2 text-sm break-all rounded-lg border min-w-[240px] border-line bg-canvas text-ink">{{ ingestKey }}</code>
              <button id="copy-key" type="button" class="px-3 py-2 text-sm rounded-lg border border-line text-ink">Copy</button>
              <button id="rotate-key" type="button" class="px-3 py-2 text-sm rounded-lg border border-line text-warn">Rotate</button>
            </div>
            <p class="mt-2 text-xs text-subtle">
              Rotating stops the old key immediately. Anything still sending with it will be refused
              until you paste the new one in.
            </p>
          </div>
        </section>

        <section>
          <h2 class="mb-3 text-sm font-medium">Automatic reports</h2>
          <div class="p-5 rounded-xl border border-line bg-panel">
            <label class="flex gap-3 items-start">
              <input id="auto-reports" type="checkbox" class="mt-1 rounded border-line" @if (autoReports) checked @endif />
              <span>
                <span class="block text-sm text-ink">Build reports for me as events arrive</span>
                <span class="block mt-1 max-w-[60ch] text-sm text-muted">
                  When this project sends events that match the standard taxonomy, the matching
                  reports are created and published on their own. Turning this off does not remove
                  reports that already exist.
                </span>
              </span>
            </label>
          </div>
        </section>

        <p id="settings-error" class="mt-6 text-sm text-warn" hidden></p>
      @endif
    </main>
  </div>

<script>
(function () {
  var project = new URLSearchParams(window.location.search).get('id')
  if (!project) return

  var error = document.getElementById('settings-error')

  function fail(message) {
    if (!error) return
    error.textContent = message || ''
    error.hidden = !message
  }

  // These routes are not exempt from CSRF, unlike the builder's write surface,
  // so the token travels in a header taken from the cookie the app already set.
  // A GET-shaped read does not need it; every write here does.
  function csrf() {
    var match = document.cookie.match(/(?:^|;\s*)X-CSRF-Token=([^;]+)/)
    return match ? decodeURIComponent(match[1]) : ''
  }

  function send(url, options) {
    var settings = options || {}
    return fetch(url, {
      method: settings.method || 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf() },
      credentials: 'same-origin',
      body: settings.body ? JSON.stringify(settings.body) : undefined,
    })
  }

  function reloadOr(res, message) {
    if (res.ok) {
      window.location.reload()
      return
    }
    return res.json().then(function (data) {
      fail((data && data.message) || message)
    }).catch(function () { fail(message) })
  }

  var invite = document.getElementById('invite')
  if (invite) {
    invite.addEventListener('submit', function (event) {
      event.preventDefault()
      fail('')

      send('/api/projects/' + project + '/invites', {
        body: {
          email: document.getElementById('invite-email').value,
          role: document.getElementById('invite-role').value,
        },
      }).then(function (res) {
        return reloadOr(res, 'Could not send that invite.')
      }).catch(function () { fail('Could not reach the server.') })
    })
  }

  Array.prototype.forEach.call(document.querySelectorAll('.revoke-invite'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      send('/api/projects/' + project + '/invites/' + button.dataset.invite, { method: 'DELETE' })
        .then(function (res) { return reloadOr(res, 'Could not revoke that invite.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  Array.prototype.forEach.call(document.querySelectorAll('.remove-member'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      send('/api/projects/' + project + '/members/' + button.dataset.user, { method: 'DELETE' })
        .then(function (res) { return reloadOr(res, 'Could not remove them.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  var copy = document.getElementById('copy-key')
  if (copy) {
    copy.addEventListener('click', function () {
      var key = document.getElementById('key')
      if (!key) return

      // The clipboard API needs a secure context, and a local install over
      // plain HTTP is not one. Selecting the text is the honest fallback:
      // the person can still copy it, and nothing silently does nothing.
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(key.textContent.trim()).then(function () {
          copy.textContent = 'Copied'
          setTimeout(function () { copy.textContent = 'Copy' }, 1500)
        })
        return
      }

      var range = document.createRange()
      range.selectNodeContents(key)
      var selection = window.getSelection()
      selection.removeAllRanges()
      selection.addRange(range)
      copy.textContent = 'Selected'
      setTimeout(function () { copy.textContent = 'Copy' }, 1500)
    })
  }

  var rotate = document.getElementById('rotate-key')
  if (rotate) {
    rotate.addEventListener('click', function () {
      fail('')
      rotate.disabled = true
      rotate.textContent = 'Rotating'

      send('/api/projects/' + project + '/rotate-key')
        .then(function (res) { return reloadOr(res, 'Could not rotate the key.') })
        .catch(function () { fail('Could not reach the server.') })
        .then(function () {
          rotate.disabled = false
          rotate.textContent = 'Rotate'
        })
    })
  }

  var auto = document.getElementById('auto-reports')
  if (auto) {
    auto.addEventListener('change', function () {
      fail('')
      send('/api/projects/' + project + '/settings', { body: { auto_reports_enabled: auto.checked } })
        .then(function (res) {
          if (res.ok) return
          // Put the switch back: leaving it showing a setting that was not
          // saved is worse than the failure itself.
          auto.checked = !auto.checked
          return res.json().then(function (data) {
            fail((data && data.message) || 'Could not save that.')
          }).catch(function () { fail('Could not save that.') })
        })
        .catch(function () {
          auto.checked = !auto.checked
          fail('Could not reach the server.')
        })
    })
  }
}())
</script>
</template>
