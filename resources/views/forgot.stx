<script server>
// Asking for a reset link.
//
// Renders for a stranger, like /login. The response never says whether the
// address has an account, so this page cannot be used to find out who is a
// customer; the confirmation below is deliberately the same either way.
import { sessionCookieName, sessionFrom } from '../../../app/Support/session'

const session = await sessionFrom(typeof cookies !== 'undefined' ? cookies : undefined)
const cookieName = sessionCookieName()
const signedIn = session.user !== null
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    {{-- Already signed in: bounce before anything paints, the same way the
         guard does in the other direction. --}}
    @if (signedIn)
      <script>window.location.replace('/reports')</script>
    @endif

    <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>

    <main class="grid place-items-center px-6 py-16 min-h-[100dvh]">
      <div class="max-w-sm w-full">
        <a href="/" class="flex gap-2 items-center mb-8 no-underline">
          <i class="h-5 w-5 text-accent i-hugeicons-chart-histogram"></i>
          <span class="font-semibold text-ink tracking-tight">ReportsHQ</span>
        </a>

        <h1 class="font-semibold text-2xl tracking-tight">Reset your password</h1>
        <p class="mb-6 mt-1 text-muted text-sm">We will email you a link. It works once and expires in an hour.</p>

        {{-- A real form, so a password manager recognises it and the enter key
             submits. The script intercepts it; without the script it still
             posts somewhere sensible rather than nowhere. --}}
        <form id="signin" method="post" action="/api/auth/forgot" class="grid gap-4">
          <label class="block">
            <span class="block mb-1 text-muted text-sm">Email</span>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="username"
              required
              class="px-3 py-2 w-full text-ink text-sm bg-panel border border-line rounded-lg"
            />
          </label>

          <p id="error" class="text-sm text-warn" hidden></p>

          <button
            id="submit"
            type="submit"
            class="px-4 py-2.5 font-medium text-accent-ink text-sm bg-accent rounded-lg disabled:opacity-60"
          >Send the link</button>
        </form>

        <p id="done" class="mt-4 p-3 text-muted text-sm border border-line rounded-lg" hidden></p>

        <p class="mt-6 text-muted text-sm">
          Remembered it?
          <a href="/login" class="text-accent">Sign in</a>
        </p>
      </div>
    </main>
  </div>

{{-- Submitting the form.

     A plain script for the same reason as the guard: this page has to work
     before the runtime is loaded, and the whole page is one form. --}}
<script>
(function () {
  var form = document.getElementById('signin')
  if (!form) return

  var error = document.getElementById('error')
  var submit = document.getElementById('submit')

  function fail(message) {
    error.textContent = message
    error.hidden = !message
    submit.disabled = false
    submit.textContent = 'Send the link'
  }

  form.addEventListener('submit', function (event) {
    event.preventDefault()
    fail('')
    submit.disabled = true
    submit.textContent = 'Sending'

    fetch('/api/auth/forgot', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ email: document.getElementById('email').value }),
    }).then(function (res) {
      return res.json().then(function (data) {
        if (res.ok) {
          // The same confirmation whether or not the address has an account.
          var done = document.getElementById('done')
          done.textContent = (data && data.message) || 'If that email has an account, a reset link is on its way.'
          done.hidden = false
          form.hidden = true
          return
        }
        fail((data && data.message) || 'Could not send that link.')
      }).catch(function () { fail('Could not send that link.') })
    }).catch(function () {
      fail('Could not reach the server.')
    })
  })
}())
</script>
</template>
