<script server>
// The use-cases hub.
//
// Rendered from app/Marketing/pages.ts, which is also what the sitemap and the
// footer read. A hub page maintained separately from the list of pages is a hub
// page that stops linking to the newest one, and nobody notices for months.
import { useSeoMeta } from 'stx'
import { HUBS, pagesIn, pathFor } from '../../../app/Marketing/pages'

const hub = HUBS['use-cases']
const canonical = 'https://reportshq.org/use-cases'
const pages = pagesIn('use-cases').map(page => ({ ...page, href: pathFor(page) }))

useSeoMeta({
  title: `${hub.title} | ReportsHQ`,
  description: hub.description,
  canonical,
  ogUrl: canonical,
  ogTitle: hub.heading,
  ogType: 'website',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-6xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: hub.title },
]
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    @include('SiteNav')
    @include('Breadcrumbs')

    <main class="mx-auto px-6 py-12 max-w-6xl">
      <div class="max-w-[52ch]">
        <h1 class="font-semibold text-4xl tracking-tighter md:text-5xl">{{ hub.heading }}</h1>
        <p class="mt-4 leading-relaxed text-base text-muted">{{ hub.description }}</p>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 mt-12">
        @foreach (pages as page)
          <a href="{{ page.href }}" class="flex flex-col p-6 no-underline bg-panel border border-line rounded-xl hover:border-accent">
            <i class="w-5 h-5 {{ page.icon }} text-accent"></i>
            <h2 class="mt-4 font-medium text-base text-ink">{{ page.title }}</h2>
            <p class="mt-2 leading-relaxed text-muted text-sm">{{ page.description }}</p>
          </a>
        @endforeach
      </div>
    </main>

    @include('SiteFooter')
  </div>
</template>
