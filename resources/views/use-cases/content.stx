<script server>
import { metaTitleFor, pageFor } from '~/app/Marketing/pages'

const page = pageFor('use-cases', 'content')!
const canonical = 'https://reportshq.org/use-cases/content'

useSeoMeta({
  title: metaTitleFor(page.title),
  description: page.description,
  canonical,
  ogUrl: canonical,
  ogTitle: page.title,
  ogDescription: page.description,
  ogType: 'article',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-3xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Use cases', href: '/use-cases' },
  { label: page.title },
]

const sections = [
  {
    "heading": "Posts, authors and engagement",
    "body": "Name the Post model and its published-at, and posts over time, output per author, and engagement by category follow. If comments or reactions are models too, they are measures like any other."
  },
  {
    "heading": "It reports on what you published, not what was viewed",
    "body": "This reads your own database, so it knows what exists, who wrote it, and what state it is in. Page views come from a tracker on the page, and that is a genuinely different question. Most teams want both, and this is not trying to be the other one."
  },
  {
    "heading": "Drafts and scheduling behave",
    "body": "A draft is not counted as published, because the filter that excludes it is part of the description rather than something each report remembers to add. Declare it once and every block that reads that model inherits it."
  },
  {
    "heading": "A dashboard for people who never sign in",
    "body": "A share link gives an editor or a client the numbers with no account, from your own domain, and you can turn it off."
  }
]
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    @include('SiteNav')
    @include('Breadcrumbs')

    <main class="mx-auto px-6 py-10 max-w-3xl">
      <h1 class="font-semibold text-4xl tracking-tighter md:text-5xl">{{ page.title }}</h1>
      <p class="mt-5 leading-relaxed text-lg text-muted">{{ page.description }}</p>

      <div class="grid gap-10 mt-14">
        @foreach (sections as section)
          <section>
            <h2 class="font-semibold text-ink text-xl tracking-tight">{{ section.heading }}</h2>
            <p class="mt-3 leading-relaxed text-muted">{{ section.body }}</p>
          </section>
        @endforeach
      </div>

      {{-- The closing call to action, identical on all four use-case pages but
           for its copy. <Card> owns the fill, the border and the padding; the
           radius stays `rounded-2xl`, because 16px is this app's marketing
           radius (17 sites) rather than the 12px `rounded-panel` the dashboard
           uses. `!` because className is appended to the class ATTRIBUTE and
           attribute order does not decide CSS: `rounded-2xl` and the component's
           own `rounded-panel` are single-class selectors of equal specificity,
           so without it the winner is whichever crosswind emits later. --}}
      <Card padding="lg" className="mt-16 !rounded-2xl">
        <h2 class="font-semibold text-xl tracking-tight">Report on what gets read</h2>
        <p class="mt-2 leading-relaxed text-muted text-sm">
          Publish and view events are enough for the first content report, and the CMS integration sends both already.
        </p>
        <StxLink to="/register" class="inline-block mt-5 px-4 py-2.5 font-medium no-underline text-accent-ink text-sm bg-accent rounded-lg">
          Start free
        </StxLink>
      </Card>
    </main>

    @include('SiteFooter')
  </div>
</template>
