        <p class="mt-2 text-sm leading-relaxed text-muted">
          Publish and view events are enough for the first content report, and the CMS integration sends both already.
        </p>
        <a href="/register" class="inline-block px-4 py-2.5 mt-5 text-sm font-medium no-underline rounded-lg bg-accent text-accent-ink">
          Start free
        </a>
      </div>
    </main>

    @include('SiteFooter')
  </div>
</template>
