<script server>
import { metaTitleFor, pageFor } from '~/app/Marketing/pages'

const page = pageFor('use-cases', 'saas-users')!
const canonical = 'https://reportshq.org/use-cases/saas-users'

useSeoMeta({
  title: metaTitleFor(page.title),
  description: page.description,
  canonical,
  ogUrl: canonical,
  ogTitle: page.title,
  ogDescription: page.description,
  ogType: 'article',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-3xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Use cases', href: '/use-cases' },
  { label: page.title },
]

const sections = [
  {
    "heading": "Signups, activation and churn from the models you have",
    "body": "A User with a created-at, a Subscription with a status and a cancelled-at. That is enough for growth over time, active subscriptions right now, and churn by month."
  },
  {
    "heading": "State, not just events",
    "body": "How many subscriptions are active today is a question about the current state of a table. An event stream answers it badly, by replaying every change since the beginning and hoping none were missed. Reading the row is simply correct."
  },
  {
    "heading": "Cohorts that follow your own definitions",
    "body": "Activated means whatever your application says it means, because the report reads the same model your code does. There is no second definition of an activated user living in an analytics tool, slowly disagreeing with the first."
  },
  {
    "heading": "The numbers do not leave",
    "body": "Customer records, plan values and email addresses stay in your database. For anyone selling to enterprises or working under a data processing agreement, that is the difference between a procurement conversation and no conversation at all."
  }
]
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    @include('SiteNav')
    @include('Breadcrumbs')

    <main class="mx-auto px-6 py-10 max-w-3xl">
      <h1 class="font-semibold text-4xl tracking-tighter md:text-5xl">{{ page.title }}</h1>
      <p class="mt-5 leading-relaxed text-lg text-muted">{{ page.description }}</p>

      <div class="grid gap-10 mt-14">
        @foreach (sections as section)
          <section>
            <h2 class="font-semibold text-ink text-xl tracking-tight">{{ section.heading }}</h2>
            <p class="mt-3 leading-relaxed text-muted">{{ section.body }}</p>
          </section>
        @endforeach
      </div>

      {{-- The closing call to action, identical on all four use-case pages but
           for its copy. <Card> owns the fill, the border and the padding; the
           radius stays `rounded-2xl`, because 16px is this app's marketing
           radius (17 sites) rather than the 12px `rounded-panel` the dashboard
           uses. `!` because className is appended to the class ATTRIBUTE and
           attribute order does not decide CSS: `rounded-2xl` and the component's
           own `rounded-panel` are single-class selectors of equal specificity,
           so without it the winner is whichever crosswind emits later. --}}
      <Card padding="lg" className="mt-16 !rounded-2xl">
        <h2 class="font-semibold text-xl tracking-tight">Start with signups</h2>
        <p class="mt-2 leading-relaxed text-muted text-sm">
          One event when somebody signs up is enough to get a real report, and the funnel follows once you send the step after it.
        </p>
        <StxLink to="/register" class="inline-block mt-5 px-4 py-2.5 font-medium no-underline text-accent-ink text-sm bg-accent rounded-lg">
          Start free
        </StxLink>
      </Card>
    </main>

    @include('SiteFooter')
  </div>
</template>
