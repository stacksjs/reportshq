<script server>
import { useSeoMeta } from 'stx'
import { metaTitleFor, pageFor } from '../../../app/Marketing/pages'

const page = pageFor('use-cases', 'saas-users')!
const canonical = 'https://reportshq.org/use-cases/saas-users'

useSeoMeta({
  title: metaTitleFor(page.title),
  description: page.description,
  canonical,
  ogUrl: canonical,
  ogTitle: page.title,
  ogDescription: page.description,
  ogType: 'article',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-3xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Use cases', href: '/use-cases' },
  { label: page.title },
]

const sections = [
  {
    "heading": "Signups, activation, and the gap",
    "body": "Signup counts are the number everybody has and the number nobody acts on. The useful report is the step after it: how many of those accounts did the thing your product exists to do, and how long it took them."
  },
  {
    "heading": "Funnels that keep whole people",
    "body": "When data is sampled, sampling is decided per subject rather than per event, using a hash of the subject id. Either all of a person’s events are kept or none are. Sampling events independently is what turns a funnel into nonsense, because a person can then appear at step three and not at step one."
  },
  {
    "heading": "Cohorts by the properties you send",
    "body": "Filter a whole report by plan, source or any property you attach to the events, and the URL carries the filter, so the narrowed view is the thing you paste into a conversation rather than a screenshot of it."
  },
  {
    "heading": "Comparisons that admit their limits",
    "body": "A week-on-week comparison against a week that did not exist says so. For a young product, that is most of the comparisons, and inventing percentages for them is how a launch looks like a rocket."
  }
]
</script>

<template>
