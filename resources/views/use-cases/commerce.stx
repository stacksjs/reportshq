<script server>
import { metaTitleFor, pageFor } from '~/app/Marketing/pages'

const page = pageFor('use-cases', 'commerce')!
const canonical = 'https://reportshq.org/use-cases/commerce'

useSeoMeta({
  title: metaTitleFor(page.title),
  description: page.description,
  canonical,
  ogUrl: canonical,
  ogTitle: page.title,
  ogDescription: page.description,
  ogType: 'article',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-3xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Use cases', href: '/use-cases' },
  { label: page.title },
]

const sections = [
  {
    "heading": "Point it at Order and it starts talking",
    "body": "Revenue over time, orders per day, average order value, and revenue by product, from naming one model and its total. No tracking calls, no event names, no waiting for data to accumulate before a chart means anything."
  },
  {
    "heading": "The history is already there",
    "body": "Because it reads your tables, the first report covers everything you have ever sold. A collector starts at zero on the day you install it and cannot tell you about last year."
  },
  {
    "heading": "Refunds and cancellations count correctly",
    "body": "A refund is a row in your database with a status your domain understands, so it is subtracted where it should be. A stream of events has to be told, and gets it wrong the first time somebody refunds through the admin instead of the API."
  },
  {
    "heading": "Per product, without counting an order twice",
    "body": "Revenue by product joins line items, and joining multiplies. The compiler knows that measure belongs to the line and refuses to sum an order total across it, which is exactly the mistake a hand written query makes silently."
  },
  {
    "heading": "Send it to whoever needs it",
    "body": "A weekly total to the founders on Monday morning in their own timezone, a link a supplier can open with no account, or a spreadsheet somebody wants to pivot themselves."
  }
]
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    @include('SiteNav')
    @include('Breadcrumbs')

    <main class="mx-auto px-6 py-10 max-w-3xl">
      <h1 class="font-semibold text-4xl tracking-tighter md:text-5xl">{{ page.title }}</h1>
      <p class="mt-5 leading-relaxed text-lg text-muted">{{ page.description }}</p>

      <div class="grid gap-10 mt-14">
        @foreach (sections as section)
          <section>
            <h2 class="font-semibold text-ink text-xl tracking-tight">{{ section.heading }}</h2>
            <p class="mt-3 leading-relaxed text-muted">{{ section.body }}</p>
          </section>
        @endforeach
      </div>

      {{-- The closing call to action, identical on all four use-case pages but
           for its copy. <Card> owns the fill, the border and the padding; the
           radius stays `rounded-2xl`, because 16px is this app's marketing
           radius (17 sites) rather than the 12px `rounded-panel` the dashboard
           uses. `!` because className is appended to the class ATTRIBUTE and
           attribute order does not decide CSS: `rounded-2xl` and the component's
           own `rounded-panel` are single-class selectors of equal specificity,
           so without it the winner is whichever crosswind emits later. --}}
      <Card padding="lg" className="mt-16 !rounded-2xl">
        <h2 class="font-semibold text-xl tracking-tight">Point it at your orders</h2>
        <p class="mt-2 leading-relaxed text-muted text-sm">
          If your shop already fires an event when an order is created, the first commerce report builds itself.
        </p>
        <StxLink to="/register" class="inline-block mt-5 px-4 py-2.5 font-medium no-underline text-accent-ink text-sm bg-accent rounded-lg">
          Start free
        </StxLink>
      </Card>
    </main>

    @include('SiteFooter')
  </div>
</template>
