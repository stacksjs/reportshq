<script server>
// The account page.
//
// Deliberately small. It holds the things that are true about a person rather
// than about a project: who they are, and how to stop being signed in. Team
// billing arrives with #17.
import { db as __db } from '@stacksjs/database'
import { sessionFrom } from '../../../app/Support/session'

const session = await sessionFrom(typeof cookies !== 'undefined' ? cookies : undefined)
const user = session.user

// When the account was opened. Shown because "member since" is the one fact a
// person cannot look up anywhere else in the product.
const row = user
  ? (await __db.unsafe(`SELECT created_at FROM users WHERE id = $1`, [user.id]))?.[0] as { created_at?: string } | undefined
  : undefined

function joinedLabel(value: unknown): string {
  const raw = String(value ?? '').trim()
  if (!raw)
    return ''

  const parsed = new Date(raw.includes('T') ? raw : `${raw.replace(' ', 'T')}Z`)
  if (Number.isNaN(parsed.getTime()))
    return ''

  return parsed.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
}

const since = joinedLabel(row?.created_at)
</script>

<template>
  <div class="min-h-[100dvh] text-ink bg-canvas">
    @include('AppNav')

    <main class="mx-auto px-6 py-10 max-w-2xl">
      {{-- The server is the only side that can see the HttpOnly session cookie,
           so it decides here. A visitor it could not identify is shown a way in
           rather than a page of empty fields — and the panel below is never
           rendered for them, so nothing dereferences a null user. --}}
      @if (user)
        <h1 class="font-semibold text-2xl tracking-tight">Account</h1>
        <p class="mb-8 mt-1 text-muted text-sm">Who you are here, and how to sign out.</p>

        <div class="bg-panel border border-line divide-line divide-y rounded-xl">
          <div class="flex gap-4 items-baseline justify-between px-5 py-4">
            <span class="text-muted text-sm">Name</span>
            <span class="text-ink text-sm">{{ user.name }}</span>
          </div>
          <div class="flex gap-4 items-baseline justify-between px-5 py-4">
            <span class="text-muted text-sm">Email</span>
            <span class="text-ink text-sm">{{ user.email }}</span>
          </div>
          @if (since)
            <div class="flex gap-4 items-baseline justify-between px-5 py-4">
              <span class="text-muted text-sm">Member since</span>
              <span class="text-ink text-sm">{{ since }}</span>
            </div>
          @endif
        </div>

        <div class="mt-6 p-5 border border-line rounded-xl">
          <h2 class="font-medium text-sm">Sign out</h2>
          <p class="mb-4 mt-1 max-w-[60ch] text-muted text-sm">
            This ends the session everywhere it was being used, not just in this tab. The token is
            revoked rather than forgotten, so a copy of it stops working too.
          </p>
          <button
            id="signout"
            type="button"
            class="px-4 py-2 font-medium text-ink text-sm border border-line rounded-lg hover:border-accent"
          >Sign out</button>
        </div>
      @else
        <h1 class="font-semibold text-2xl tracking-tight">Account</h1>
        <p class="mb-8 mt-1 text-muted text-sm">You are not signed in.</p>

        <div class="p-5 border border-line rounded-xl">
          <p class="max-w-[60ch] text-muted text-sm">
            Sign in to see who you are here and to manage your session.
          </p>
          <a
            href="/login"
            class="inline-flex items-center mt-4 px-4 py-2 font-medium no-underline text-accent-ink text-sm bg-accent rounded-lg"
          >Sign in</a>
        </div>
      @endif
    </main>
  </div>

<script>
(function () {
  var button = document.getElementById('signout')
  if (!button) return

  button.addEventListener('click', function () {
    button.disabled = true
    button.textContent = 'Signing out'

    fetch('/api/auth/logout', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: '{}',
    }).then(function () {
      // replace rather than assign: the back button should not return to a
      // page belonging to a session that no longer exists.
      window.location.replace('/login')
    }).catch(function () {
      button.disabled = false
      button.textContent = 'Sign out'
    })
  })
}())
</script>
</template>
