<script server>
// The embed variant of a shared report.
//
// Same data and the same narrow authority as /s: one report's published
// snapshot and nothing around it. What differs is chrome. This renders inside
// somebody else's page, so it drops the heading, the range picker and the
// padding, and keeps only the blocks and, unless the plan removed it, a small
// attribution.
//
// The framing headers are set on the route rather than here: this is the one
// part of the app that may be put in an iframe, and the rest stays deny.
import { runQuery } from '../../app/Reports/engine'
import { describeCaveat, describeQuery } from '../../app/Reports/describe'
import { publishedBlocks } from '../../app/Reports/reports'
import { recordView, shareByToken } from '../../app/Reports/shares'
import { param } from '../../app/Support/session'

// stx serves this file at /s, with the token as a query parameter. A path
// segment would be prettier; a working link matters more, and the token is the
// credential either way.
const token = param(query, 't') ?? param(query, 'token') ?? ''
const share = token ? await shareByToken(token) : null
const found = share !== null

// A range the reader may change, bounded to the same closed list the signed-in
// viewer uses. Anything else falls back to the report's own default rather than
// erroring: a mistyped link should still show the report.
const RANGES = [
  { key: 'last_7_days', label: '7 days' },
  { key: 'last_14_days', label: '14 days' },
  { key: 'last_30_days', label: '30 days' },
  { key: 'last_90_days', label: '90 days' },
]

const requested = param(query, 'range')
const activeRange = RANGES.find(entry => entry.key === requested)?.key ?? String(share?.defaultRange ?? 'last_30_days')

const blocks = found ? (await publishedBlocks(share!.reportId)) ?? [] : []

const rendered: Array<Record<string, unknown>> = []
for (const block of blocks) {
  const kind = String(block.kind)
  const base = {
    kind,
    title: block.title ? String(block.title) : '',
    body: block.body ? String(block.body) : '',
    span: Math.max(1, Math.min(12, Number(block.w) || 6)),
    height: Math.max(120, (Number(block.h) || 4) * 56),
    explains: kind === 'text' ? '' : describeQuery(block.query as never),
    caveat: kind === 'text' ? '' : describeCaveat(block.query as never),
    result: null as unknown,
    error: '',
  }

  if (kind === 'text') {
    rendered.push(base)
    continue
  }

  try {
    base.result = await runQuery({
      projectId: share!.projectId,
      timezone: share!.timezone,
      range: activeRange,
      query: block.query as never,
    })
  }
  catch {
    // Deliberately not the message. A signed-in viewer gets the engine's
    // reason because they can act on it; a stranger would only learn about
    // our internals.
    base.error = 'This block could not be drawn.'
  }

  rendered.push(base)
}

// Counted after the work, never awaited before it: a counter is not worth a
// millisecond of somebody's page load.
if (found)
  void recordView(share!.shareId)

</script>

<template>
  <div class="min-h-[100dvh] bg-canvas text-ink">
    {{-- Tighter than /s: an embed is inside somebody else's layout, which is
         already providing the page's margins. --}}
    <main class="p-4">
      @if (!found)
        {{-- One answer for revoked, expired, unpublished and never-existed.
             Telling them apart tells somebody whether they once had access. --}}
        <div class="px-4 py-10 text-center rounded-xl border border-line bg-panel">
          <p class="text-sm text-muted">This embed is not available.</p>
        </div>
      @else
        @if (rendered.length === 0)
          <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
            <h2 class="text-base font-medium">This report has no blocks</h2>
          </div>
        @else
          <div class="grid grid-cols-12 gap-4">
            @foreach (rendered as block)
              <div class="col-span-12 md:col-span-{{ block.span }}">
                <div class="p-5 rounded-xl border border-line bg-panel">
                  <div style="min-height: {{ block.height }}px">
                  @if (block.error)
                    <p class="text-sm font-medium text-ink">{{ block.title }}</p>
                    <p class="mt-2 text-sm text-warn">{{ block.error }}</p>
                  @elseif (block.kind === 'text')
                    <TextBlock title="{{ block.title }}" body="{{ block.body }}" />
                  @elseif (block.kind === 'big_number')
                    <BigNumber :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'bar')
                    <BarChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'donut')
                    <DonutChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'table')
                    <TableChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'funnel')
                    <FunnelChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'heatmap')
                    <HeatmapChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'area')
                    <LineChart :result="block.result" title="{{ block.title }}" variant="area" />
                  @else
                    <LineChart :result="block.result" title="{{ block.title }}" />
                  @endif
                  </div>

                  @if (block.explains)
                    <details class="mt-3">
                      <summary class="text-xs cursor-pointer text-subtle">What is this?</summary>
                      <p class="mt-2 text-xs leading-relaxed text-muted">{{ block.explains }}</p>
                      @if (block.caveat)
                        <p class="mt-1 text-xs leading-relaxed text-subtle">{{ block.caveat }}</p>
                      @endif
                    </details>
                  @endif
                </div>
              </div>
            @endforeach
          </div>
        @endif

        @if (share.showBranding)
          <p class="mt-4 text-xs text-right text-subtle">
            <a href="https://reportshq.org" target="_blank" rel="noopener" class="text-subtle hover:text-ink">Made with ReportsHQ</a>
          </p>
        @endif
      @endif
    </main>
  </div>
</template>
