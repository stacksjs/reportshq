<script server>
// Every chart component, against the real engine and the real demo project.
//
// Not fixtures: a chart built against flat, uniform data looks fine and then
// falls apart the first time it meets a real project, and the seed deliberately
// has weekday and weekend variation, refunds, and a long tail of properties.
//
// This is the review surface for the design pre-flight, and the page where a
// palette or spacing change is judged in both themes at once.
import { db } from '@stacksjs/database'
import { runQuery } from '../../app/Reports/engine'

const project = (await db.unsafe(
  `SELECT id, timezone FROM projects WHERE name = $1 AND deleted_at IS NULL LIMIT 1`,
  ['Northwind Supply'],
))?.[0] as { id: number, timezone: string } | undefined

const projectId = Number(project?.id ?? 0)
const timezone = String(project?.timezone ?? 'UTC')

async function ask(query: Record<string, unknown>): Promise<any> {
  if (!projectId)
    return { series: [], total: 0, grain: 'day', range: { from: '', to: '' } }

  return await runQuery({ projectId, timezone, range: 'last_30_days', query: query as never })
}

const revenue = await ask({ events: ['commerce.order.created'], measure: 'sum', field: 'value', filters: [], grain: 'day', compare: true })
const orders = await ask({ events: ['commerce.order.created'], measure: 'count', filters: [], grain: 'day', compare: true })
const refunds = await ask({ events: ['commerce.order.refunded'], measure: 'sum', field: 'value', filters: [], grain: 'day', compare: true })
const averageOrder = await ask({ events: ['commerce.order.created'], measure: 'avg', field: 'value', filters: [] })
const byPlan = await ask({ events: ['commerce.order.created'], measure: 'count', dimension: 'properties.plan', filters: [], grain: 'day' })
const bySource = await ask({ events: ['user.registered'], measure: 'count', dimension: 'properties.source', filters: [], grain: 'day' })
const signups = await ask({ events: ['user.registered'], measure: 'count', filters: [], grain: 'day' })
const funnel = await ask({
  events: [],
  measure: 'count',
  filters: [],
  steps: ['commerce.product.viewed', 'commerce.checkout.started', 'commerce.order.created'],
})
const activity = await ask({ events: [], measure: 'count', dimension: 'name', filters: [], grain: 'day', limit: 4 })
const empty = await ask({ events: ['nothing.ever.happened'], measure: 'count', filters: [], grain: 'day' })

const missingSeed = !projectId
</script>

<template>
  <div class="min-h-[100dvh] bg-canvas text-ink">
    <div class="px-6 py-16 mx-auto max-w-6xl">
      <header class="mb-12">
        <Wordmark size="lg" />
        <h1 class="mt-8 text-3xl font-semibold tracking-tight md:text-4xl">Chart gallery</h1>
        <p class="mt-3 max-w-[65ch] text-muted leading-relaxed">
          Every chart component, rendered on the server from the real query engine against the demo
          project. Switch your system between light and dark: the marks read from the same tokens,
          so nothing here is re-rendered to follow a theme.
        </p>
      </header>

      @if (missingSeed)
        <div class="p-5 rounded-xl border border-line bg-panel">
          <p class="text-sm text-ink">The demo project is missing.</p>
          <p class="mt-1 text-sm text-muted">
            Run <span class="font-mono text-xs">bun scripts/seed-demo.ts</span> to build it, then reload.
          </p>
        </div>
      @else
        <section class="mb-12">
          <h2 class="mb-4 text-lg font-semibold">Big numbers</h2>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div class="p-5 rounded-xl border border-line bg-panel">
              <BigNumber :result="revenue" title="Revenue" unit="currency" currency="EUR" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel">
              <BigNumber :result="orders" title="Orders" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel">
              <BigNumber :result="averageOrder" title="Average order" unit="currency" currency="EUR" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel">
              {{-- Down is good here, so the arrow and the tone disagree with
                   the sign on purpose. --}}
              <BigNumber :result="refunds" title="Refunded" unit="currency" currency="EUR" :invert="true" />
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="mb-4 text-lg font-semibold">Time series</h2>
          <div class="grid gap-4 lg:grid-cols-2">
            <div class="p-5 rounded-xl border border-line bg-panel">
              <LineChart :result="revenue" title="Revenue per day" variant="area" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel">
              <BarChart :result="signups" title="Signups per day" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel lg:col-span-2">
              <LineChart :result="byPlan" title="Orders per day, by plan" />
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="mb-4 text-lg font-semibold">Composition</h2>
          <div class="grid gap-4 lg:grid-cols-3">
            <div class="p-5 rounded-xl border border-line bg-panel">
              <DonutChart :result="byPlan" title="Orders by plan" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel">
              <DataTable :result="bySource" title="Signups by source" label="Source" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel">
              <FunnelChart :result="funnel" title="Browse to order" />
            </div>
          </div>
        </section>

        <section class="mb-12">
          <h2 class="mb-4 text-lg font-semibold">Density</h2>
          <div class="p-5 rounded-xl border border-line bg-panel">
            <HeatmapChart :result="activity" title="Events per day, by name" />
          </div>
        </section>

        <section class="mb-12">
          <h2 class="mb-4 text-lg font-semibold">Empty and prose</h2>
          <div class="grid gap-4 lg:grid-cols-2">
            <div class="p-5 h-56 rounded-xl border border-line bg-panel">
              <LineChart :result="empty" title="An event nobody sends" />
            </div>
            <div class="p-5 rounded-xl border border-line bg-panel">
              <TextBlock
                title="A note on the numbers"
                body="Revenue counts orders created, not orders paid. Refunds are subtracted separately rather than netted off, so a refunded order still appears on the day it was placed."
              />
            </div>
          </div>
        </section>
      @endif
    </div>
  </div>
</template>

<style>
/* Axis and tick text, in one place, so every chart agrees. Recessive by
 * design: the marks are the content, the scale is scaffolding. */
.chart-tick {
  font-family: var(--mono);
  font-size: 10px;
  fill: var(--text-3);
}
</style>
