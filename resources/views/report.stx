<script server>
// A published report: every block, run through the engine, drawn on the server.
//
// The range lives in the URL rather than in a cookie or component state, so a
// view is linkable. Someone pasting a link into a conversation is sharing what
// they are looking at, not a page that will resolve differently for the reader.
import { describeCaveat, describeQuery } from '../../app/Reports/describe'
import { db as __db } from '@stacksjs/database'
import { runQuery } from '../../app/Reports/engine'
import { config } from '@stacksjs/config'
import { publishedBlocks, reportBySlug } from '../../app/Reports/reports'
import { allowedRecipients, parseRecipients } from '../../app/Reports/schedules'
import { sharesFor } from '../../app/Reports/shares'
import { accessFor } from '../../app/Support/access'
import { param, sessionCookieName, sessionFrom } from '../../app/Support/session'

const session = await sessionFrom(cookies)
const cookieName = sessionCookieName()
const user = session.user
const authPending = session.stale

const projectId = Number(param(query, 'project') ?? 0)
const slug = param(query, 'slug') ?? ''

const access = user && projectId ? await accessFor(user, projectId) : null
const allowed = access !== null

const report = allowed && slug ? await reportBySlug(projectId, slug) : null
const found = report !== null

const RANGES = [
  { key: 'last_7_days', label: '7 days' },
  { key: 'last_14_days', label: '14 days' },
  { key: 'last_30_days', label: '30 days' },
  { key: 'last_90_days', label: '90 days' },
  { key: 'this_month', label: 'This month' },
]

// A token from a closed list, never whatever arrived. An unknown value falls
// back to the report's own default rather than erroring: a mistyped link should
// still show the report.
const requested = param(query, 'range')
const activeRange = RANGES.find(entry => entry.key === requested)?.key
  ?? String(report?.default_range ?? 'last_30_days')

// The **project's** timezone, read from the project.
//
// This used to be `report?.timezone`, and the reports table has no such column,
// so it silently resolved to UTC for every report on the instance. Day buckets,
// "last 30 days" boundaries and every comparison were computed in the wrong
// zone, and the numbers looked plausible enough that nothing complained: a
// scheduled email computing the same report in the project's real zone returned
// a different average, which is how it surfaced.
const projectRow = allowed
  ? (await __db.unsafe(`SELECT timezone FROM projects WHERE id = $1`, [projectId]))?.[0] as { timezone?: string } | undefined
  : undefined
const timezone = String(projectRow?.timezone ?? 'UTC')

// The published snapshot, never the draft. A teammate opening this while
// somebody is mid-drag in the builder sees the last thing that was deliberately
// published, which is the whole point of having a draft at all.
//
// Null and empty are different answers: null is "never published", empty is
// "somebody published an empty grid". Collapsing them would tell a person their
// report is broken when it is merely unfinished.
const snapshot = found ? await publishedBlocks(Number(report!.id)) : null
const neverPublished = found && snapshot === null
const blocks = snapshot ?? []

// The draft being ahead is only worth mentioning to somebody who can act on it.
const mayEdit = access?.role === 'owner' || access?.role === 'admin'
const draftAhead = mayEdit && Boolean(report?.unpublished_changes)
const editHref = `/report-edit?project=${projectId}&slug=${slug}`

// Sharing and scheduling, for somebody who can administer the project. Both
// read from the same domain modules the jobs and public pages use, so what is
// listed here is what actually exists rather than a second view of it.
const shares = mayEdit && found ? await sharesFor(Number(report!.id)) : []
const schedules = mayEdit && found
  ? await __db.unsafe(
      `SELECT id, cadence, hour, timezone, recipients, format, is_active, last_run_at, last_status
         FROM report_schedules WHERE report_id = $1 ORDER BY created_at DESC`,
      [Number(report!.id)],
    ) as Array<Record<string, unknown>>
  : []

const shareLinks = shares.map(share => ({
  id: Number(share.id),
  label: share.label ? String(share.label) : 'Untitled link',
  url: `${String(config.app.url ?? '').startsWith('http') ? config.app.url : `https://${config.app.url ?? 'reportshq.org'}`}/s?t=${String(share.token)}`,
  views: Number(share.view_count ?? 0),
  revoked: Boolean(share.revoked_at),
  expires: share.expires_at ? String(share.expires_at).slice(0, 10) : '',
}))

const scheduleRows = schedules.map(schedule => ({
  id: Number(schedule.id),
  // "Weekly at 08:00 Europe/Lisbon" reads as a sentence; "weekly / 8 / tz"
  // reads as a database row.
  summary: `${String(schedule.cadence)} at ${String(schedule.hour).padStart(2, '0')}:00 ${String(schedule.timezone)}`,
  recipients: parseRecipients(schedule.recipients).join(', '),
  format: String(schedule.format ?? 'link'),
  active: Boolean(schedule.is_active),
  lastRun: schedule.last_run_at ? String(schedule.last_run_at).slice(0, 16).replace('T', ' ') : 'never',
  lastStatus: schedule.last_status ? String(schedule.last_status) : '',
}))

const memberEmails = mayEdit && found
  ? [...(await allowedRecipients(projectId))].sort()
  : []
/**
 * "Published 14 Aug 2026, 01:59".
 *
 * The numbers in a report and the moment its layout was frozen are different
 * facts, and only one of them is on screen. Saying when it was published is
 * what stops somebody reading a six-month-old arrangement as current.
 */
function publishedLabel(value: unknown): string {
  const raw = String(value ?? '').trim()
  if (!raw)
    return ''

  // SQLite hands back "YYYY-MM-DD HH:MM:SS" in UTC, which Date only parses
  // reliably once it looks like an ISO instant.
  const parsed = new Date(raw.includes('T') ? raw : `${raw.replace(' ', 'T')}Z`)
  if (Number.isNaN(parsed.getTime()))
    return ''

  return parsed.toLocaleString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: timezone,
  })
}

const publishedAt = publishedLabel(report?.published_at)

// Every block runs against the same range. Sequential rather than parallel on
// purpose: the engine reads one SQLite file, and a report of eight blocks
// issuing eight concurrent scans is slower than doing them in order.
const rendered: Array<Record<string, unknown>> = []
for (const block of blocks) {
  const kind = String(block.kind)
  const base = {
    kind,
    title: block.title ? String(block.title) : '',
    body: block.body ? String(block.body) : '',
    // Every chart is an answer to a question nobody can see. Two blocks titled
    // "Revenue" can count different things, and a viewer cannot open the
    // builder to find out which.
    explains: kind === 'text' ? '' : describeQuery(block.query as never),
    caveat: kind === 'text' ? '' : describeCaveat(block.query as never),
    // 12 columns, so a block's width becomes a span the grid understands.
    span: Math.max(1, Math.min(12, Number(block.w) || 6)),
    height: Math.max(120, (Number(block.h) || 4) * 56),
    result: null as unknown,
    error: '',
  }

  if (kind === 'text') {
    rendered.push(base)
    continue
  }

  try {
    base.result = await runQuery({
      projectId,
      timezone,
      range: activeRange,
      query: block.query as never,
    })
  }
  catch (error) {
    // One bad block must not take the report with it. The message lands in the
    // block itself, where the person who can fix it is looking.
    base.error = (error as Error).message
  }

  rendered.push(base)
}

const rangeLinks = RANGES.map(entry => ({
  ...entry,
  href: `/report?project=${projectId}&slug=${slug}&range=${entry.key}`,
  active: entry.key === activeRange,
}))
</script>

<template>
  {{-- The guard is a plain script and cannot import; the name it must
       check is stamped here, from the same resolver the middleware uses.

       No quotes around the interpolation. stx JSON-encodes `{{ }}` inside a
       script block, so the value arrives already quoted; wrapping it again
       produced a cookie name containing literal quote characters, the guard
       looked for a cookie nobody had, and every signed-in visitor was bounced
       to /login. curl never caught it because curl does not run scripts. --}}
  <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>
  @include('AuthGuard')

  <div class="min-h-[100dvh] bg-canvas text-ink">
    {{-- What the guard reads. The server is the only side that can see the
         HttpOnly session cookie, so it is the side that decides. --}}
    @if (!user)
      <div id="auth-required" hidden></div>
    @endif
    @if (authPending)
      <div id="auth-pending" hidden></div>
    @endif

    @include('AppNav')

    <main class="px-6 py-10 mx-auto max-w-7xl">
      @if (!found)
        <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
          <h1 class="text-base font-medium">Report not found</h1>
          <p class="mt-1 text-sm text-muted">It may have been deleted, or it may not be yours.</p>
          <a href="/projects" class="inline-block mt-5 text-sm text-accent">Back to projects</a>
        </div>
      @else
        <nav class="mb-6 text-sm text-subtle">
          <a href="/projects" class="text-muted">Projects</a>
          <span class="mx-2">/</span>
          <a href="/project?id={{ projectId }}" class="text-muted">Project</a>
          <span class="mx-2">/</span>
          <span>{{ report.name }}</span>
        </nav>

        <div class="flex flex-wrap gap-4 justify-between items-end mb-8">
          <div>
            <h1 class="text-2xl font-semibold tracking-tight">{{ report.name }}</h1>
            @if (report.description)
              <p class="mt-1 max-w-[65ch] text-sm text-muted">{{ report.description }}</p>
            @endif
            @if (publishedAt)
              <p class="mt-1 text-xs text-subtle">Published {{ publishedAt }}</p>
            @endif
          </div>

          {{-- Plain links, so the range survives a reload, a back button and a
               paste into a message. --}}
          <div class="flex flex-wrap gap-1 items-center">
            @foreach (rangeLinks as link)
              @if (link.active)
                <span class="px-3 py-1.5 text-sm font-medium rounded-lg bg-accent-soft text-accent">{{ link.label }}</span>
              @else
                <a href="{{ link.href }}" class="px-3 py-1.5 text-sm no-underline rounded-lg text-muted hover:text-ink">{{ link.label }}</a>
              @endif
            @endforeach
          </div>
        </div>

        @if (draftAhead)
          {{-- A line rather than a banner. It matters to the one person who can
               publish, and it must not make a report look broken to everyone
               else looking over their shoulder. --}}
          <p class="flex flex-wrap gap-2 items-center px-4 py-3 mb-6 text-sm rounded-lg border border-line bg-panel text-muted">
            <i class="w-4 h-4 i-hugeicons-edit-02 text-subtle"></i>
            This report has changes that have not been published. Everyone else is seeing the version below.
            <a href="{{ editHref }}" class="text-accent">Open the builder</a>
          </p>
        @endif

        @if (neverPublished)
          <div class="px-6 py-16 text-center rounded-xl border border-dashed border-line">
            <h2 class="text-base font-medium">Not published yet</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
              Nobody outside the builder can see this report until it is published. Its blocks and
              numbers are all in place, waiting.
            </p>
            @if (mayEdit)
              <a href="{{ editHref }}" class="inline-block mt-5 text-sm text-accent">Open the builder</a>
            @endif
          </div>
        @elseif (rendered.length === 0)
          <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
            <h2 class="text-base font-medium">This report was published with no blocks</h2>
            <p class="mt-1 text-sm text-muted">Open it in the builder to add one, then publish again.</p>
          </div>
        @else
          <div class="grid grid-cols-12 gap-4">
            @foreach (rendered as block)
              {{-- The reserved height belongs to the chart, not to the card.

                   It used to sit on the card as `h-full` plus a min-height,
                   which meant the card's height came from the grid row and its
                   own content could not lengthen it: expanding a block's
                   explanation spilled the text over the block below. Flex
                   variants of the same idea fail the same way from the other
                   direction, because a flex child under-reports its intrinsic
                   height to the row. Reserving the space on the chart instead
                   makes the card simply as tall as what is in it. --}}
              <div class="col-span-12 md:col-span-{{ block.span }}">
                <div class="p-5 rounded-xl border border-line bg-panel">
                  <div style="min-height: {{ block.height }}px">
                  @if (block.error)
                    <p class="text-sm font-medium text-ink">{{ block.title }}</p>
                    <p class="mt-2 text-sm text-warn">{{ block.error }}</p>
                  @elseif (block.kind === 'text')
                    <TextBlock title="{{ block.title }}" body="{{ block.body }}" />
                  @elseif (block.kind === 'big_number')
                    <BigNumber :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'bar')
                    <BarChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'donut')
                    <DonutChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'table')
                    <DataTable :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'funnel')
                    <FunnelChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'heatmap')
                    <HeatmapChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'area')
                    <LineChart :result="block.result" title="{{ block.title }}" variant="area" />
                  @else
                    <LineChart :result="block.result" title="{{ block.title }}" />
                  @endif
                  </div>

                  @if (block.explains)
                    {{-- A details element rather than a hover popover: it works
                         with a keyboard and a finger, it survives being read
                         aloud, and it does not cover the chart it describes. --}}
                    <details class="mt-3 explain">
                      <summary class="text-xs cursor-pointer text-subtle">What is this?</summary>
                      <p class="mt-2 text-xs leading-relaxed text-muted">{{ block.explains }}</p>
                      @if (block.caveat)
                        <p class="mt-1 text-xs leading-relaxed text-subtle">{{ block.caveat }}</p>
                      @endif
                    </details>
                  @endif
                </div>
              </div>
            @endforeach
          </div>
        @endif

        @if (mayEdit)
          {{-- Sharing and scheduling, below the report rather than above it.
               Somebody opening a report came to read it; distribution is what
               they do afterwards, and putting it first would push the numbers
               under the fold. --}}
          <section class="grid gap-6 mt-12 lg:grid-cols-2">
            <div class="p-5 rounded-xl border border-line bg-panel">
              <h2 class="text-sm font-medium">Share links</h2>
              <p class="mt-1 mb-4 text-sm text-muted">
                A link shows this report's published version to anyone who opens it, with no account.
              </p>

              @if (shareLinks.length === 0)
                <p class="mb-4 text-sm text-subtle">No links yet.</p>
              @else
                <ul class="grid gap-2 mb-4 list-none">
                  @foreach (shareLinks as link)
                    <li class="p-3 rounded-lg border border-line bg-canvas">
                      <div class="flex flex-wrap gap-2 justify-between items-baseline">
                        <span class="text-sm text-ink">{{ link.label }}</span>
                        @if (link.revoked)
                          <span class="text-xs text-subtle">revoked</span>
                        @else
                          <span class="text-xs text-subtle">{{ link.views }} views</span>
                        @endif
                      </div>
                      @if (!link.revoked)
                        <code class="block mt-1 text-xs break-all text-muted">{{ link.url }}</code>
                        <div class="flex gap-3 mt-2">
                          <button type="button" class="text-xs copy-share text-accent" data-url="{{ link.url }}">Copy</button>
                          <button type="button" class="text-xs rotate-share text-muted hover:text-ink" data-id="{{ link.id }}">Rotate</button>
                          <button type="button" class="text-xs revoke-share text-subtle hover:text-neg" data-id="{{ link.id }}">Revoke</button>
                        </div>
                      @endif
                    </li>
                  @endforeach
                </ul>
              @endif

              <button id="new-share" type="button" class="px-3 py-2 text-sm font-medium rounded-lg bg-accent text-accent-ink">
                Create a link
              </button>
            </div>

            <div class="p-5 rounded-xl border border-line bg-panel">
              <h2 class="text-sm font-medium">Scheduled delivery</h2>
              <p class="mt-1 mb-4 text-sm text-muted">
                The headline numbers by email, on a cadence, to people on this project.
              </p>

              @if (scheduleRows.length === 0)
                <p class="mb-4 text-sm text-subtle">Nothing scheduled.</p>
              @else
                <ul class="grid gap-2 mb-4 list-none">
                  @foreach (scheduleRows as row)
                    <li class="p-3 rounded-lg border border-line bg-canvas">
                      <div class="flex flex-wrap gap-2 justify-between items-baseline">
                        <span class="text-sm text-ink">{{ row.summary }}</span>
                        <span class="text-xs {{ row.active ? 'text-subtle' : 'text-warn' }}">
                          {{ row.active ? row.format : 'paused' }}
                        </span>
                      </div>
                      <p class="mt-1 text-xs text-muted">{{ row.recipients }}</p>
                      {{-- The outcome of the last run, said plainly. A schedule
                           that is failing should say so where somebody looks,
                           not only in a log. --}}
                      <p class="mt-1 text-xs text-subtle">Last run: {{ row.lastRun }}{{ row.lastStatus ? ' - ' + row.lastStatus : '' }}</p>
                      <div class="flex gap-3 mt-2">
                        <button type="button" class="text-xs toggle-schedule text-muted hover:text-ink" data-id="{{ row.id }}">
                          {{ row.active ? 'Pause' : 'Resume' }}
                        </button>
                        <button type="button" class="text-xs remove-schedule text-subtle hover:text-neg" data-id="{{ row.id }}">Remove</button>
                      </div>
                    </li>
                  @endforeach
                </ul>
              @endif

              <form id="new-schedule" class="grid gap-2">
                <div class="grid grid-cols-2 gap-2">
                  <label class="block">
                    <span class="block mb-1 text-xs text-subtle">Cadence</span>
                    <select id="cadence" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                      <option value="weekly">Weekly</option>
                      <option value="daily">Daily</option>
                      <option value="monthly">Monthly</option>
                    </select>
                  </label>
                  <label class="block">
                    <span class="block mb-1 text-xs text-subtle">Hour</span>
                    <input id="hour" type="number" min="0" max="23" value="8" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink" />
                  </label>
                </div>

                <label class="block">
                  <span class="block mb-1 text-xs text-subtle">Recipients</span>
                  {{-- Chosen from the project, not typed. Only members may
                       receive a report, and a picker makes that a fact rather
                       than a validation error somebody meets afterwards. --}}
                  <select id="recipients" multiple size="3" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                    @foreach (memberEmails as address)
                      <option value="{{ address }}">{{ address }}</option>
                    @endforeach
                  </select>
                </label>

                <label class="block">
                  <span class="block mb-1 text-xs text-subtle">Attach</span>
                  <select id="format" class="px-2 py-1.5 w-full text-sm rounded-lg border border-line bg-canvas text-ink">
                    <option value="link">Nothing, just the link</option>
                    <option value="csv">CSV</option>
                    <option value="xlsx">XLSX</option>
                  </select>
                </label>

                <button type="submit" class="px-3 py-2 mt-1 text-sm font-medium rounded-lg bg-accent text-accent-ink">
                  Schedule it
                </button>
              </form>
            </div>
          </section>

          <p id="dist-error" class="mt-4 text-sm text-warn" hidden></p>
        @endif
      @endif
    </main>
  </div>

{{-- Sharing and scheduling.

     A plain script, like the rest of this app's interactive surfaces: it runs
     before the runtime and touches the DOM directly. Every call goes to the
     builder's write surface, which is CSRF-exempt by design and scoped to a
     report the caller already reached through its project. --}}
<script>
(function () {
  var params = new URLSearchParams(window.location.search)
  var currentProject = params.get('project')
  var currentSlug = params.get('slug')
  if (!currentProject || !currentSlug) return

  var error = document.getElementById('dist-error')

  function fail(message) {
    if (!error) return
    error.textContent = message || ''
    error.hidden = !message
  }

  function post(path, extra) {
    var payload = { project: Number(currentProject), slug: currentSlug }
    for (var key in extra) payload[key] = extra[key]

    return fetch('/api/reports/' + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify(payload),
    })
  }

  function reloadOr(res, message) {
    if (res.ok) {
      window.location.reload()
      return
    }
    return res.json().then(function (data) {
      // The server's own message, which for a plan limit names the tier that
      // would lift it and for a recipient names the address to remove.
      fail((data && data.message) || message)
    }).catch(function () { fail(message) })
  }

  var newShare = document.getElementById('new-share')
  if (newShare) {
    newShare.addEventListener('click', function () {
      fail('')
      post('shares/create', { label: 'Shared link' })
        .then(function (res) { return reloadOr(res, 'Could not create that link.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  }

  Array.prototype.forEach.call(document.querySelectorAll('.copy-share'), function (button) {
    button.addEventListener('click', function () {
      var url = button.dataset.url
      // The clipboard API needs a secure context, which a local install over
      // plain HTTP is not. Saying so beats a button that silently does nothing.
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(url).then(function () {
          button.textContent = 'Copied'
          setTimeout(function () { button.textContent = 'Copy' }, 1500)
        })
        return
      }
      window.prompt('Copy this link', url)
    })
  })

  Array.prototype.forEach.call(document.querySelectorAll('.rotate-share'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      // No confirmation: the list says what happened and a new link is one
      // click away. The old URL stops working, which is the point.
      post('shares/rotate', { id: Number(button.dataset.id) })
        .then(function (res) { return reloadOr(res, 'Could not rotate that link.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  Array.prototype.forEach.call(document.querySelectorAll('.revoke-share'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      post('shares/revoke', { id: Number(button.dataset.id) })
        .then(function (res) { return reloadOr(res, 'Could not revoke that link.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  Array.prototype.forEach.call(document.querySelectorAll('.toggle-schedule'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      post('schedules/toggle', { id: Number(button.dataset.id) })
        .then(function (res) { return reloadOr(res, 'Could not change that schedule.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  Array.prototype.forEach.call(document.querySelectorAll('.remove-schedule'), function (button) {
    button.addEventListener('click', function () {
      fail('')
      post('schedules/remove', { id: Number(button.dataset.id) })
        .then(function (res) { return reloadOr(res, 'Could not remove that schedule.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  })

  var scheduleForm = document.getElementById('new-schedule')
  if (scheduleForm) {
    scheduleForm.addEventListener('submit', function (event) {
      event.preventDefault()
      fail('')

      var chosen = Array.prototype.slice.call(document.getElementById('recipients').selectedOptions)
        .map(function (option) { return option.value })

      if (chosen.length === 0) {
        fail('Choose at least one person to send it to.')
        return
      }

      post('schedules/create', {
        cadence: document.getElementById('cadence').value,
        hour: Number(document.getElementById('hour').value),
        format: document.getElementById('format').value,
        recipients: chosen,
      })
        .then(function (res) { return reloadOr(res, 'Could not create that schedule.') })
        .catch(function () { fail('Could not reach the server.') })
    })
  }
}())
</script>
</template>
