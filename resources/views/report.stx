<script server>
// A published report: every block, run through the engine, drawn on the server.
//
// The range lives in the URL rather than in a cookie or component state, so a
// view is linkable. Someone pasting a link into a conversation is sharing what
// they are looking at, not a page that will resolve differently for the reader.
import { runQuery } from '../../app/Reports/engine'
import { publishedBlocks, reportBySlug } from '../../app/Reports/reports'
import { accessFor } from '../../app/Support/access'
import { param, sessionCookieName, sessionFrom } from '../../app/Support/session'

const session = await sessionFrom(cookies)
const cookieName = sessionCookieName()
const user = session.user
const authPending = session.stale

const projectId = Number(param(query, 'project') ?? 0)
const slug = param(query, 'slug') ?? ''

const access = user && projectId ? await accessFor(user, projectId) : null
const allowed = access !== null

const report = allowed && slug ? await reportBySlug(projectId, slug) : null
const found = report !== null

const RANGES = [
  { key: 'last_7_days', label: '7 days' },
  { key: 'last_14_days', label: '14 days' },
  { key: 'last_30_days', label: '30 days' },
  { key: 'last_90_days', label: '90 days' },
  { key: 'this_month', label: 'This month' },
]

// A token from a closed list, never whatever arrived. An unknown value falls
// back to the report's own default rather than erroring: a mistyped link should
// still show the report.
const requested = param(query, 'range')
const activeRange = RANGES.find(entry => entry.key === requested)?.key
  ?? String(report?.default_range ?? 'last_30_days')

const timezone = String(report?.timezone ?? 'UTC')

// The published snapshot, never the draft. A teammate opening this while
// somebody is mid-drag in the builder sees the last thing that was deliberately
// published, which is the whole point of having a draft at all.
//
// Null and empty are different answers: null is "never published", empty is
// "somebody published an empty grid". Collapsing them would tell a person their
// report is broken when it is merely unfinished.
const snapshot = found ? await publishedBlocks(Number(report!.id)) : null
const neverPublished = found && snapshot === null
const blocks = snapshot ?? []

// The draft being ahead is only worth mentioning to somebody who can act on it.
const mayEdit = access?.role === 'owner' || access?.role === 'admin'
const draftAhead = mayEdit && Boolean(report?.unpublished_changes)
const editHref = `/report-edit?project=${projectId}&slug=${slug}`
/**
 * "Published 14 Aug 2026, 01:59".
 *
 * The numbers in a report and the moment its layout was frozen are different
 * facts, and only one of them is on screen. Saying when it was published is
 * what stops somebody reading a six-month-old arrangement as current.
 */
function publishedLabel(value: unknown): string {
  const raw = String(value ?? '').trim()
  if (!raw)
    return ''

  // SQLite hands back "YYYY-MM-DD HH:MM:SS" in UTC, which Date only parses
  // reliably once it looks like an ISO instant.
  const parsed = new Date(raw.includes('T') ? raw : `${raw.replace(' ', 'T')}Z`)
  if (Number.isNaN(parsed.getTime()))
    return ''

  return parsed.toLocaleString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: timezone,
  })
}

const publishedAt = publishedLabel(report?.published_at)

// Every block runs against the same range. Sequential rather than parallel on
// purpose: the engine reads one SQLite file, and a report of eight blocks
// issuing eight concurrent scans is slower than doing them in order.
const rendered: Array<Record<string, unknown>> = []
for (const block of blocks) {
  const kind = String(block.kind)
  const base = {
    kind,
    title: block.title ? String(block.title) : '',
    body: block.body ? String(block.body) : '',
    // 12 columns, so a block's width becomes a span the grid understands.
    span: Math.max(1, Math.min(12, Number(block.w) || 6)),
    height: Math.max(120, (Number(block.h) || 4) * 56),
    result: null as unknown,
    error: '',
  }

  if (kind === 'text') {
    rendered.push(base)
    continue
  }

  try {
    base.result = await runQuery({
      projectId,
      timezone,
      range: activeRange,
      query: block.query as never,
    })
  }
  catch (error) {
    // One bad block must not take the report with it. The message lands in the
    // block itself, where the person who can fix it is looking.
    base.error = (error as Error).message
  }

  rendered.push(base)
}

const rangeLinks = RANGES.map(entry => ({
  ...entry,
  href: `/report?project=${projectId}&slug=${slug}&range=${entry.key}`,
  active: entry.key === activeRange,
}))
</script>

<template>
  {{-- The guard is a plain script and cannot import; the name it must
       check is stamped here, from the same resolver the middleware uses.

       No quotes around the interpolation. stx JSON-encodes `{{ }}` inside a
       script block, so the value arrives already quoted; wrapping it again
       produced a cookie name containing literal quote characters, the guard
       looked for a cookie nobody had, and every signed-in visitor was bounced
       to /login. curl never caught it because curl does not run scripts. --}}
  <script>document.documentElement.setAttribute('data-session-cookie', {{ cookieName }})</script>
  @include('AuthGuard')

  <div class="min-h-[100dvh] bg-canvas text-ink">
    {{-- What the guard reads. The server is the only side that can see the
         HttpOnly session cookie, so it is the side that decides. --}}
    @if (!user)
      <div id="auth-required" hidden></div>
    @endif
    @if (authPending)
      <div id="auth-pending" hidden></div>
    @endif

    @include('AppNav')

    <main class="px-6 py-10 mx-auto max-w-7xl">
      @if (!found)
        <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
          <h1 class="text-base font-medium">Report not found</h1>
          <p class="mt-1 text-sm text-muted">It may have been deleted, or it may not be yours.</p>
          <a href="/projects" class="inline-block mt-5 text-sm text-accent">Back to projects</a>
        </div>
      @else
        <nav class="mb-6 text-sm text-subtle">
          <a href="/projects" class="text-muted">Projects</a>
          <span class="mx-2">/</span>
          <a href="/project?id={{ projectId }}" class="text-muted">Project</a>
          <span class="mx-2">/</span>
          <span>{{ report.name }}</span>
        </nav>

        <div class="flex flex-wrap gap-4 justify-between items-end mb-8">
          <div>
            <h1 class="text-2xl font-semibold tracking-tight">{{ report.name }}</h1>
            @if (report.description)
              <p class="mt-1 max-w-[65ch] text-sm text-muted">{{ report.description }}</p>
            @endif
            @if (publishedAt)
              <p class="mt-1 text-xs text-subtle">Published {{ publishedAt }}</p>
            @endif
          </div>

          {{-- Plain links, so the range survives a reload, a back button and a
               paste into a message. --}}
          <div class="flex flex-wrap gap-1 items-center">
            @foreach (rangeLinks as link)
              @if (link.active)
                <span class="px-3 py-1.5 text-sm font-medium rounded-lg bg-accent-soft text-accent">{{ link.label }}</span>
              @else
                <a href="{{ link.href }}" class="px-3 py-1.5 text-sm no-underline rounded-lg text-muted hover:text-ink">{{ link.label }}</a>
              @endif
            @endforeach
          </div>
        </div>

        @if (draftAhead)
          {{-- A line rather than a banner. It matters to the one person who can
               publish, and it must not make a report look broken to everyone
               else looking over their shoulder. --}}
          <p class="flex flex-wrap gap-2 items-center px-4 py-3 mb-6 text-sm rounded-lg border border-line bg-panel text-muted">
            <i class="w-4 h-4 i-hugeicons-edit-02 text-subtle"></i>
            This report has changes that have not been published. Everyone else is seeing the version below.
            <a href="{{ editHref }}" class="text-accent">Open the builder</a>
          </p>
        @endif

        @if (neverPublished)
          <div class="px-6 py-16 text-center rounded-xl border border-dashed border-line">
            <h2 class="text-base font-medium">Not published yet</h2>
            <p class="mx-auto mt-1 max-w-sm text-sm text-muted">
              Nobody outside the builder can see this report until it is published. Its blocks and
              numbers are all in place, waiting.
            </p>
            @if (mayEdit)
              <a href="{{ editHref }}" class="inline-block mt-5 text-sm text-accent">Open the builder</a>
            @endif
          </div>
        @elseif (rendered.length === 0)
          <div class="px-6 py-16 text-center rounded-xl border border-line bg-panel">
            <h2 class="text-base font-medium">This report was published with no blocks</h2>
            <p class="mt-1 text-sm text-muted">Open it in the builder to add one, then publish again.</p>
          </div>
        @else
          <div class="grid grid-cols-12 gap-4">
            @foreach (rendered as block)
              <div class="col-span-12 md:col-span-{{ block.span }}">
                <div class="p-5 h-full rounded-xl border border-line bg-panel" style="min-height: {{ block.height }}px">
                  @if (block.error)
                    <p class="text-sm font-medium text-ink">{{ block.title }}</p>
                    <p class="mt-2 text-sm text-warn">{{ block.error }}</p>
                  @elseif (block.kind === 'text')
                    <TextBlock title="{{ block.title }}" body="{{ block.body }}" />
                  @elseif (block.kind === 'big_number')
                    <BigNumber :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'bar')
                    <BarChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'donut')
                    <DonutChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'table')
                    <DataTable :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'funnel')
                    <FunnelChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'heatmap')
                    <HeatmapChart :result="block.result" title="{{ block.title }}" />
                  @elseif (block.kind === 'area')
                    <LineChart :result="block.result" title="{{ block.title }}" variant="area" />
                  @else
                    <LineChart :result="block.result" title="{{ block.title }}" />
                  @endif
                </div>
              </div>
            @endforeach
          </div>
        @endif
      @endif
    </main>
  </div>
</template>
