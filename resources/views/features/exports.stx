const page = pageFor('features', 'exports')!
const canonical = 'https://reportshq.org/features/exports'

useSeoMeta({
  title: metaTitleFor(page.title),
  description: page.description,
  canonical,
  ogUrl: canonical,
  ogTitle: page.title,
  ogDescription: page.description,
  ogType: 'article',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-3xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: page.title },
]

const sections = [
  {
    "heading": "A shape a spreadsheet can use",
    "body": "Exports come out in long format: one row per series per period, rather than a grid that looks right on screen and fights every pivot table. A wide export is easier to read and harder to use, and an export exists to be used."
  },
  {
    "heading": "CSV and XLSX",
    "body": "CSV for anything that reads text, XLSX when somebody wants a workbook with the types already correct so the dates are dates. Both come from the same query the chart ran, so an exported number and a drawn number cannot disagree."
  },
  {
    "heading": "Nothing is stored to expire",
    "body": "An export is generated on the request and streamed straight out. The hosted product wrote a file, signed a URL and expired it after an hour, all because the file lived on a different machine from the reader. Here it does not: the numbers are one query away, so there is nothing on disk to clean up and no way to be handed a stale copy."
  },
  {
    "heading": "Scheduled delivery, in your timezone",
    "body": "The headline numbers by email, daily, weekly or monthly, at an hour you choose in your project’s own timezone. The hour stays the hour after the clocks change, because the schedule is evaluated in that timezone rather than by adding an offset to UTC and hoping."
  },
  {
    "heading": "Delivery runs on your own queue",
    "body": "Scheduled mail goes out through the mailer and queue the application already has, so it obeys whatever sending rules you already enforce. Note that the recipient list is a plain field and is not validated against anything — a reporting tool that emails on a timer deserves the same review you would give any other outbound mail."
  }
]
</script>

