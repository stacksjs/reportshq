const sections = [
  {
    heading: 'A grid that settles',
    body: 'Blocks live on twelve columns. Drag one and the others move out of the way while you hold it; drop it and the server settles the layout before saving, so two blocks can never end up sharing a cell. That last part is done on the server on purpose: a layout agreed by the browser alone is a layout that disagrees with itself the moment two people edit the same report.',
  },
  {
    heading: 'Keyboard, not just pointer',
    body: 'Every move and resize has a keyboard path, and focus stays on the block you were holding. A builder that can only be driven by dragging excludes people who do not drag, and the work to avoid that is a few key handlers.',
  },
  {
    heading: 'Draft and published are different things',
    body: 'Edits go to a draft. The published version is what a teammate opens and what a share link serves, and it does not change until you say so. A half finished experiment is never what somebody else walks into.',
  },
  {
    heading: 'Every block says what it counts',
    body: 'Each block carries one sentence derived from the query it actually runs, not from a label somebody typed. Two charts both called Revenue can count different things, and a reader deserves to know which one is in front of them before they quote a number in a meeting.',
  },
  {
    heading: 'Duplicating and archiving',
    body: 'Duplicate a report to try a different cut without risking the one people rely on. Archive the ones you have finished with rather than deleting them, and restore later if it turns out you had not.',
  },
]
