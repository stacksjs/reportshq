<script server>
import { useSeoMeta } from 'stx'
import { metaTitleFor, pageFor } from '../../../app/Marketing/pages'

const page = pageFor('features', 'builder')!
const canonical = 'https://reportshq.org/features/builder'

useSeoMeta({
  title: metaTitleFor(page.title),
  description: page.description,
  canonical,
  ogUrl: canonical,
  ogTitle: page.title,
  ogDescription: page.description,
  ogType: 'article',
  ogSiteName: 'ReportsHQ',
  twitterCard: 'summary_large_image',
})

const breadcrumbWidth = 'max-w-3xl'
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Features', href: '/features' },
  { label: page.title },
]

const sections = [
  {
    "heading": "Blocks on a twelve column grid",
    "body": "Drag to move, drag a corner to resize, arrow keys to nudge. Everything below what you moved gets out of the way by the full height of what displaced it, so a grid never ends up with a block sitting inside another one."
  },
  {
    "heading": "The server decides what a drag meant",
    "body": "The browser packs the grid so the drag feels immediate, and the server packs it again for the record. The response carries the canonical positions back. That way what is stored and what you saw cannot drift apart, which is the failure that makes a builder feel haunted."
  },
  {
    "heading": "Each block is a question",
    "body": "Pick a measure, a dimension and a time grain. The choices come from the models you described, so the panel cannot offer a field the query would then refuse."
  },
  {
    "heading": "A refusal beats a wrong number",
    "body": "Ask something the data cannot answer honestly and the block says so on its face. A revenue-per-product chart that would count an order once per line item is refused rather than drawn, because a plausible wrong number is worse than an empty tile."
  },
  {
    "heading": "Publish when it is right",
    "body": "A draft is yours until you publish it. Nobody opens a half arranged grid, and a share link never serves one."
  }
]
const shot = '/img/feature-builder.png'
const shotAlt = 'The report builder: a palette of block kinds above a twelve column grid holding a revenue total, an order count, a donut, a table and a line chart, each with a resize corner'
const shotCaption = 'The builder, with a block palette and resize corners on every tile. Sample numbers; the grid, the packing and the drag behaviour are the real thing.'
</script>

