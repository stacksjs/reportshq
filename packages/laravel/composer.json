{
  "name": "reportshq/laravel",
  "description": "Send a Laravel application's own events to ReportsHQ, as the standard taxonomy.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://reportshq.org",
  "keywords": ["reportshq", "analytics", "laravel", "events"],
  "authors": [
    { "name": "Chris Breuer" }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "illuminate/support": "^11.0 || ^12.0",
    "illuminate/events": "^11.0 || ^12.0",
    "phpunit/phpunit": "^11.0"
  },
  "suggest": {
    "illuminate/support": "Required to use the service provider and the shipped listeners."
  },
  "autoload": {
    "psr-4": {
      "ReportsHQ\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ReportsHQ\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": ["ReportsHQ\\Laravel\\ReportsHQServiceProvider"]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
