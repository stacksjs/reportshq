{
  // The package carries its own config rather than joining the app's.
  //
  // The app's include list is owned by the framework
  // (storage/framework/tsconfig.app.json) and does not reach into packages/.
  // Extending it here and adding a path would mean copying that list into the
  // app and watching it drift the next time the framework changes it. A
  // publishable package should typecheck on its own terms anyway: it has no
  // access to the app's globals and must not accidentally depend on them.
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "types": ["bun"],
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
